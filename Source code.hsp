#packopt name "qwerty3x"
#packopt hide 1
#packopt icon "appicon.ico"
#packopt version "infomationversion.txt"
#packopt manifest "DPI.manifest"

#include "user32.as"
#uselib "user32.dll"
#func SetProcessDPIAware "SetProcessDPIAware"
#func global SetProcessDpiAwarenessContext "SetProcessDpiAwarenessContext" int
#func  global SetLong "SetWindowLongA" int, int, int
#cfunc global GetLong "GetWindowLongA" int, int
#define global StyleAdd(%1, %2=0, %3=0)ujw=((%3)&2)*-2-16 :\
        SetLong %1, ujw, GetLong(%1, ujw)|(%2)^((%3)&1)*(%2)
#include "kernel32.as"
#func global GetNativeSystemInfo "GetNativeSystemInfo" sptr
#include "shell32.as"
#include "gdi32.as"
#include "winmm.as"
#include "hspext.as"
#include "hspinet.as"
;#include "obj.as"
#include "hspmath.as"
#define CLSID_ActiveDesktop "{75048700-EF1F-11D0-9888-006097DEACF9}"
#define IID_IActiveDesktop "{F490EB00-1240-11D1-9888-006097DEACF9}"
#include "advapi32.as"
#include "mod_fontdlg.as"

*systemstartup;qwerty3xを起動する

	cmdlinebuf=dir_cmdline

	title "Starting... | qwerty3x"

#ifdef _debug
	hspdebugmode=1
#else
	hspdebugmode=0
#endif

if qwertydebug=0:{
	onerror *systemerrordialog
}

#include "module/include code_1_module.hsp";832
;#include "module/include code_2_default.hsp";144
;#include "module/include code_3_buffer.hsp";323
;#include "module/include code_4_controlmakescreen.hsp";3504
;#include "module/include code_5_appendmenu.hsp";119
;#include "module/include code_6_password.hsp";379
;832+144+323+3504+119+379=5301 5301+3179=8480

	qwertyver="1.00_beta2"
	qwertybuild="8480"
	qwertydate="2026/01/29"
	qwertycur=dir_cur
	qwertypath=""+dir_cur+"\\qwerty3x.exe"
	passwordkey=6+rnd(15)+rnd(15)+rnd(15)+rnd(15)+rnd(15)+rnd(15)
	randomize

	if instr(cmdlinebuf,0,"autoupdate")!-1:{
		chdir qwertycur
		exist "qwerty3x installer ver."+qwertyver+".exe"
		if strsize!-1:{
			delete "qwerty3x installer ver."+qwertyver+".exe"
		}
	}

#include "module/include code_2_default.hsp"

	if strf("%4x",__hspver__)="3507":{
		qwertyver+=" for legacy"
		legacy3xmode=1
	}else{
		legacy3xmode=0
	}

	gosub *loadingsettingfile

	screen 0000,(ginfo(20)*5),(ginfo(21)*5),0,0,0,640,450
	hclient=hwnd
	getwindowlong hwnd,-16
	setwindowlong hwnd,-16,stat|$10000|$40000
	getwindowlong hwnd,-16
	setwindowlong hwnd,-16,stat-$80000
	boxfofmes int(loadset("DISPCOLORMODE",settingdata)),xsiz(0),ysiz(0),ginfo(12),ginfo(13)
	gsel 0000,int(loadset("ALWAYSFRONT",settingdata))+1
	title "Starting... | qwerty3x ver."+qwertyver

	color 0,0,0
	boxf 
	color 255,255,255
	pos 0,0
	chdir qwertycur
	picload "appicon.png",1
	pos 0,260
	font "Terminal",85,0
	mes "qwerty3x "
	font "Terminal",25,0
	mes "ver."+qwertyver+"\nis starting..."
	font msgothic,20,2+16
	startwaittime=5

	langstrrepstartupbuf=1
	gosub *langstrrepupdate

	title ""+langstr(1002)+" | qwerty3x ver."+qwertyver;1002=起動中

	pos 5,420
	color 0,0,0
	boxf 0,420,640,450
	color 255,255,255
	mes ""+langstr(1006)+""
	wait startwaittime
	windowsname=""
	if sysinfo(0)="WindowsNT ver6.3"{okfullmode=1:windowsver="NT6.3":windowsname="Windows 8.1 / Server2012 R2"}
	if sysinfo(0)="WindowsNT ver6.2"{okfullmode=1:windowsver="NT6.2":windowsname="Windows 8 / Server2012"}
	if sysinfo(0)="WindowsNT ver6.1"{okfullmode=1:windowsver="NT6.1":windowsname="Windows 7 / Server2008 R2"}
	if sysinfo(0)="WindowsNT ver6.0"{okfullmode=0:windowsver="NT6.0":windowsname="Windows Vista / Server2008"}
	if sysinfo(0)="WindowsNT ver5.2"{okfullmode=0:windowsver="NT5.2":windowsname="Windows Server2003 / XP x64Edition"}
	if sysinfo(0)="WindowsNT ver5.1"{okfullmode=0:windowsver="NT5.1":windowsname="Windows XP"}
	if sysinfo(0)="WindowsNT ver5.0"{okfullmode=-1:noneok=1:windowsver="NT5.0":windowsname="Windows 2000"}
	if sysinfo(0)="WindowsNT ver4.0"{okfullmode=-1:noneok=1:windowsver="NT4.0":windowsname="Windows NT 4.0"}
	if sysinfo(0)="WindowsNT ver3.51"{okfullmode=-1:noneok=1:windowsver="NT3.51":windowsname="Windows NT 3.51"}
	if sysinfo(0)="WindowsNT ver3.5"{okfullmode=-1:noneok=1:windowsver="NT3.5":windowsname="Windows NT 3.5"}
	if sysinfo(0)="WindowsNT ver3.1"{okfullmode=-1:noneok=1:windowsver="NT3.1":windowsname="Windows NT 3.1"}
	if sysinfo(0)="Windows9X ver4.90"{okfullmode=-1:noneok=1:windowsver="4.90":windowsname="Windows Me"}
	if sysinfo(0)="Windows9X ver4.10"{okfullmode=-1:noneok=1:windowsver="4.10":windowsname="Windows 98 / 98 Second Edition"}
	if sysinfo(0)="Windows9X ver4.0"{okfullmode=-1:noneok=1:windowsver="4.0":windowsname="Windows 95"}
	if windowsname="":{
		okfullmode=2
		windowsver="NT10.0"
		#uselib "ntdll.dll"
		#func RtlGetVersion "RtlGetVersion" sptr
		// バージョン取得
		dim OSVERSIONINFO, 37
		OSVERSIONINFO = varsize(OSVERSIONINFO)
		RtlGetVersion varptr(OSVERSIONINFO)
		majorVersion = OSVERSIONINFO(1)
		buildNumber = OSVERSIONINFO(3)
		// 判定
		if (majorVersion >= 10) {
			if (buildNumber >= 22000) {
				windowsname="Windows 11"
			}else{
				if buildNumber=20348:{
					windowsname="Windows Server 2022"
				}else:if buildNumber=17763:{
					windowsname="Windows Server 2019"
				}else:if buildNumber=14393:{
					windowsname="Windows Server 2016"
				}else{
					windowsname="Windows 10"
				}
			}
			;if buildNumber>=18362:{;Windows10 1903以降
			;}else{
			;}
		}
		#define WM_COMMAND $111
	}
	if windowsname="Windows 11":{
		#uselib "dwmapi.dll"
		#func global DwmSetWindowAttribute "DwmSetWindowAttribute" int, int, int, int
		#func global DwmExtendFrameIntoClientArea "DwmExtendFrameIntoClientArea" int,int
		#define DWMWA_USE_HOSTBACKDROPBRUSH 17            
		#define DWMWA_USE_IMMERSIVE_DARK_MODE 20
		#define DWMWA_SYSTEMBACKDROP_TYPE 38
		
		#enum DWMWA_BORDER_COLOR = 34
		#enum DWMWA_CAPTION_COLOR
		#enum DWMWA_TEXT_COLOR
	}

	gosub *langstrrepupdate
	if okfullmode=-1:{
		if loadset("windowsversiondialog",settingdata)="1":{
			dialog langstr(1001),0,"qwerty3x ver."+qwertyver
			;1001=サポートしていないWindowsバージョンを検出しました：windowsname
			;起動は続行できますが、想定していない動作が発生する可能性があります。
		}
	}
	if okfullmode=2:{
		fontautoname="Yu Gothic UI"
	}else:if okfullmode=1:{
		fontautoname="Meiryo UI"
	}else{
		fontautoname="MS UI Gothic"
	}
	if loadset("FONTNAME",settingdata)="AUTO":{
		fontstr=fontautoname
	}else{
		fontstr=loadset("FONTNAME",settingdata)
	}

	#define logpixelsx $00000058
	#define logpixelsy $0000005A
	#define ctype xsiz(%1) int(round(double(%1)*xdpi/96))
	#define ctype ysiz(%1) int(round(double(%1)*ydpi/96))
	#define ctype sizx(%1) int(%1*96/xdpi)
	#define ctype sizy(%1) int(%1*96/ydpi)
	if okfullmode=0|okfullmode=-1:{;Windows XP、Windows Vista
		xdpi2=96
		ydpi2=96
		screennowxsize="100%(OS側の画面拡大率設定非対応に基づく)"
		nowxsizebuf=100
		xdpi=96
		ydpi=96
	}else{
		setprocessdpiaware
		xdpi2=getdevicecaps(hdc,logpixelsx)
		ydpi2=getdevicecaps(hdc,logpixelsy)
		xdpi=xdpi2
		ydpi=ydpi2
		screennowxsize=""+xsiz(100)+"%(システム設定に基づく)"
		nowxsizebuf=xsiz(100)
	}
	dismaxx=ginfo(20)
	dismaxy=ginfo(21)

	pos 5,420
	color 0,0,0
	boxf 0,420,640,450
	color 255,255,255
	mes ""+langstr(1007)+""
	wait startwaittime
	bgscrwindowmax=3
	repeat bgscrwindowmax
		bgscr (cnt+1),ginfo(20),(ginfo(21)*3),2
		hchild.cnt=hwnd
		getwindowlong hwnd,-16
		setwindowlong hwnd,-16,stat|$CF0000
		setparent hchild.cnt,hclient
		getwindowlong hwnd,-16
		setwindowlong hwnd,-16,stat-$800000-$40000
	loop;0001 0002 0003
	buffer 1007,1,1,0
	gsel 0000,int(loadset("ALWAYSFRONT",settingdata))+1

	screenname=langstr(3001);ランチャー
	fontsize=ysiz(15)
	conpage=0
	conpage2=0
	slideshowlist=0
	updatecheckmes=""
	settingfps=24;24fps

	if loadset("startupdate",settingdata)="1"|okfullmode!-1:{
		pos 5,420
		color 0,0,0
		boxf 0,420,640,450
		color 255,255,255
		mes ""+langstr(1014)+""
		updatecheckresult=0
		repeat 1
			netinit
			if stat!0:{
				dialog langstr(0007),1,langstr(5701)
				break
			}
			neturl "https://hoyoqwerty.github.io/qwerty3xupdate/updatechecker/"
			netrequest_get "verinfo.txt"
			dim res
			loadingcnt=0
			loadingtime=0
			loadingok=0
			repeat
				title langstr(5706)+" ("+(cnt+1)+"/200)"
				netexec res
				if res!0:{
					if res=1:{
						sdim buf,netgetv_size()
						netgetv_data buf
						loadingok=1
						break
					}else:if res<0:{
						neterror errorstr
						dialog langstr(5708)+"\n\n"+errorstr+"\n\n"+langstr(5709),1,langstr(5701)
						break
					}
				}

				await 10
				if cnt=200:{
					dialog langstr(5710),1,langstr(5701)
					break
				}
			loop
			if loadingok=0:{
				break
			}
			notesel buf
			noteget verbuf,0
			noteget verbuf2,1
			noteget betaverbuf,2
			noteget betaverbuf2,3
			testbuf=int(verbuf)
			testbetabuf=int(betaverbuf)
			if testbuf=-1:{
				qwerty3xupdatemode=-1
				dialog langstr(5711),0,langstr(5701)
				break
			}

			if testbuf>qwertybuild:{
				qwerty3xupdatemode=0
				netrequest_get "newvernote.txt"
				dim res
				loadingcnt=0
				loadingtime=0
				loadingok=0
				repeat
					netexec res
					if res!0:{
						title langstr(57061)+" ("+(cnt+1)+"/200)"
						if res=1:{
							sdim buf,netgetv_size()
							netgetv_data buf
							loadingok=1
							break
						}else:if res<0:{
							neterror errorstr
							dialog langstr(5708)+"\n\n"+errorstr+"\n\n"+langstr(5709),1,langstr(5701)
							break
						}
					}

					await 10
					if cnt=200:{
						dialog langstr(5710),1,langstr(5701)
						break
					}
				loop
				if loadingok=0:{
					break
				}
				newvernote=buf
				notesel newvernote
				chdir textcodefile
				exist "ansisave.txt"
				if strsize!-1:{
					delete "ansisave.txt"
				}
				notesave "utf8load.txt"
				exec "textcodechange.exe cntcmd-1"
				repeat
					exist "ansisave.txt"
					if strsize!-1:{
						notesel newvernote
						noteload "ansisave.txt"
						if newvernote!"":{
							break
						}
					}
					await 10
				loop
				updatecheckmestimebuf=""+gettime(0)+"/"+strf("%02d",gettime(1))+"/"+strf("%02d",gettime(3))+" "+strf("%02d",gettime(4))+":"+strf("%02d",gettime(5))+":"+strf("%02d",gettime(6))
				updatecheckmes={""}+langstr(5713)+{"
				\nver."}+verbuf2+{"
				\n\n"}+langstr(5714)+{"
				\n"}+newvernote

				pos 0,400
				color 0,0,0
				boxf 0,400,640,450
				color 255,255,255
				mes langstr(1015)+"\n: "+verbuf2
				dialog langstr(1016),2,langstr(5701)
				if stat=6:{
					screenname=langstr(3005)
					saveset "controlpage",settingdata,"APPUPDATE"
				}
			}else{
				if loadset("getbetaupdate",settingdata)="1"&testbetabuf>qwertybuild:{
					qwerty3xupdatemode=1
					netrequest_get "betavernote.txt"
					dim res
					loadingcnt=0
					loadingtime=0
					loadingok=0
					repeat
						netexec res
						if res!0:{
							title langstr(57061)+" ("+(cnt+1)+"/200)"
							if res=1:{
								sdim buf,netgetv_size()
								netgetv_data buf
								loadingok=1
								break
							}else:if res<0:{
								neterror errorstr
								dialog langstr(5708)+"\n\n"+errorstr+"\n\n"+langstr(5709),1,langstr(5701)
								break
							}
						}
	
						await 10
						if cnt=200:{
							dialog langstr(5710),1,langstr(5701)
							break
						}
					loop
					if loadingok=0:{
						break
					}
					newvernote=buf
					notesel newvernote
					chdir textcodefile
					exist "ansisave.txt"
					if strsize!-1:{
						delete "ansisave.txt"
					}
					notesave "utf8load.txt"
					exec "textcodechange.exe cntcmd-1"
					repeat
						exist "ansisave.txt"
						if strsize!-1:{
							notesel newvernote
							noteload "ansisave.txt"
							if newvernote!"":{
								break
							}
						}
						await 10
					loop
					updatecheckmestimebuf=""+gettime(0)+"/"+strf("%02d",gettime(1))+"/"+strf("%02d",gettime(3))+" "+strf("%02d",gettime(4))+":"+strf("%02d",gettime(5))+":"+strf("%02d",gettime(6))
					updatecheckmes={""}+langstr(57131)+{"
					\nver."}+betaverbuf2+{"
					\n\n"}+langstr(5714)+{"
					\n"}+newvernote

					pos 0,400
					color 0,0,0
					boxf 0,400,640,450
					color 255,255,255
					mes langstr(1017)+"\n: "+verbuf2
					dialog langstr(1018),2,langstr(5701)
					if stat=6:{
						screenname=langstr(3005)
						saveset "controlpage",settingdata,"APPUPDATE"
					}
				}else{
					updatecheckmestimebuf=""+gettime(0)+"/"+strf("%02d",gettime(1))+"/"+strf("%02d",gettime(3))+" "+strf("%02d",gettime(4))+":"+strf("%02d",gettime(5))+":"+strf("%02d",gettime(6))
					updatecheckmes=langstr(5716)
				}
			}

			netterm
			break
		loop
	}

	pos 5,420
	color 0,0,0
	boxf 0,400,640,450
	color 255,255,255
	mes ""+langstr(1008)+""
	wait startwaittime
	bufferallupdatestartupbuf=1
	gosub *bufferallupdate
	bufferallupdatestartupbuf=0
	gsel 0000,0
	title ""+langstr(1002)+" | qwerty3x ver."+qwertyver

	width int(loadset("WINDOW_SIZX",settingdata)),int(loadset("WINDOW_SIZY",settingdata)),int(loadset("WINDOW_POSX",settingdata)),int(loadset("WINDOW_POSY",settingdata))
	if loadset("ISZOOMED",settingdata)="1":{
		sendmsg hwnd,$112,$F030
	}
	IsZoomed hwnd
	iszoom=stat

	color 0,0,0
	boxf 

	if ginfo(12)<=xsiz(640)|ginfo(13)<=ysiz(450):{
		width xsiz(640),ysiz(450)
	}

	if loadset("passwordstring",settingdata)!"":{;パスワード
		goto *passwordinput
	}

	gosub *makescreen

	goto *systemrepeat

*makescreen;画面新規更新
	redraw 0

	onerrortype="makescreen"

	getkey ctrl,17
	if ctrl=1:{
		if qwertydebug=0:{
			qwertydebug=1
		}else{
			qwertydebug=0
		}
	}

	title ""+langstr(1003)+" | qwerty3x ver."+qwertyver	
	titlebarstrbuf=""+langstr(1003)+" | qwerty3x ver."+qwertyver	

	if qwertydebug=1:{
		title "<デバッグ>No.1 :フォント名を指定中/Specifying font name | qwerty3x ver."+qwertyver
	}
	if loadset("FONTNAME",settingdata)="AUTO":{
		fontstr=fontautoname
	}else{
		fontstr=loadset("FONTNAME",settingdata)
	}

	if qwertydebug=1:{
		title "<デバッグ>No.2 :スクリーンバッファを作成中/Creating screen buffer | qwerty3x ver."+qwertyver
	}
	gosub *bufferallupdate
	gosub *appendmenuupdate

	if qwertydebug=1:{
		title "<デバッグ>No.3 :画面クリア中/Clearing screen | qwerty3x ver."+qwertyver
	}	
	repeat bgscrwindowmax
		gsel (cnt+1),-1
	loop
	gsel 0000,int(loadset("ALWAYSFRONT",settingdata))+1
	enablewindow hclient,0
	clrobj
	color 0,0,0
	boxf
	if loadset("backgroundmode",settingdata)="COLOR":{
		backgroundcolorrgbdata=loadset("backgroundcolor",settingdata)
		split backgroundcolorrgbdata,",",backgroundcolorrdata,backgroundcolorgdata,backgroundcolorbdata
		color int(backgroundcolorrdata),int(backgroundcolorgdata),int(backgroundcolorbdata)
		boxf xsiz(0),ysiz(31),ginfo(12),ginfo(13)
	}else:if loadset("backgroundmode",settingdata)="IMAGE":{
		gsel 1007,0
		controlbackgroundfile=loadset("backgroundfile",settingdata)
		exist controlbackgroundfile
		if strsize!-1:{
			picload controlbackgroundfile,0
			backpicx=ginfo(12)
			backpicy=ginfo(13)
		}else{
			color 0,0,0
			boxf
		}
		gsel 0000,0
	}else:if loadset("backgroundmode",settingdata)="SLIDESHOW":{
		gsel 1007,0
		sdim bmplist,1024
		sdim jpglist,1024
		sdim jpeglist,1024
		sdim pnglist,1024
		controlbackgroundfolder=loadset("backgroundfolder",settingdata)
		dirlist dummy,controlbackgroundfolder,5
		if stat!0:{
			dirlist bmplist,""+controlbackgroundfolder+"\\*.bmp",1
			dirlist jpglist,""+controlbackgroundfolder+"\\*.jpg",1
			dirlist jpeglist,""+controlbackgroundfolder+"\\*.jpeg",1
			dirlist pnglist,""+controlbackgroundfolder+"\\*.png",1
			slideshowlist=bmplist+jpglist+jpeglist+pnglist
			notesel slideshowlist
			if notemax=0:{
				color 0,0,0
				boxf
			}else{
				if loadset("backgroundrandom",settingdata)="1":{
					slideshowlistcnt=rnd(notemax)
				}else{
					if slideshowlistcnt=(notemax-1):{
						slideshowlistcnt=0
					}else{
						slideshowlistcnt+=1
					}
				}
				noteget slideshowpath,slideshowlistcnt
				picload ""+controlbackgroundfolder+"\\"+slideshowpath,0
				backpicx=ginfo(12)
				backpicy=ginfo(13)
			}
		}else{
			color 0,0,0
			boxf
		}
		gsel 0000,0
	}
	redraw 1

	if qwertydebug=1:{
		title "<デバッグ>No.4 :フォントを設定中/Setting font | qwerty3x ver."+qwertyver
	}
	font fontstr,fontsize,0
	objmode 2,1

	if qwertydebug=1:{
		title "<デバッグ>No.5 :タイトルバーを描画中/Drawing titlebar | qwerty3x ver."+qwertyver
	}
	pos xsiz(0),ysiz(0)
	boxfofmes int(loadset("DISPCOLORMODE",settingdata)),xsiz(0),ysiz(0),ginfo(12),ysiz(30)
	line ginfo(12),ysiz(30),xsiz(0),ysiz(30)
	if windowsname="Windows 11":{
		if loadset("DISPCOLORMODE",settingdata)=0:{;ダークモード
			opt=rgb(32,32,32)
			dwmsetwindowattribute hwnd,DWMWA_CAPTION_COLOR,varptr(opt),4
			dwmsetwindowattribute hwnd,DWMWA_BORDER_COLOR,varptr(opt),4
			opt=rgb(255,255,255)
			dwmsetwindowattribute hwnd,DWMWA_TEXT_COLOR,varptr(opt),4
		}else:if loadset("DISPCOLORMODE",settingdata)=1:{;ライトモード
			opt=rgb(255,255,255)
			dwmsetwindowattribute hwnd,DWMWA_CAPTION_COLOR,varptr(opt),4
			dwmsetwindowattribute hwnd,DWMWA_BORDER_COLOR,varptr(opt),4
			opt=rgb(0,0,0)
			dwmsetwindowattribute hwnd,DWMWA_TEXT_COLOR,varptr(opt),4
		}
	}

	pos ginfo(12)-xsiz(30),ysiz(0)
	objsize xsiz(30),ysiz(30)
	objimage 1008,xsiz(90),ysiz(59),xsiz(90),ysiz(59),xsiz(90),ysiz(60)
	button "",*systemshutdown
	endadr=stat
	pos ginfo(12)-xsiz(60),ysiz(0)
	if iszoom=0:{
		objimage 1008,xsiz(30),ysiz(59),xsiz(30),ysiz(59),xsiz(30),ysiz(60)
	}else{
		objimage 1008,xsiz(60),ysiz(59),xsiz(60),ysiz(59),xsiz(60),ysiz(60)
	}
	button gosub "",*windowmenualsizechange
	maxadr=stat
	pos ginfo(12)-xsiz(90),ysiz(0)
	objimage 1008,xsiz(0),ysiz(59),xsiz(0),ysiz(59),xsiz(0),ysiz(60)
	button gosub "",*windowmenualsizechange
	minadr=stat
	objimage -1

	pos xsiz(0),ysiz(0)
	objsize xsiz(150),ysiz(30)
	if startmainmenubuf=1:{
		objimage 1004,xsiz(1),ysiz(1),xsiz(1),ysiz(1),xsiz(1),ysiz(2)
	}else{
		objimage 1003,xsiz(1),ysiz(1),xsiz(1),ysiz(1),xsiz(1),ysiz(2)
	}
	button gosub "",*startmainmenuchange
	startmainmenuadr=stat

	if qwertydebug=1:{
		title "<デバッグ>No.6 :qwerty3xアプリケーションの描画中/Drawing qwerty3x application | qwerty3x ver."+qwertyver
	}
	//初期pos xsiz(0),ysiz(30)
	if screenname=langstr(3001):{;ランチャー
		redraw 0
		launcherwindowpos=xsiz(0)
		gosub *launcherbuffersetup
		gosub *makelauncherbuffer

		gsel 0,0
		sizebufx=ginfo(12)
		sizebufy=ginfo(13)-ysiz(52)
		if loadset("backgroundmode",settingdata)="COLOR":{
			backgroundcolorrgbdata=loadset("backgroundcolor",settingdata)
			split backgroundcolorrgbdata,",",backgroundcolorrdata,backgroundcolorgdata,backgroundcolorbdata
			color int(backgroundcolorrdata),int(backgroundcolorgdata),int(backgroundcolorbdata)
			boxf xsiz(0),ysiz(32),ginfo(12),ginfo(13)
		}else:if loadset("backgroundmode",settingdata)="IMAGE":{
			gsel 1007,0
			backpicx=ginfo(12)
			backpicy=ginfo(13)
			gsel 0000,0
			if ((backpicy*sizebufx)/backpicx)<=(sizebufy):{
				posbuf3=(backpicy*sizebufx)/backpicx
				posbuf4=(sizebufy-posbuf3)/2
				pos xsiz(0),ysiz(32)+posbuf4
				gzoom sizebufx,posbuf3,1007,0,0,backpicx,backpicy,1
			}else{
				posbuf3=(backpicx*sizebufy)/backpicy
				posbuf4=(sizebufx-posbuf3)/2
				pos xsiz(0)+posbuf4,ysiz(32)
				gzoom posbuf3,sizebufy,1007,0,0,backpicx,backpicy,1
			}
		}else:if loadset("backgroundmode",settingdata)="SLIDESHOW":{
			gsel 1007,0
			backpicx=ginfo(12)
			backpicy=ginfo(13)
			gsel 0000,0
			if ((backpicy*sizebufx)/backpicx)<=sizebufy:{
				posbuf3=(backpicy*sizebufx)/backpicx
				posbuf4=(sizebufy-posbuf3)/2
				pos xsiz(0),ysiz(32)+posbuf4
				gzoom sizebufx,posbuf3,1007,0,0,backpicx,backpicy,1
			}else{
				posbuf3=(backpicx*sizebufy)/backpicy
				posbuf4=(sizebufx-posbuf3)/2
				pos xsiz(0)+posbuf4,ysiz(32)
				gzoom posbuf3,sizebufy,1007,0,0,backpicx,backpicy,1
			}
		}

		gosub *makelauncherbutton

		pos xsiz(0),ginfo(13)-ysiz(20)
		ScrollBar_Create ginfo(12),ysiz(20),0,0,launcherposbufxbuffer,(launcherposbufxbuffer/10),0,(launcherposbufxbuffer/10),(launcherposbufxbuffer/10)
		launcherscrollbaradr=stat
		hlauncherscrollbar=objinfo(launcherscrollbaradr,2)

		bufferbuttonY=ysiz(0)
		bufferbuttonX=xsiz(160)
		pos bufferbuttonX,ysiz(1)
		objsize appbarxsiz.0+xsiz(10),ysiz(29)
		objimage 2002,xsiz(0),bufferbuttonY,xsiz(0),bufferbuttonY,xsiz(300),bufferbuttonY
		button gosub "",*launcheradd
		launcheraddadr=stat

		redraw 1
	}else:if screenname=langstr(3006):{;ランチャーの編集
	}else:if screenname=langstr(3005):{;qwerty3xの設定
		clientwindowx=ginfo(12)
		clientwindowy=ginfo(13)
		bgscr 0003,ginfo(20),(ginfo(21)*3),2
		hchild.2=hwnd
		getwindowlong hwnd,-16
		setwindowlong hwnd,-16,stat|$CF0000
		setparent hchild.2,hclient
		getwindowlong hwnd,-16
		setwindowlong hwnd,-16,stat-$800000-$40000
		width xsiz(180),clientwindowy-ysiz(30),xsiz(0),ysiz(30)
		color 0,0,0
		boxf 
		font fontstr,fontsize-2,0
		objmode 2,1

		gosub *controlmakelist

		gsel 0003,2
		bgscr 0002,ginfo(20),(ginfo(21)*3),2
		hchild.1=hwnd
		getwindowlong hwnd,-16
		setwindowlong hwnd,-16,stat|$CF0000
		setparent hchild.1,hclient
		getwindowlong hwnd,-16
		setwindowlong hwnd,-16,stat-$800000-$40000

		gosub *controlmakescreen

		pos ginfo(12)-xsiz(20),ysiz(0)
		ScrollBar_Create xsiz(20),ginfo(13),1,0,(nowcontrolscreenposY+ysiz(30)),ysiz(30),0,ysiz(30),ysiz(30)
		scrollbar2adr=stat
		hscrollbar2=objinfo(scrollbar2adr,2)

		gsel 0002,2 
		gsel 0000,int(loadset("DISPCOLORMODE",settingdata))+1
	}else:if screenname=langstr(3002):{;スタートメインメニュー
		if loadset("useanimation",settingdata)=1:{
			nowysize=ysiz(0)
			nowxsize=xsiz(0)
			timeGetTime
			timebuf=(stat/100)
			animationspeed=20
			repeat animationspeed
				redraw 0
				setease ysiz(0),ginfo(13),ease_quartic_out
				nowysize=getease(cnt,animationspeed)
				boxfofmes int(loadset("DISPCOLORMODE",settingdata)),xsiz(0),ysiz(0),xsiz(150),nowysize
				line xsiz(150),nowysize,xsiz(150),ysiz(31)
	
				setease xsiz(0),ginfo(12),ease_quartic_out
				nowxsize=getease(cnt,animationspeed)
				boxfofmes int(loadset("DISPCOLORMODE",settingdata)),xsiz(0),ginfo(13)-ysiz(40),nowxsize,ginfo(13)
				line nowxsize,ginfo(13)-ysiz(40),xsiz(0),ginfo(13)-ysiz(40)
	
				redraw 1
				await 18
			loop

			timeGetTime
			nowtimebuf=(stat/100)
			if (nowtimebuf-timebuf)>=15:{
				dialog ""+langstr(1013),3,"qwerty3x ver."+qwertyver
				if stat!6:{
					saveset "useanimation",settingdata,"0"
				}
			}
		}
		redraw 0

		line xsiz(150),ginfo(13),xsiz(150),ginfo(13)-ysiz(40)
		line xsiz(150),ginfo(13)-ysiz(40),xsiz(0),ginfo(13)-ysiz(40)

		clientwindowx=ginfo(12)
		clientwindowy=ginfo(13)

		bgscr 0001,ginfo(20),(ginfo(21)*3),2
		hchild.0=hwnd
		getwindowlong hwnd,-16
		setwindowlong hwnd,-16,stat|$CF0000
		setparent hchild.0,hclient
		getwindowlong hwnd,-16
		setwindowlong hwnd,-16,stat-$800000-$40000
		color 0,0,0
		boxf 
		font fontstr,fontsize,0
		objmode 2,1
		gsel 0001,0
		width (clientwindowx-xsiz(150)),(clientwindowy-ysiz(70)),xsiz(150),ysiz(30)

		if loadset("backgroundmode",settingdata)="COLOR":{
			backgroundcolorrgbdata=loadset("backgroundcolor",settingdata)
			split backgroundcolorrgbdata,",",backgroundcolorrdata,backgroundcolorgdata,backgroundcolorbdata
			color int(backgroundcolorrdata),int(backgroundcolorgdata),int(backgroundcolorbdata)
			boxf xsiz(0),ysiz(0),ginfo(12),ginfo(13)
		}else:if loadset("backgroundmode",settingdata)="IMAGE":{
			gsel 1007,0
			backpicx=ginfo(12)
			backpicy=ginfo(13)
			gsel 0001,0
			if ((backpicy*ginfo(12))/backpicx)<=ginfo(13):{
				posbuf3=(backpicy*ginfo(12))/backpicx
				posbuf4=(ginfo(13)-posbuf3)/2
				pos xsiz(0),ysiz(0)+posbuf4
				gzoom ginfo(12),posbuf3,1007,0,0,backpicx,backpicy,1
			}else{
				posbuf3=(backpicx*ginfo(13))/backpicy
				posbuf4=(ginfo(12)-posbuf3)/2
				pos xsiz(0)+posbuf4,ysiz(0)
				gzoom posbuf3,ginfo(13),1007,0,0,backpicx,backpicy,1
			}
		}else:if loadset("backgroundmode",settingdata)="SLIDESHOW":{
			gsel 1007,0
			backpicx=ginfo(12)
			backpicy=ginfo(13)
			gsel 0001,0
			if ((backpicy*ginfo(12))/backpicx)<=ginfo(13):{
				posbuf3=(backpicy*ginfo(12))/backpicx
				posbuf4=(ginfo(13)-posbuf3)/2
				pos xsiz(0),ysiz(0)+posbuf4
				gzoom ginfo(12),posbuf3,1007,0,0,backpicx,backpicy,1
			}else{
				posbuf3=(backpicx*ginfo(13))/backpicy
				posbuf4=(ginfo(12)-posbuf3)/2
				pos xsiz(0)+posbuf4,ysiz(0)
				gzoom posbuf3,ginfo(13),1007,0,0,backpicx,backpicy,1
			}
		}
	
		startmainmenuposx=(ginfo(12)-(xsiz(320)*(ginfo(12)/xsiz(320))))/2

		nowstartmainposY=ysiz(10)
		pos startmainmenuposx,nowstartmainposY
		boxfofmes onezero(loadset("DISPCOLORMODE",settingdata)),startmainmenuposx,nowstartmainposY,startmainmenuposx+fontxsizedata.2+xsiz(10),nowstartmainposY+fontysizedata.2
		pos startmainmenuposx+xsiz(3),nowstartmainposY
		mes langstr(3003);・qwerty3x アプリケーション

		objsize xsiz(300),ysiz(30)
		nowstartmainpos=startmainmenuposx
		nowstartmainposY+=ysiz(40)	
		bufferbuttonY=ysiz(1)
		pos nowstartmainpos,nowstartmainposY
		objimage 1005,xsiz(0),bufferbuttonY,xsiz(0),bufferbuttonY,xsiz(301),bufferbuttonY
		button gosub "",*startqwertyapp
		qweapp.0=stat;ランチャー

		if nowstartmainpos+(xsiz(300)*2)>=ginfo(12):{
			nowstartmainpos=startmainmenuposx
			nowstartmainposY+=ysiz(30)
		}else{
			nowstartmainpos+=xsiz(300)
			;nowstartmainposYは変わらない
		}
		bufferbuttonY+=ysiz(30)
		pos nowstartmainpos,nowstartmainposY
		objimage 1005,xsiz(0),bufferbuttonY,xsiz(0),bufferbuttonY,xsiz(301),bufferbuttonY
		button gosub "",*startqwertyapp
		qweapp.1=stat;Windowsの設定

		nowstartmainposY+=ysiz(40)
		pos startmainmenuposx,nowstartmainposY
		boxfofmes onezero(loadset("DISPCOLORMODE",settingdata)),startmainmenuposx,nowstartmainposY,startmainmenuposx+fontxsizedata.2+xsiz(10),nowstartmainposY+fontysizedata.2
		pos startmainmenuposx+xsiz(3),nowstartmainposY
		mes langstr(3004);・Windows アプリケーション

		objsize xsiz(300),ysiz(30)
		nowstartmainpos=startmainmenuposx
		nowstartmainposY+=ysiz(40)
		bufferbuttonY+=ysiz(30)
		pos nowstartmainpos,nowstartmainposY
		objimage 1005,xsiz(0),bufferbuttonY,xsiz(0),bufferbuttonY,xsiz(301),bufferbuttonY
		button gosub "",*startwindowsapp
		winapp.0=stat;タスクマネージャー

		winapp1cant=0
		if okfullmode=0|okfullmode=-1{winapp1cant=1}
		if okfullmode=1&windowsver="NT6.1"{winapp1cant=1}
		if winapp1cant!1:{
			if nowstartmainpos+(xsiz(300)*2)>=ginfo(12):{
				nowstartmainpos=startmainmenuposx
				nowstartmainposY+=ysiz(30)
			}else{
				nowstartmainpos+=xsiz(300)
				;nowstartmainposYは変わらない
			}
			bufferbuttonY+=ysiz(30)
			pos nowstartmainpos,nowstartmainposY
			objimage 1005,xsiz(0),bufferbuttonY,xsiz(0),bufferbuttonY,xsiz(301),bufferbuttonY
			button gosub "",*startwindowsapp
			winapp.1=stat;Windowsの設定
		}

		if nowstartmainpos+(xsiz(300)*2)>=ginfo(12):{
			nowstartmainpos=startmainmenuposx
			nowstartmainposY+=ysiz(30)
		}else{
			nowstartmainpos+=xsiz(300)
			;nowstartmainposYは変わらない
		}
		bufferbuttonY+=ysiz(30)
		pos nowstartmainpos,nowstartmainposY
		objimage 1005,xsiz(0),bufferbuttonY,xsiz(0),bufferbuttonY,xsiz(301),bufferbuttonY
		button gosub "",*startwindowsapp
		winapp.2=stat;ファイル名を指定して実行

		if nowstartmainpos+(xsiz(300)*2)>=ginfo(12):{
			nowstartmainpos=startmainmenuposx
			nowstartmainposY+=ysiz(30)
		}else{
			nowstartmainpos+=xsiz(300)
			;nowstartmainposYは変わらない
		}
		bufferbuttonY+=ysiz(30)
		pos nowstartmainpos,nowstartmainposY
		objimage 1005,xsiz(0),bufferbuttonY,xsiz(0),bufferbuttonY,xsiz(301),bufferbuttonY
		button gosub "",*startwindowsapp
		winapp.3=stat;コントロールパネル

		pos ginfo(12)-xsiz(20),ysiz(0)
		ScrollBar_Create xsiz(20),ginfo(13),1,0,(nowstartmainposY+ysiz(30)),ysiz(30),0,ysiz(30),ysiz(30)
		scrollbaradr=stat
		hscrollbar=objinfo(scrollbaradr,2)

		gsel 0001,2
		objimage -1
		gsel 0000,int(loadset("DISPCOLORMODE",settingdata))+1

		bufferbuttonY=ysiz(0)
		bufferbuttonX=xsiz(160)
		pos bufferbuttonX,ysiz(1)
		objsize appbarxsiz.0+xsiz(10),ysiz(29)
		objimage 2002,xsiz(0),bufferbuttonY,xsiz(0),bufferbuttonY,xsiz(300),bufferbuttonY
		button gosub "",*windowspowerdialog
		windowspowerdialogadr=stat

		bufferbuttonY+=ysiz(30)
		bufferbuttonX+=appbarxsiz.0+xsiz(10)
		pos bufferbuttonX,ysiz(1)
		objsize appbarxsiz.1+xsiz(10),ysiz(29)
		objimage 2002,xsiz(0),bufferbuttonY,xsiz(0),bufferbuttonY,xsiz(300),bufferbuttonY
		button goto "",*qwertypowerdialog
		qwertypowerdialogadr=stat
	}
	enablewindow hclient,1

	gsel 0000,int(loadset("ALWAYSFRONT",settingdata))+1

	onerrortype=""

	return

#include "module/include code_3_buffer.hsp"
#include "module/include code_4_controlmakescreen.hsp"
#include "module/include code_5_appendmenu.hsp"
#include "module/include code_6_password.hsp"

*startmainmenuchange;スタートメインメニューとの切り替え
	if startmainmenubuf=0:{
		bufscreenname=screenname
		screenname=langstr(3002);スタートメインメニュー
		startmainmenubuf=1
	}else{
		screenname=bufscreenname
		startmainmenubuf=0
	}

	gosub *makescreen
	return

*windowmenualsizechange;手動での最大化、最小化の適用
	if maxadr=stat:{
		IsZoomed hwnd
		iszoom=stat
		if iszoom=1:{
			sendmsg hwnd,$112,$F120;SC_RESTORE
		}else{
			sendmsg hwnd,$112,$F030;SC_MAXIMIZE
		}
	}else:if minadr=stat:{
		sendmsg hwnd,$112,$F020;SC_MINIMIZE
	}
	
	return

*startqwertyapp
	if qweapp.0=stat:{;ランチャー
		screenname=langstr(3001)
	}else:if qweapp.1=stat:{;qwerty3xの設定
		screenname=langstr(3005)
	}
	startmainmenubuf=0

	gosub *makescreen

	goto *systemrepeat

//////////////////////////////////////////////////
//ランチャー
//////////////////////////////////////////////////

*launcherbuffersetup
	backwindowid=ginfo(3)
	launcherbufferstr=""
	buffer 500,(xsiz(32)*int(loadset("launcherdatamax",launcherdata))),ysiz(32),0
	buffer 502,xsiz(260),ysiz(50),0
	font fontstr,ysiz(11),0
	repeat int(loadset("launcherdatamax",launcherdata)),1;cntは1から始まる
		gsel backwindowid,0
		title ""+langstr(6001)+" "+cnt+"/"+loadset("launcherdatamax",launcherdata)+" | qwerty3x ver."+qwertyver
		gsel 500,0
		redraw 0
		nowlauncherdata=loadset(""+cnt+"_data",launcherdata)
		nowlaunchername=loadset(""+cnt+"_name",launcherdata)
		nowlauncherrunas=loadset(""+cnt+"_runas",launcherdata)
		nowlaunchericon=loadset(""+cnt+"_icon",launcherdata)
		nowlauncheropt=loadset(""+cnt+"_opt",launcherdata)

		if nowlaunchericon="":{
			exist nowlauncherdata
			if strsize!-1:{
				nowlauncherloadmode="file"
			}else{
				dirlist dummy,nowlauncherdata,5
				if stat!0:{
					nowlauncherloadmode="folder"
				}else{
					sdim dl,2
					getlogicaldrives
					okdrive=stat
					canusedrive=""
					cantuse=0
					repeat 26
						dl=strf("%c",'a'+cnt)
						flag=1<<cnt
						if okdrive&flag:{
							notesel canusedrive
							noteadd ""+dl+":\\",-1,0
						}
					loop
					notesel canusedrive
					repeat notemax
						noteget buf,cnt
						if instr(buf,0,getpath(nowlauncherdata,16))!-1:{
							cantuse=0
							break
						}else{
							cantuse=1
						}
					loop
					if cantuse!1:{
						nowlauncherloadmode="folder"
					}else{
						nowlauncherloadmode="other"
					}
				}
			}
		}else{
			nowlauncherloadmode="custom"
		}

		pos xsiz(32)*(cnt-1),ysiz(0)
		if loadset("dispcolormode",settingdata)="0":{
			drawiconexp9=2
		}else{
			drawiconexp9=3
		}
		if nowlauncherloadmode="file"|nowlauncherloadmode="folder":{
			dim shfileinfo,88
			shgetfileinfo nowlauncherdata,0,varptr(shfileinfo),$160,$100
			drawiconex hdc,xsiz(32)*(cnt-1),ysiz(0),shfileinfo.0,xsiz(32),ysiz(32),0,0,drawiconexp9
		}else:if nowlauncherloadmode="other":{
			hIcon = ExtractIcon( hInstance, "shell32.dll", 54)
			drawiconex hdc,xsiz(32)*(cnt-1),ysiz(0),hIcon,xsiz(32),ysiz(32),0,0,drawiconexp9
		}else:if nowlauncherloadmode="custom":{
			exist nowlaunchericon
			if strsize=-1:{
				hIcon = ExtractIcon( hInstance, "shell32.dll", 54)
				drawiconex hdc,xsiz(32)*(cnt-1),ysiz(0),hIcon,xsiz(32),ysiz(32),0,0,drawiconexp9
			}else{
				buffer 501,xsiz(1),ysiz(1),0
				picload nowlaunchericon,0
				backpicx=ginfo(12)
				backpicy=ginfo(13)
				gsel 500,0
				pos xsiz(32)*(cnt-1),ysiz(0)
				gzoom xsiz(32),ysiz(32),501,xsiz(0),ysiz(0),backpicx,backpicy,1
			}
		}
		redraw 1

		gsel 502,0
		redraw 0
		buf=nowlaunchername
		secondbuf=""
		maxxsize=xsiz(230)
		repeat
			mes buf
			if ginfo(14)>=maxxsize:{
				buf2=strmid(buf,strlen(buf)-2,strlen(buf)-1)
				if IsByte(peek(buf2,0))=1:{
					secondbuf=strmid(buf,strlen(buf)-2,strlen(buf))+""+secondbuf
					buf=strmid(buf,0,strlen(buf)-2)
				}else{
					secondbuf=strmid(buf,strlen(buf)-1,strlen(buf))+""+secondbuf
					buf=strmid(buf,0,strlen(buf)-1)
				}
			}else{
				mes secondbuf
				if ginfo(14)>=maxxsize:{
					secondbuf2=strmid(secondbuf,strlen(secondbuf)-2,strlen(secondbuf)-1)
					if IsByte(peek(secondbuf2,0))=1:{
						secondbuf=strmid(secondbuf,0,strlen(secondbuf)-2)
					}else{
						secondbuf=strmid(secondbuf,0,strlen(secondbuf)-1)
					}
				}else{
					break
				}
			}
		loop
		if secondbuf="":{
			launcherbufferstr.(cnt-1)=""+buf+""
		}else{
			launcherbufferstr.(cnt-1)=""+buf+"\n"+secondbuf
		}
		redraw 1

		await 1
	loop

	gsel backwindowid,0
	return

*makelauncherbuffer
	buffer 503,xsiz(530),(ysiz(80)*int(loadset("launcherdatamax",launcherdata)))+ysiz(10),0
	redraw 0
	font fontstr,ysiz(11),0
	posbufx=xsiz(10)
	posbufy=ysiz(10)
	repeat int(loadset("launcherdatamax",launcherdata))
		boxfofmes int(loadset("dispcolormode",settingdata)),posbufx,posbufy,posbufx+xsiz(250),posbufy+ysiz(70)
		boxfofmes int(loadset("dispcolormode",settingdata)),posbufx+xsiz(260),posbufy,posbufx+xsiz(510),posbufy+ysiz(70)
		pos posbufx+xsiz(12),posbufy+ysiz(12)
		gzoom xsiz(28),ysiz(28),500,xsiz(32)*cnt,ysiz(0),xsiz(32),ysiz(32),1
		pos posbufx+xsiz(272),posbufy+ysiz(12);260+12=272
		gzoom xsiz(28),ysiz(28),500,xsiz(32)*cnt,ysiz(0),xsiz(32),ysiz(32),1

		pos posbufx+xsiz(15),posbufy+ysiz(40)
		boxfofmes int(loadset("dispcolormode",settingdata))
		mes launcherbufferstr.cnt
		pos posbufx+xsiz(275),posbufy+ysiz(40);260+15=275
		colorsetting settingdata
		mes launcherbufferstr.cnt

		if qwertydebug=1:{
			pos posbufx+xsiz(60),posbufy+ysiz(10)
			boxfofmes int(loadset("dispcolormode",settingdata))
			mes "No."+(cnt+1)
			pos posbufx+xsiz(320),posbufy+ysiz(10)
			colorsetting settingdata
			mes "No."+(cnt+1)
		}

		boxfofmes int(loadset("dispcolormode",settingdata))
		boxf posbufx,posbufy+ysiz(68),posbufx+xsiz(250),posbufy+ysiz(70);横250px 縦2px
		boxf posbufx+xsiz(247),posbufy,posbufx+xsiz(250),posbufy+ysiz(70);横3px 縦70px
		colorsetting settingdata
		boxf posbufx+xsiz(260),posbufy+ysiz(68),posbufx+xsiz(510),posbufy+ysiz(70);横250px 縦2px
		boxf posbufx+xsiz(507),posbufy,posbufx+xsiz(510),posbufy+ysiz(70);縦3px 縦70px

		posbufy+=ysiz(80)

		await 1
	loop

	redraw 1
	
	return

*makelauncherbutton
	redraw 0
	gsel 0,0
	firstposbufx=xsiz(10)-launcherwindowpos
	firstposbufy=ysiz(40)
	endposbufy=xsiz(20)
	posbufx=firstposbufx
	posbufy=firstposbufy
	addposbufx=xsiz(260)
	addposbufy=ysiz(80)
	posbufx2=xsiz(10)
	posbufy2=ysiz(10)
	launcherposbufxtest=1
	objsize xsiz(250),ysiz(70)
	repeat int(loadset("launcherdatamax",launcherdata))
		pos posbufx,posbufy
		objimage 503,posbufx2,posbufy2,posbufx2,posbufy2,posbufx2+xsiz(260),posbufy2
		button "",*launch
		launcherbuttonadr.cnt=stat

		if (ginfo(13)-firstposbufy)<=(posbufy+addposbufy+firstposbufy+endposbufy):{
			posbufx+=addposbufx
			posbufy=firstposbufy
			launcherposbufxtest+=1
		}else{
			posbufy+=addposbufy
		}
		posbufy2+=ysiz(80)

		await 1
	loop
	launcherposbufxbuffer=xsiz(10)+(addposbufx*launcherposbufxtest)

	redraw 1

	return

*launcherui
	mousewheelbuf=mousew
	mousewheelbuttonbuf=0
	if mousewheelbuf>0:{
		if (launcherwindowpos-xsiz(40))<=0:{
			launcherwindowpos=xsiz(0)
		}else{
			launcherwindowpos-=xsiz(40)
		}
		ScrollBar_SetPos launcherscrollbaradr,launcherwindowpos
	}else:if mousewheelbuf<0:{
		if launcherwindowpos<launcherposbufxbuffer:{
			launcherwindowpos+=xsiz(40)
			ScrollBar_SetPos launcherscrollbaradr,launcherwindowpos
		}
	}

	if launcherwindowpos!launcherwindowposbuf:{
		launcherwindowposbuf=launcherwindowpos
		mousewheelbuttonbuf=1
	}else{
		mousewheelbuttonbuf=0
	}
	
	if ScrollBar_GetPos(launcherscrollbaradr)!launcherscrollbargetposbuf:{
		mousewheelbuttonbuf=1
		launcherscrollbargetposbuf=ScrollBar_GetPos(launcherscrollbaradr)
		launcherwindowpos=ScrollBar_GetPos(launcherscrollbaradr)
	}

	if mousewheelbuttonbuf!0|systemsizechange!0:{
		redraw 0
		if systemsizechange!0:{
			color 0,0,0
			boxf xsiz(0),ysiz(32),ginfo(12),ginfo(13)-ysiz(20)
	
			sizebufx=ginfo(12)
			sizebufy=ginfo(13)-ysiz(52)
			if loadset("backgroundmode",settingdata)="COLOR":{
				backgroundcolorrgbdata=loadset("backgroundcolor",settingdata)
				split backgroundcolorrgbdata,",",backgroundcolorrdata,backgroundcolorgdata,backgroundcolorbdata
				color int(backgroundcolorrdata),int(backgroundcolorgdata),int(backgroundcolorbdata)
				boxf xsiz(0),ysiz(32),ginfo(12),ginfo(13)
			}else:if loadset("backgroundmode",settingdata)="IMAGE":{
				gsel 1007,0
				backpicx=ginfo(12)
				backpicy=ginfo(13)
				gsel 0000,0
				if ((backpicy*sizebufx)/backpicx)<=(sizebufy):{
					posbuf3=(backpicy*sizebufx)/backpicx
					posbuf4=(sizebufy-posbuf3)/2
					pos xsiz(0),ysiz(32)+posbuf4
					gzoom sizebufx,posbuf3,1007,0,0,backpicx,backpicy,1
				}else{
					posbuf3=(backpicx*sizebufy)/backpicy
					posbuf4=(sizebufx-posbuf3)/2
					pos xsiz(0)+posbuf4,ysiz(32)
					gzoom posbuf3,sizebufy,1007,0,0,backpicx,backpicy,1
				}
			}else:if loadset("backgroundmode",settingdata)="SLIDESHOW":{
				gsel 1007,0
				backpicx=ginfo(12)
				backpicy=ginfo(13)
				gsel 0000,0
				if ((backpicy*sizebufx)/backpicx)<=sizebufy:{
					posbuf3=(backpicy*sizebufx)/backpicx
					posbuf4=(sizebufy-posbuf3)/2
					pos xsiz(0),ysiz(32)+posbuf4
					gzoom sizebufx,posbuf3,1007,0,0,backpicx,backpicy,1
				}else{
					posbuf3=(backpicx*sizebufy)/backpicy
					posbuf4=(sizebufx-posbuf3)/2
					pos xsiz(0)+posbuf4,ysiz(32)
					gzoom posbuf3,sizebufy,1007,0,0,backpicx,backpicy,1
				}
			}
		}

		firstposbufx=xsiz(10)-launcherwindowpos
		firstposbufy=ysiz(40)
		endposbufy=ysiz(20)
		posbufx=firstposbufx
		posbufy=firstposbufy
		addposbufx=xsiz(260)
		addposbufy=ysiz(80)
		posbufx2=xsiz(10)
		posbufy2=ysiz(10)
		launcherposbufxtest=1
		repeat int(loadset("launcherdatamax",launcherdata))
			size=0,0,posbufx,posbufy
			resizeobj launcherbuttonadr.cnt,size,2
	
			;MoveWindow objinfo(launcherbuttonadr.cnt,2),posbufx,posbufy,xsiz(250),ysiz(70),0
	
			if (ginfo(13)-firstposbufy)<=(posbufy+addposbufy+firstposbufy+endposbufy):{
				posbufx+=addposbufx
				posbufy=firstposbufy
				launcherposbufxtest+=1
			}else{
				posbufy+=addposbufy
			}
			posbufy2+=ysiz(80)
		loop
		launcherposbufxbuffer=xsiz(10)+(addposbufx*launcherposbufxtest)

		ScrollBar_SetRange launcherscrollbaradr,0,launcherposbufxbuffer,(launcherposbufxbuffer/10)
		size=ginfo(12),ysiz(20),xsiz(0),ginfo(13)-ysiz(20)
		resizeobj launcherscrollbaradr,size,0
	
		redraw 1
	}

	return

*launch
	pullbuttonadr=stat
	repeat int(loadset("launcherdatamax",launcherdata)),1
		if launcherbuttonadr.(cnt-1)=pullbuttonadr:{
			pulllauncherbuttoncnt=cnt
			break
		}
	loop
	if loadset(""+pulllauncherbuttoncnt+"_data",launcherdata)="":{
		dialog langstr(6002),0,langstr(0001)
		goto *systemrepeat
	}

	pullbuttonopt=loadset(""+pulllauncherbuttoncnt+"_opt",launcherdata)

	if instr(windowsver,0,"NT")=-1:{
		ntmode=0
	}else{
		ntmode=1
	}

	launchoption=""
	if instr(pullbuttonopt,0,"/min")!-1:{
		if ntmode=1:{
			launchoption+="/min"
		}else{;9x
			launchoption+="/m"
		}
	}
	if instr(pullbuttonopt,0,"/max")!-1:{
		if ntmode=1:{
			launchoption+="/max"
		}else{;9x
			launchoption+="/max"
		}
	}

	launchonstart=""
	if instr(pullbuttonopt,0,"/onstart:")!-1:{
		launchonstartbuf=instr(pullbuttonopt,0,"/onstart:<path>")+strlen("/onstart:<path>")
		launchonstart=strmid(pullbuttonopt,launchonstartbuf,instr(pullbuttonopt,0,"</path>")-launchonstartbuf)
		launchonstart="\""+launchonstart+"\""
	}

	if ntmode=1:{
		if loadset(""+pulllauncherbuttoncnt+"_runas",launcherdata)="1":{
			windowsbatsign="launcherrunasnt"
			gosub *windowsbat
		}else{
			exec "cmd /c start \"\" "+launchoption+" "+launchonstart+" \""+loadset(""+pulllauncherbuttoncnt+"_data",launcherdata)+"\"",2
		}
	}else{;9x
		if loadset(""+pulllauncherbuttoncnt+"_runas",launcherdata)="1":{
			windowsbatsign="launcherrunas9x"
			gosub *windowsbat
		}else{
			exec "start "+launchoption+" "+launchonstart+" \""+loadset(""+pulllauncherbuttoncnt+"_data",launcherdata)+"\"",2
		}
	}

	if loadset("automini",settingdata)="1":{
		sendmsg hwnd,$112,$F020;SC_MINIMIZE
	}

	goto *systemrepeat

*launcheradd
	if launcheraddcurrent=0:{
		launcheraddcurrent=1
		
		gsel 0000
		bufx=ginfo(12)
		bufy=ginfo(13)
		redraw 0
		onkey 0
		onclick 0
		beforex=ginfo(4)
		beforey=ginfo(5)
		enablewindow hclient,0
		screen 201,xsiz(640),ysiz(450),4+8
		gsel 201,2
		GetWindowLong hwnd, -16
		SetWindowLong hwnd, -16, stat - $80000
		width xsiz(640),ysiz(450),beforex,beforey
		boxfofmes int(loadset("dispcolormode",settingdata)),xsiz(0),ysiz(0),xsiz(640),ysiz(450)
		font fontstr,fontsize,0
		objmode 2,1
		redraw 1
	
		title ""+langstr(60031)+""
	
		pos xsiz(10),ysiz(10)
		boxfofmes onezero(loadset("dispcolormode",settingdata)),xsiz(10),ysiz(10),xsiz(630),ysiz(40)
		pos xsiz(12),ysiz(10)
		font fontstr,fontsize+6,1
		mes langstr(6101)
		font fontstr,fontsize,0
	
		pos xsiz(10),ysiz(50)
		boxfofmes onezero(loadset("dispcolormode",settingdata)),xsiz(10),ysiz(50),xsiz(630),ysiz(70)
		pos xsiz(12),ysiz(50)
		mes langstr(6102)
	
		pos xsiz(10),ysiz(90)
		objsize xsiz(620),ysiz(30)
		radiobuttonbuf=1
		chkbox langstr(6103),radiobuttonbuf
		radiobuttonbufadr=stat
		setwindowlong objinfo(radiobuttonbufadr,2),-16,$50000009|$20000
	
		pos xsiz(30),ysiz(130)
		boxfofmes onezero(loadset("dispcolormode",settingdata)),xsiz(30),ysiz(130),xsiz(630),ysiz(170)
		pos xsiz(32),ysiz(130)
		mes langstr(61031)
	
		pos xsiz(10),ysiz(180)
		radiobuttonbuf2=0
		chkbox langstr(6104),radiobuttonbuf2
		radiobuttonbuf2adr=stat
		sendmsg objinfo(radiobuttonbuf2adr,2),$F4,$9
	
		pos xsiz(30),ysiz(220)
		boxfofmes onezero(loadset("dispcolormode",settingdata)),xsiz(30),ysiz(220),xsiz(630),ysiz(260)
		pos xsiz(32),ysiz(220)
		mes langstr(61041)
	
		pos xsiz(10),ysiz(270)
		radiobuttonbuf3=0
		chkbox langstr(6105),radiobuttonbuf3
		radiobuttonbuf3adr=stat
		sendmsg objinfo(radiobuttonbuf3adr,2),$F4,$9
	
		pos xsiz(30),ysiz(310)
		boxfofmes onezero(loadset("dispcolormode",settingdata)),xsiz(30),ysiz(310),xsiz(630),ysiz(350)
		pos xsiz(32),ysiz(310)
		mes langstr(61051)

		pos xsiz(530),ysiz(420)
		objsize xsiz(100),ysiz(30)
		button langstr(6106),*launcheraddno

		pos xsiz(420),ysiz(420)
		button langstr(6107),*launcheradd
	}else:if launcheraddcurrent=1:{
		sendmsg objinfo(radiobuttonbuf3adr,2),$F0
		if stat=1:{
			dialog "現在マクロランチャーは未開発状態です。\n開発完了するまではこの方法を使用することはできません。"
			goto *launcheraddrepeat
		}
		sendmsg objinfo(radiobuttonbuf2adr,2),$F0
		if stat=1:{;空ランチャー作成を選択した場合
			launcheraddcurrent=4
			editlauncherdata=""
			editlaunchername=""
			editlaunchericon=""
			editoption1=0
			editoption2=0
			editoption3=0
			editoption4=0
			editoption5=0
			editoption6=0

			goto *launcheradd
		}

		launcheraddcurrent=2

		redraw 0
		onkey 0
		onclick 0
		cls 0
		boxfofmes int(loadset("dispcolormode",settingdata)),xsiz(0),ysiz(0),xsiz(640),ysiz(450)
		font fontstr,fontsize,0
		objmode 2,1
		redraw 1

		pos xsiz(10),ysiz(10)
		boxfofmes onezero(loadset("dispcolormode",settingdata)),xsiz(10),ysiz(10),xsiz(630),ysiz(40)
		pos xsiz(12),ysiz(10)
		font fontstr,fontsize+6,1
		mes langstr(6108)
		font fontstr,fontsize,0

		pos xsiz(10),ysiz(50)
		boxfofmes onezero(loadset("dispcolormode",settingdata)),xsiz(10),ysiz(50),xsiz(630),ysiz(70)
		pos xsiz(12),ysiz(50)
		mes langstr(6109)

		pos xsiz(10),ysiz(80)
		objsize xsiz(520),ysiz(30)
		if editlauncherdata=0:{
			editlauncherdata=""
		}
		input editlauncherdata,xsiz(520),ysiz(30),0
		editlauncherdataadr=stat
		pos xsiz(530),ysiz(80)
		objsize xsiz(100),ysiz(30)
		button langstr(61091),*launcheradddialog
		launcheradddialogadr=stat

		pos xsiz(30),ysiz(120)
		boxfofmes onezero(loadset("dispcolormode",settingdata)),xsiz(30),ysiz(120),xsiz(630),ysiz(160)
		pos xsiz(32),ysiz(120)
		mes langstr(61094)

		pos xsiz(10),ysiz(200)
		boxfofmes onezero(loadset("dispcolormode",settingdata)),xsiz(10),ysiz(200),xsiz(630),ysiz(220)
		pos xsiz(12),ysiz(200)
		mes langstr(6110)

		pos xsiz(10),ysiz(230)
		objsize xsiz(620),ysiz(30)
		if editlaunchername=0:{
			editlaunchername=""
		}
		input editlaunchername,xsiz(620),ysiz(30),0
		editlaunchernameadr=stat

		pos xsiz(30),ysiz(270)
		boxfofmes onezero(loadset("dispcolormode",settingdata)),xsiz(30),ysiz(270),xsiz(630),ysiz(310)
		pos xsiz(32),ysiz(270)
		mes langstr(61101)

		pos xsiz(530),ysiz(420)
		objsize xsiz(100),ysiz(30)
		button langstr(6106),*launcheraddno

		pos xsiz(420),ysiz(420)
		button langstr(6107),*launcheradd

		pos xsiz(310),ysiz(420)
		button langstr(61071),*launcheraddback
	}else:if launcheraddcurrent=2:{
		if editlauncherdata="":{
			dialog langstr(6111),1,langstr(60031)
			goto *launcheraddrepeat
		}
		if editlaunchername="":{
			dialog langstr(6112),1,langstr(60031)
			goto *launcheraddrepeat
		}

		launcheraddcurrent=3

		redraw 0
		onkey 0
		onclick 0
		cls 0
		boxfofmes int(loadset("dispcolormode",settingdata)),xsiz(0),ysiz(0),xsiz(640),ysiz(450)
		font fontstr,fontsize,0
		objmode 2,1
		buffer 504,xsiz(32),ysiz(32),0
		gsel 201,0
		redraw 1

		editlaunchericonbuf="<none>"

		pos xsiz(10),ysiz(10)
		boxfofmes onezero(loadset("dispcolormode",settingdata)),xsiz(10),ysiz(10),xsiz(630),ysiz(40)
		pos xsiz(12),ysiz(10)
		font fontstr,fontsize+6,1
		mes langstr(6113)
		font fontstr,fontsize,0

		pos xsiz(10),ysiz(50)
		boxfofmes onezero(loadset("dispcolormode",settingdata)),xsiz(10),ysiz(50),xsiz(630),ysiz(70)
		pos xsiz(12),ysiz(50)
		mes langstr(6114)

		pos xsiz(30),ysiz(85)
		boxfofmes onezero(loadset("dispcolormode",settingdata)),xsiz(30),ysiz(85),xsiz(630),ysiz(105)
		pos xsiz(32),ysiz(85)
		mes langstr(6115)

		pos xsiz(10),ysiz(160)
		boxfofmes onezero(loadset("dispcolormode",settingdata)),xsiz(10),ysiz(160),xsiz(630),ysiz(180)
		pos xsiz(12),ysiz(160)
		mes langstr(6116)

		pos xsiz(10),ysiz(190)
		objsize xsiz(520),ysiz(30)
		if editlaunchericon=0:{
			editlaunchericon=""
		}
		input editlaunchericon,xsiz(520),ysiz(30),0
		editlaunchericonadr=stat
		pos xsiz(530),ysiz(190)
		objsize xsiz(100),ysiz(30)
		button langstr(61091),*launcheradddialog2
		launcheradddialog2adr=stat

		pos xsiz(30),ysiz(230)
		boxfofmes onezero(loadset("dispcolormode",settingdata)),xsiz(30),ysiz(230),xsiz(630),ysiz(330)
		pos xsiz(32),ysiz(230)
		mes langstr(61161)

		pos xsiz(530),ysiz(420)
		objsize xsiz(100),ysiz(30)
		button langstr(6106),*launcheraddno

		pos xsiz(420),ysiz(420)
		button langstr(6107),*launcheradd

		pos xsiz(310),ysiz(420)
		button langstr(61071),*launcheraddback
	}else:if launcheraddcurrent=3:{
		launcheraddcurrent=4

		redraw 0
		onkey 0
		onclick 0
		cls 0
		boxfofmes int(loadset("dispcolormode",settingdata)),xsiz(0),ysiz(0),xsiz(640),ysiz(450)
		font fontstr,fontsize,0
		objmode 2,1
		buffer 504,xsiz(32),ysiz(32),0
		gsel 201,0
		redraw 1

		editoption5buf=2

		pos xsiz(10),ysiz(10)
		boxfofmes onezero(loadset("dispcolormode",settingdata)),xsiz(10),ysiz(10),xsiz(630),ysiz(40)
		pos xsiz(12),ysiz(10)
		font fontstr,fontsize+6,1
		mes langstr(6113)
		font fontstr,fontsize,0

		pos xsiz(10),ysiz(60)
		objsize xsiz(620),ysiz(30)
		chkbox langstr(6118),editoption1
		editoption1adr=stat

		if editoption3=0&editoption4=0:{
			editoption4=1
		}

		pos xsiz(10),ysiz(110)
		chkbox langstr(6119),editoption2
		editoption2adr=stat
		pos xsiz(30),ysiz(150)
		objsize xsiz(600),ysiz(30)
		chkbox langstr(6120),editoption3
		editoption3adr=stat
		setwindowlong objinfo(editoption3adr,2),-16,$50000009|$20000
		pos xsiz(30),ysiz(180)
		chkbox langstr(6121),editoption4
		editoption4adr=stat
		sendmsg objinfo(editoption4adr,2),$F4,$9

		pos xsiz(10),ysiz(230)
		chkbox langstr(6122),editoption5
		editoption5adr=stat

		editoption6objbuf=0
		if editoption5=1:{
			pos xsiz(30),ysiz(270)
			boxfofmes onezero(loadset("dispcolormode",settingdata)),xsiz(30),ysiz(270),xsiz(630),ysiz(290)
			pos xsiz(32),ysiz(270)
			mes langstr(6123)
	
			pos xsiz(30),ysiz(300)
			objsize xsiz(500),ysiz(30)
			if editoption6=0:{
				editoption6=""
			}
			input editoption6,xsiz(500),ysiz(30),0
			editoption6adr=stat
			pos xsiz(530),ysiz(300)
			objsize xsiz(100),ysiz(30)
			button langstr(61091),*launcheradddialog3
			launcheradddialog3adr=stat

			editoption6objbuf=1
		}
		editoption5buf=editoption5

		pos xsiz(530),ysiz(420)
		objsize xsiz(100),ysiz(30)
		button langstr(6106),*launcheraddno

		pos xsiz(420),ysiz(420)
		button langstr(6107),*launcheradd

		pos xsiz(310),ysiz(420)
		button langstr(61071),*launcheraddback
	}else:if launcheraddcurrent=4:{
		if editoption5=1:{
			if editoption6="":{
				dialog langstr(61231),1,langstr(60031)
				goto *launcheraddrepeat
			}
		}
		
		launcheraddcurrent=5

		redraw 0
		onkey 0
		onclick 0
		cls 0
		boxfofmes int(loadset("dispcolormode",settingdata)),xsiz(0),ysiz(0),xsiz(640),ysiz(450)
		font fontstr,fontsize,0
		objmode 2,1
		buffer 504,xsiz(32),ysiz(32),0
		gsel 201,0
		redraw 1

		pos xsiz(10),ysiz(10)
		boxfofmes onezero(loadset("dispcolormode",settingdata)),xsiz(10),ysiz(10),xsiz(630),ysiz(40)
		pos xsiz(12),ysiz(10)
		font fontstr,fontsize+6,1
		mes langstr(6124)
		font fontstr,fontsize,0

		pos xsiz(10),ysiz(60)
		boxfofmes onezero(loadset("dispcolormode",settingdata)),xsiz(10),ysiz(60),xsiz(630),ysiz(80)
		pos xsiz(12),ysiz(60)
		mes langstr(6125)

		;番号 - ランチャーの名前
		pos xsiz(30),ysiz(90)
		boxfofmes onezero(loadset("dispcolormode",settingdata)),xsiz(30),ysiz(90),xsiz(630),ysiz(240)
		pos xsiz(32),ysiz(90)
		if editlaunchername="":{
			mes "No."+(int(loadset("launcherdatamax",launcherdata))+1)+" - "+langstr(6127)
		}else{
			mes "No."+(int(loadset("launcherdatamax",launcherdata))+1)+" - "+editlaunchername
		}

		;ランチャーのパス
		font fontstr,fontsize-2,0
		pos xsiz(32),ysiz(120)
		if editlauncherdata="":{
			mes ""+langstr(6133)+""+langstr(6126)
		}else{
			mes ""+langstr(6133)+""+editlauncherdata+""
		}
		font fontstr,fontsize,0

		;ランチャーのアイコン
		pos xsiz(32),ysiz(150)
		if editlaunchericon="":{
			mes ""+langstr(6134)+""+langstr(6128)+""
		}else{
			mes ""+langstr(6134)+""+editlaunchericon+""
		}

		;ランチャーのオプション
		pos xsiz(32),ysiz(180)
		editlauncheroptionmes=""+langstr(6135)+""
		if editoption1=1:{
			editlauncheroptionmes+=""+langstr(6129)+","
		}
		if editoption2=1:{
			if editoption3=1:{
				editlauncheroptionmes+=""+langstr(6130)+","
			}else:if editoption4=1{
				editlauncheroptionmes+=""+langstr(6131)+","
			}
		}
		mes editlauncheroptionmes

		;ランチャーのオプション2行目
		pos xsiz(32),ysiz(210)
		editlauncheroptionmes=""
		if editoption5=1:{
			if editoption6!"":{
				editlauncheroptionmes+=""+langstr(6132)+""+editoption6
			}
		}
		mes editlauncheroptionmes

		pos xsiz(530),ysiz(420)
		objsize xsiz(100),ysiz(30)
		button langstr(6106),*launcheraddno

		pos xsiz(420),ysiz(420)
		button langstr(6107),*launcheradd

		pos xsiz(310),ysiz(420)
		button langstr(61071),*launcheraddback
	}else:if launcheraddcurrent=5:{
		launcherdatamax=int(loadset("launcherdatamax",launcherdata))

		saveset ""+(launcherdatamax+1)+"_data",launcherdata,editlauncherdata

		if editlaunchername="":{
			saveset ""+(launcherdatamax+1)+"_name",launcherdata,langstr(6127)
		}else{
			saveset ""+(launcherdatamax+1)+"_name",launcherdata,editlaunchername
		}

		saveset ""+(launcherdatamax+1)+"_runas",launcherdata,str(editoption1)

		saveset ""+(launcherdatamax+1)+"_icon",launcherdata,editlaunchericon

		addoptionmes=""
		if editoption2=1:{
			if editoption3=1:{
				addoptionmes+="/max"
			}else:if editoption4=1:{
				addoptionmes+="/min"
			}
		}
		if editoption5=1:{
			if editoption6!"":{
				addoptionmes+="/onstart:<path>"+editoption6+"</path>"
			}
		}
		saveset ""+(launcherdatamax+1)+"_opt",launcherdata,addoptionmes

		saveset "launcherdatamax",launcherdata,str(launcherdatamax+1)
		launcherdatamax=int(loadset("launcherdatamax",launcherdata))

		dialog "No."+launcherdatamax+" - "+loadset(""+launcherdatamax+"_name",launcherdata)+"\n\n"+langstr(6136),0,langstr(60031)
		
		launcheraddcurrent=0
		editlauncherdata=""
		editlaunchername=""
		editlaunchericon=""
		editoption1=0
		editoption2=0
		editoption3=0
		editoption4=0
		editoption5=0
		editoption6=0
		gsel 201,-1
		gsel 0000,int(loadset("ALWAYSFRONT",settingdata))+1
		enablewindow hclient,1

		bufferallupdatestartupbuf=1
		gosub *makescreen
		bufferallupdatestartupbuf=0
		goto *systemrepeat
	}

	goto *launcheraddrepeat

*launcheraddback
	if launcheraddcurrent=2:{
		launcheraddcurrent=0
	}else:if launcheraddcurrent=3:{
		launcheraddcurrent=1
	}else:if launcheraddcurrent=4:{
		launcheraddcurrent=2
	}else:if launcheraddcurrent=5:{
		launcheraddcurrent=3
	}

	goto *launcheradd

*launcheradddialog3
	dialog "exe",16,"アプリケーションファイル"
	if stat!1:{
		goto *launcheraddrepeat
	}
	buf=refstr
	objprm editoption6adr,buf

	goto *launcheraddrepeat

*launcheradddialog2
	dialog "jpg;*.png;*.ico;*.bmp;*.",16,"画像ファイル"
	if stat!1:{
		goto *launcheraddrepeat
	}
	buf=refstr
	objprm editlaucnhericonadr,buf

	goto *launcheraddrepeat

*launcheradddialog
	dim rect,4
	hlauncheradddialog=objinfo(launcheradddialogadr,2)

	getwindowrect hlauncheradddialog,varptr(rect)
	trackpopupmenu hmenu.7,$100,rect.0,rect.3,0,hwnd,0
	if stat=$100:{;ファイルの参照
		dialog "",16,"ファイル"
		if stat!1:{
			goto *launcheraddrepeat
		}
		buf=refstr
		objprm editlauncherdataadr,buf
		objprm editlaunchernameadr,getpath(buf,1+8)
	}else:if stat=$101:{;フォルダの参照
		buf=folderdialog(langstr(53031))
		if buf="":{
			goto *launcheraddrepeat
		}
		objprm editlauncherdataadr,buf
		if strlen(buf)<=3:{;C:\のように文字数が3以下の場合
			objprm editlaunchernameadr,buf
		}else{;文字数が4以上の場合
			objprm editlaunchernameadr,getpath(buf,1+8)
		}
	}

	goto *launcheraddrepeat

*launcheraddrepeat
	onkey 0
	onclick 0
	oncmd 0

	if launcheraddcurrent=2:{
		getkey tab,9
		if tab=1:{
			objsel -1
			if stat=launcheradddialogadr:{
				objsel editlaunchernameadr
			}
		}
	}else:if launcheraddcurrent=3:{
		if editlaunchericonbuf!editlaunchericon:{
			editlaunchericonbuf=editlaunchericon

			if editlaunchericon="":{
				exist editlauncherdata
				if strsize!-1:{
					nowlauncherloadmode="file"
				}else{
					dirlist dummy,editlauncherdata,5
					if stat!0:{
						nowlauncherloadmode="folder"
					}else{
						sdim dl,2
						getlogicaldrives
						okdrive=stat
						canusedrive=""
						cantuse=0
						repeat 26
							dl=strf("%c",'a'+cnt)
							flag=1<<cnt
							if okdrive&flag:{
								notesel canusedrive
								noteadd ""+dl+":\\",-1,0
							}
						loop
						cantuse=0
						notesel canusedrive
						repeat notemax
							noteget buf,cnt
							if instr(buf,0,getpath(editlauncherdata,16))!-1:{
								cantuse=0
								break
							}else{
								cantuse=1
							}
						loop
						if cantuse!1:{
							nowlauncherloadmode="folder"
						}else{
							nowlauncherloadmode="other"
						}
					}
				}
			}else{
				nowlauncherloadmode="custom"
			}

			if loadset("dispcolormode",settingdata)="0":{
				drawiconexp9=2
			}else{
				drawiconexp9=3
			}
			gsel 504,0
			if nowlauncherloadmode="file"|nowlauncherloadmode="folder":{
				dim shfileinfo,88
				shgetfileinfo editlauncherdata,0,varptr(shfileinfo),$160,$100
				drawiconex hdc,xsiz(0),ysiz(0),shfileinfo.0,xsiz(32),ysiz(32),0,0,drawiconexp9
			}else:if nowlauncherloadmode="other":{
				hIcon=ExtractIcon(hInstance,"shell32.dll",54)
				drawiconex hdc,xsiz(0),ysiz(0),hIcon,xsiz(32),ysiz(32),0,0,drawiconexp9
			}else:if nowlauncherloadmode="custom":{
				exist editlaunchericon
				if strsize=-1:{
					hIcon=ExtractIcon(hInstance,"shell32.dll",54)
					drawiconex hdc,xsiz(0),ysiz(0),hIcon,xsiz(32),ysiz(32),0,0,drawiconexp9
				}else{
					buffer 505,xsiz(1),ysiz(1),0
					picload editlaunchericon,0
					backpicx=ginfo(12)
					backpicy=ginfo(13)
					gsel 504,01
					gzoom xsiz(32),ysiz(32),505,xsiz(0),ysiz(0),backpicx,backpicy,1
				}
			}

			gsel 201,0
			pos xsiz(40),ysiz(120)
			gzoom xsiz(28),ysiz(28),504,xsiz(0),ysiz(0),xsiz(32),ysiz(32),1
		}
	}else:if launcheraddcurrent=4:{
		if editoption2=1:{
			objenable editoption3adr,1
			objenable editoption4adr,1
		}else{
			objenable editoption3adr,0
			objenable editoption4adr,0
		}
		
		if editoption5buf!editoption5:{
			editoption5buf=editoption5
			if editoption5=0:{
				pos xsiz(30),ysiz(270)
				boxfofmes int(loadset("dispcolormode",settingdata)),xsiz(30),ysiz(270),xsiz(630),ysiz(290)

				if editoption6objbuf=1:{
					clrobj editoption6adr,editoption6adr
					clrobj launcheradddialog3adr,launcheradddialog3adr

					editoption6objbuf=0
				}
			}else:if editoption5=1:{
				pos xsiz(30),ysiz(270)
				boxfofmes onezero(loadset("dispcolormode",settingdata)),xsiz(30),ysiz(270),xsiz(630),ysiz(290)
				pos xsiz(32),ysiz(270)
				mes langstr(6123)
	
				pos xsiz(30),ysiz(300)
				objsize xsiz(500),ysiz(30)
				if editoption6=0:{
					editoption6=""
				}
				input editoption6,xsiz(500),ysiz(30),0
				editoption6adr=stat
				pos xsiz(530),ysiz(300)
				objsize xsiz(100),ysiz(30)
				button langstr(61091),*launcheradddialog3
				launcheradddialog3adr=stat

				editoption6objbuf=1
			}
		}
	}

	if fpsbufmes>settingfps:{
		await (1000/(settingfps-1))
	}else:if fpsbufmes=settingfps:{
		await (1000/(settingfps))
	}else:if fpsbufmes<settingfps:{
		await (1000/(settingfps+1))
	}

	if qwertydebug=1:{
		timeGetTime
		if fpsbuf!(stat/1000):{
			fpsbuf=(stat/1000)
			fpsbufmes=fpsbufcnt
			fpsbufcnt=0
		}else{
			fpsbufcnt+=1
		}
		title "<デバッグ> "+fpsbufmes+"fps"
	}
	
	goto *launcheraddrepeat

*launcheraddno
	launcheraddcurrent=0
	editlauncherdata=""
	editlaunchername=""
	editlaunchericon=""
	editoption1=0
	editoption2=0
	editoption3=0
	editoption4=0
	editoption5=0
	editoption6=0
	gsel 201,-1
	gsel 0000,int(loadset("ALWAYSFRONT",settingdata))+1

	enablewindow hclient,1

	goto *systemrepeat

//////////////////////////////////////////////////
//スタートメインメニュー
//////////////////////////////////////////////////

*startwindowsapp
	if winapp.0=stat:{;タスクマネージャー
		keybd_event $11,0,0,0
		keybd_event $10,0,0,0
		keybd_event $1B,0,0,0
		keybd_event $11,0,2,0
		keybd_event $10,0,2,0
		keybd_event $1B,0,2,0
	}else:if winapp.1=stat:{;Windowsの設定
		exec "cmd.exe /c Explorer.exe shell:AppsFolder\\Windows.ImmersiveControlPanel_cw5n1h2txyewy!microsoft.windows.immersivecontrolpanel",2
	}else:if winapp.2=stat:{;ファイル名を指定して実行
		findwindow "shell_traywnd",0
		htraywnd=stat
		sendmsg htraywnd,$111,$191
	}else:if winapp.3=stat:{;コントロールパネル
		exec "control"
	}

	if loadset("automini",settingdata)="1":{
		sendmsg hwnd,$112,$F020;SC_MINIMIZE
	}

	return

*windowspowerdialog
	dim rect,4
	hwindowspowerdialog=objinfo(windowspowerdialogadr,2)

	getwindowrect hwindowspowerdialog,varptr(rect)
	trackpopupmenu hmenu.1,$100,rect.0,rect.3,0,hwnd,0
	if stat=$100:{;Windowsをロックする
		windowsbatsign="windowslock"
		gosub *windowsbat
	}else:if stat=$101:{;Windowsの電源ダイアログ
		sendmsg hwnd,$112,$F020
		FindWindow "shell_traywnd",0
		htraywnd=stat
		sendmsg htraywnd,$111,$1FA
		sendmsg hwnd,$112,$F120
	}else:if stat=$102:{;Windowsをシャットダウンする
		windowsbatsign="windowsshutdown"
		gosub *windowsbat
	}else:if stat=$103:{;Windowsを再起動する
		windowsbatsign="windowsrestart"
		gosub *windowsbat
	}else{
		return
	}

	if loadset("automini",settingdata)="1":{
		sendmsg hwnd,$112,$F020;SC_MINIMIZE
	}

	return

*qwertypowerdialog
	dim rect,4
	hqwertypowerdialog=objinfo(qwertypowerdialogadr,2)

	getwindowrect hqwertypowerdialog,varptr(rect)
	trackpopupmenu hmenu.2,$100,rect.0,rect.3,0,hwnd,0
	if stat=$100:{;qwerty3xをロックする
		repeat bgscrwindowmax
			gsel (cnt+1),-1
		loop
		gsel 0000,int(loadset("ALWAYSFRONT",settingdata))+1
		clrobj
		color 0,0,0
		boxf
		goto *passwordinput
	}else:if stat=$101:{;qwerty3xを終了する
		shutdowntorestartsign=0
		goto *systemshutdown
	}else:if stat=$102:{;qwerty3xを再起動する
		shutdowntorestartsign=1
		goto *systemshutdown
	}else{
		goto *systemrepeat
	}

	goto *systemrepeat

//////////////////////////////////////////////////////////////////////
//システムスクリプト
//////////////////////////////////////////////////////////////////////

*windowsbat
	if windowsbatsign="windowslock":{
		windowsbatnote={"rundll32.exe user32.dll,LockWorkStation
		exit
		0"}
	}else:if windowsbatsign="windowsshutdown":{
		windowsbatnote={"shutdown /s /t 5
		exit
		0"}
	}else:if windowsbatsign="windowsrestart":{
		windowsbatnote={"shutdown /r /t 5
		exit
		0"}
	}else:if windowsbatsign="qwerty3xrestart":{
		windowsbatnote={"title restarting...
		timeout /t 0 /nobreak
		start \"\" \""}+qwertypath+{"\"
		exit
		0"}
	}else:if windowsbatsign="launcherrunasnt":{
		windowsbatnote={"cmd /c start \"\" "}+launchoption+{" "}+launchonstart+{" \""}+loadset(""+pulllauncherbuttoncnt+"_data",launcherdata)+{"\"
		1"}
	}else:if windowsbatsign="launcherrunas9x":{
		windowsbatnote={"start "}+launchoption+{" "}+launchonstart+{" \""}+loadset(""+pulllauncherbuttoncnt+"_data",launcherdata)+{"\"
		1"}
	}
	if okfullmode=-1:{
		bittype="x86"
	}else{
		dim bit,9
		GetNativeSystemInfo varptr(bit)
		if bit=6|bit=9:{
			bittype="x64"
		}else:if bit=0:{
			bittype="x86"
		}
	}
	
	exist ""+windowsbatfile+"\\windowsbat"+bittype+".exe"
	if strsize=-1:{
		dialog langstr(1010),1,"qwerty3x ver."+qwertyver
		return
	}

	chdir windowsbatfile

	notesel windowsbatnote
	notesave "windowsbatnote.txt"
	
	exec "windowsbat"+bittype+".exe",2

	return

*oncontext
	contexthwnd=strf("%d",wparam)
	if contexthwnd=objinfo(startmainmenuadr,2):{
		dim rect,4
		hstartmainmenu=objinfo(startmainmenuadr,2)

		getwindowrect hstartmainmenu,varptr(rect)
		trackpopupmenu hmenu.6,$100,rect.0,rect.3,0,hwnd,0
		if stat=$100:{;ランチャー
			startmainmenubuf=0
			screenname=langstr(3001)
			gosub *makescreen
		}else:if stat=$101:{;qwerty3xの設定
			startmainmenubuf=0
			screenname=langstr(3005)
			gosub *makescreen
		}else:if stat=$200:{;タスクマネージャー
			keybd_event $11,0,0,0
			keybd_event $10,0,0,0
			keybd_event $1B,0,0,0
			keybd_event $11,0,2,0
			keybd_event $10,0,2,0
			keybd_event $1B,0,2,0
			if loadset("automini",settingdata)="1":{
				sendmsg hwnd,$112,$F020;SC_MINIMIZE
			}
		}else:if stat=$201:{;Windowsの設定
			exec "cmd.exe /c Explorer.exe shell:AppsFolder\\Windows.ImmersiveControlPanel_cw5n1h2txyewy!microsoft.windows.immersivecontrolpanel",2
			if loadset("automini",settingdata)="1":{
				sendmsg hwnd,$112,$F020;SC_MINIMIZE
			}
		}else:if stat=$202:{;ファイル名を指定して実行
			findwindow "shell_traywnd",0
			htraywnd=stat
			sendmsg htraywnd,$111,$191
		}else:if stat=$203:{;コントロールパネル
			exec "control"
		}else:if stat=$300:{;Windowsをロックする
			windowsbatsign="windowslock"
			gosub *windowsbat
		}else:if stat=$301:{;Windowsの電源ダイアログ
			sendmsg hwnd,$112,$F020
			FindWindow "shell_traywnd",0
			htraywnd=stat
			sendmsg htraywnd,$111,$1FA
			sendmsg hwnd,$112,$F120
		}else:if stat=$302:{;Windowsをシャットダウンする
			windowsbatsign="windowsshutdown"
			gosub *windowsbat
		}else:if stat=$303:{;Windowsを再起動する
			windowsbatsign="windowsrestart"
			gosub *windowsbat
		}else:if stat=$400:{;qwerty3xをロックする
			repeat bgscrwindowmax
				gsel (cnt+1),-1
			loop
			gsel 0000,int(loadset("ALWAYSFRONT",settingdata))+1
			clrobj
			color 0,0,0
			boxf
			goto *passwordinput
		}else:if stat=$401:{;qwerty3xを終了する
			shutdowntorestartsign=0
			goto *systemshutdown
		}else:if stat=$402:{;qwerty3xを再起動する
			shutdowntorestartsign=1
			goto *systemshutdown
		}
	}else:if contexthwnd=hwnd:{
		dialog "メインウィンドウの右クリックを検出"
	}

	goto *systemrepeat

*sizechange;ウィンドウのサイズが変わったとき
	onerrortype="sizechange"
	redraw 0
	pos xsiz(0),ysiz(0)
	boxfofmes int(loadset("DISPCOLORMODE",settingdata)),xsiz(0),ysiz(0),ginfo(12),ysiz(30)
	line ginfo(12),ysiz(30),xsiz(0),ysiz(30)
		
	size=0,0,(ginfo(12)-xsiz(30)),0
	resizeobj endadr,size,2
	size=0,0,(ginfo(12)-xsiz(60)),0
	resizeobj maxadr,size,2
	size=0,0,(ginfo(12)-xsiz(90)),0
	resizeobj minadr,size,2

	systemsizechange=1
	if screenname=langstr(3001):{;ランチャー
		gosub *launcherui
	}else:if screenname=langstr(3002):{;スタートメインメニュー
		gosub *startmenuui
	}else:if screenname=langstr(3005):{;qwerty3xの設定
		gosub *controlui
	}
	systemsizechange=0

	if qwertydebug=1:{
		timeGetTime
		if fpsbuf!(stat/1000):{
			fpsbuf=(stat/1000)
			fpsbufmes=fpsbufcnt
			fpsbufcnt=0
		}else{
			fpsbufcnt+=1
		}
		titlebarstr=""
		titlebarstr="<デバッグ> "+fpsbufmes+"fps/"+settingfps+"fps posx:"+ginfo(4)+" posy:"+ginfo(5)+" sizx:"+ginfo(12)+" sizy:"+ginfo(13)+" test:"+test+" "+titlebarstr
		title titlebarstr+" changeing size... | "+langstr(0001);qwerty3x ver.%qwertyver%
	}

	await 1

	return

*vscroll
	onerrortype="vscroll"
	if screenname=langstr(3001):{;ランチャー
		if ScrollBar_GetInfo(1)=$114:{;横スクロールが検知されたとき
			if ScrollBar_GetInfo(4)=hscrollbar:{
				launcherwindowpos=ScrollBar_GetPos(launcherscrollbaradr)
			}
		}
	}else:if screenname=langstr(3002):{;スタートメインメニュー
		if ScrollBar_GetInfo(1)=$115:{;縦スクロールが検知されたとき
			if ScrollBar_GetInfo(4)=hscrollbar:{
				buf=ginfo(3)
				gsel 1,0
				mousewheelbuttonbuf=1
				groll 0,ScrollBar_GetPos(scrollbaradr)
				gsel buf,0
			}
		}
	}else:if screenname=langstr(3005):{;qwerty3xの設定
		if ScrollBar_GetInfo(1)=$115:{;縦スクロールが検知されたとき
			if ScrollBar_GetInfo(4)=hscrollbar2:{
				buf=ginfo(3)
				gsel 2,0
				mousewheelbuttonbuf=3
				;groll xsiz(0),ScrollBar_GetPos(scrollbar2adr)
				gsel buf,0
			}
		}
	}
	gosub *sizechange

	onerrortype=""

	return

*movechange;ウィンドウの位置が変わったとき
	onerrortype="movechange"
	redraw 0
	IsZoomed hwnd
	if iszoom!stat:{
		iszoom=stat
		clrobj maxadr,maxadr
		pos ginfo(12)-xsiz(60),ysiz(0)
		objsize xsiz(30),ysiz(30)
		if iszoom=0:{
			objimage 1008,xsiz(30),ysiz(59),xsiz(30),ysiz(59),xsiz(30),ysiz(60)
		}else{
			objimage 1008,xsiz(60),ysiz(59),xsiz(60),ysiz(59),xsiz(60),ysiz(60)
		}
		button gosub "",*windowmenualsizechange
		maxadr=stat
	}else{
		iszoom=stat
	}

	if qwertydebug=1:{
		timeGetTime
		if fpsbuf!(stat/1000):{
			fpsbuf=(stat/1000)
			fpsbufmes=fpsbufcnt
			fpsbufcnt=0
		}else{
			fpsbufcnt+=1
		}
		titlebarstr=""
		titlebarstr="<デバッグ> "+fpsbufmes+"fps/"+settingfps+"fps posx:"+ginfo(4)+" posy:"+ginfo(5)+" sizx:"+ginfo(12)+" sizy:"+ginfo(13)+" test:"+test+" "+titlebarstr
		title titlebarstr+" moveing window... | "+langstr(0001);qwerty3x ver.%qwertyver%
	}

	await 1

	if loadset("window_sizx",settingdata)!str(ginfo(12))|loadset("window_sizy",settingdata)!str(ginfo(13)):{
		gosub *sizechange
	}

	onerrortype=""

	return

*onclickjump;ウィンドウがクリックされたとき(onclick)
	if wparam=1:{
		sendmsg hwnd,$A1,2
	}

	return

*OnNCHITTEST;タイトルバーの色を変更
	dim area
	mposx = ginfo_mx - ginfo_wx1
	mposy = ginfo_my - ginfo_wy1
	if (mposx <= BORDERWIDTH)             : area |= LEFT
	if (mposx >= ginfo_winx - BORDERWIDTH): area |= RIGHT
	if (mposy <= BORDERWIDTH)             : area |= TOP
	if (mposy >= ginfo_winy - BORDERWIDTH): area |= BOTTOM
	if (area & LEFT) {
		if (area & TOP)    : return HTTOPLEFT
		if (area & BOTTOM) : return HTBOTTOMLEFT
		return HTLEFT
	}
	if (area & RIGHT) {
		if (area & TOP)    : return HTTOPRIGHT
		if (area & BOTTOM) : return HTBOTTOMRIGHT
		return HTRIGHT
	}
	if (area & TOP)    : return HTTOP
	if (area & BOTTOM) : return HTBOTTOM
	if (mposy <= CAPTIONHEIGHT) : return HTCAPTION
	
	return HTCLIENT

*onminmax;ウィンドウの最小サイズの指定
	dupptr minmaxinfo,lparam,40,4
	minmaxinfo(6)=xsiz(640)
	minmaxinfo(7)=ysiz(450)

	return 0
	
*systemrepeat;システムメインループ
	//システム
	gsel 0
	redraw 0
	IsZoomed hwnd
	if iszoom!stat:{
		iszoom=stat
		clrobj maxadr,maxadr
		pos ginfo(12)-xsiz(60),ysiz(0)
		objsize xsiz(30),ysiz(30)
		if iszoom=0:{
			objimage 1008,xsiz(30),ysiz(59),xsiz(30),ysiz(59),xsiz(30),ysiz(60)
		}else{
			objimage 1008,xsiz(60),ysiz(59),xsiz(60),ysiz(59),xsiz(60),ysiz(60)
		}
		button gosub "",*windowmenualsizechange
		maxadr=stat
	}else{
		iszoom=stat
	}
	IsIconic hwnd
	isicon=stat

	year=strf("%04d",gettime(0));年=year
	month=strf("%02d",gettime(1));月=month
	week=gettime(2)
	if week=0:{
		weekstr=langstr(4001);日
	}else:if week=1:{
		weekstr=langstr(4002);月
	}else:if week=2:{
		weekstr=langstr(4003);火
	}else:if week=3:{
		weekstr=langstr(4004);水
	}else:if week=4:{
		weekstr=langstr(4005);木
	}else:if week=5:{
		weekstr=langstr(4006);金
	}else:if week=6:{
		weekstr=langstr(4007);土
	};曜日番号=week 曜日=weekstr
	day=strf("%02d",gettime(3));日=day
	hour=gettime(4)
	if useampm=0:{
		hour=strf("%02d",hour)
	}else:if useampm=1:{
		if gettime(4)<12:{
			hour=strf("%02d",hour)
			hour="am"+hour
		}else:if gettime(4)>12&gettime(4)<=23:{
			hour=hour-12
			hour=strf("%02d",hour)
			hour="pm"+hour
		}
	}
	minute=strf("%02d",gettime(5))
	second=strf("%02d",gettime(6))

	dim system_power_status,3
	getsystempowerstatus varptr(system_power_status)
	batteryper=peek(system_power_status.0,2)
	batteryflag=peek(system_power_status.0,1)
	acstat=peek(system_power_status.0,0)
	batterytime=system_power_status.1
	//
	batterytimeday=(batterytime/86400)
	batterytimehour=((batterytime\86400)/3600)
	batterytimeminute=(((batterytime\86400)\3600)/60)
	batterytimesecond=(((batterytime\86400)\3600)\60)
	batterytimestr=""+langstr(4008)+" ";残り
	batterytimestr2=langstr(4008);残り
	if batterytimeday!0:{
		batterytimestr=batterytimestr+batterytimeday+langstr(4009);日
		batterytimestr2=batterytimestr2+batterytimeday+":"
	}
	if batterytimehour!0:{
		batterytimestr=batterytimestr+batterytimehour+langstr(4010);時間
	}
	batterytimestr2=batterytimestr2+strf("%02d",batterytimehour)
	if batterytimeminute!0:{
		batterytimestr=batterytimestr+batterytimeminute+langstr(4011);分
	}
	batterytimestr2=batterytimestr2+":"+strf("%02d",batterytimeminute)
	if batterytimesecond!0:{
		batterytimestr=batterytimestr+batterytimesecond+langstr(4012);秒
	}
	batterytimestr2=batterytimestr2+":"+strf("%02d",batterytimesecond)

	onexit 1
	onclick 1
	oncmd 1

	//ジャンプ
	onexit *shutdownwindowssystem
	onclick gosub *onclickjump
	onkey 0

	if qwertydebug=0:{
		onerror *systemerrordialog
	}else{
		onerror 0
	}

	oncmd gosub *sizechange,$005;WM_SIZE
	oncmd gosub *OnNCHITTEST, $084;WM_NCHITTEST
	oncmd gosub *movechange,$003;WM_MOVE
	oncmd gosub *onminmax,$024;WM_GETMINMAXINFO
	oncmd goto *oncontext,$07B;WM_CONTEXTMENU

	ScrollBar_SetSubLabel *vscroll

	//アプリ
	if screenname=langstr(3001):{;ランチャー
		gosub *launcherui
	}else:if screenname=langstr(3002):{;スタートメインメニュー
		gosub *startmenuui
	}else:if screenname=langstr(3005):{;qwerty3xの設定
		gosub *controlload
	}

	//システム
	titlebarstr=""
	if startmainmenubuf=1:{;スタートメインメニュー
		titlebarstr=""+screenname+"  /"+bufscreenname
	}else:if screenname=langstr(3005):{
			titlebarstr+=""+screenname+": "
		if loadset("controlpage",settingdata)="WINDOWSCREEN":{
			titlebarstr+=langstr(5001)
		}else:if loadset("controlpage",settingdata)="BACKGROUNDCOLOR":{
			titlebarstr+=langstr(5002)
		}else:if loadset("controlpage",settingdata)="APPACT":{
			titlebarstr+=langstr(5003)
		}else:if loadset("controlpage",settingdata)="PASSWORD":{
			titlebarstr+=langstr(5006)
		}else:if loadset("controlpage",settingdata)="APPINFO":{
			titlebarstr+=langstr(5004)
		}else:if loadset("controlpage",settingdata)="APPUPDATE":{
			titlebarstr+=langstr(5005)
		}
	}else{
		titlebarstr=""+screenname
	}
	if qwertydebug=1:{
		titlebarstr="<デバッグ> "+fpsbufmes+"fps/"+settingfps+"fps posx:"+ginfo(4)+" posy:"+ginfo(5)+" sizx:"+ginfo(12)+" sizy:"+ginfo(13)+" test:"+startmenugroll+" "+titlebarstr
	}
	if titlebarstr!titlebarstrbuf:{
		title titlebarstr+" | "+langstr(0001);qwerty3x ver.%qwertyver%
		titlebarstrbuf=titlebarstr
	}

	saveset "ISZOOMED",settingdata,str(iszoom)
	if iszoom!1:{
		saveset "WINDOW_POSX",settingdata,str(ginfo(4))
		saveset "WINDOW_POSY",settingdata,str(ginfo(5))
		saveset "WINDOW_SIZX",settingdata,str(ginfo(12))
		saveset "WINDOW_SIZY",settingdata,str(ginfo(13))
	}

	gosub *langstrrepupdate

	timeGetTime
	if fpsbuf!(stat/1000):{
		fpsbuf=(stat/1000)
		fpsbufmes=fpsbufcnt
		fpsbufcnt=0
	}else{
		fpsbufcnt+=1
	}

	if isicon=1:{
		await 1000;1fps
	}else{
		if fpsbufmes>settingfps:{
			await (1000/(settingfps-1))
		}else:if fpsbufmes=settingfps:{
			await (1000/(settingfps))
		}else:if fpsbufmes<settingfps:{
			await (1000/(settingfps+1))
		}
	}
	redraw 1
	goto *systemrepeat

*startmenuui
	gsel 0000
	
	boxfofmes int(loadset("DISPCOLORMODE",settingdata)),xsiz(0),ysiz(0),xsiz(150),ginfo(13)
	boxfofmes int(loadset("DISPCOLORMODE",settingdata)),xsiz(0),ginfo(13)-ysiz(40),ginfo(12),ginfo(13)
	if batteryflag!128&batteryflag!255&batteryper!255:{;バッテリー情報なしではないとき
		if acstat=1:{;充電中のとき
			pos xsiz(0),ginfo(13)-ysiz(90)
			mes ""+langstr(4013)+": "+batteryper+"%";AC電源
			if batteryper=100:{
				mes langstr(4014);バッテリー充電完了
			}else{
				if batteryflag>=8:{
					mes langstr(4015);バッテリー充電中
				}else{
					mes langstr(4018)
				}
			}
			boxf xsiz(0),ginfo(13)-ysiz(50),int(double(xsiz(150.0))*(double(batteryper)/100)),ginfo(13)-ysiz(45)
		}else{
			pos xsiz(0),ginfo(13)-ysiz(90)
			mes ""+langstr(4016)+": "+batteryper+"%";バッテリー
			if batterytime=-1:{
				if batteryper=100:{
					mes langstr(4014);バッテリー充電完了
				}else{
					mes langstr(4017);残り時間予測中
				}
			}else{
				mes batterytimestr2
			}
			boxf xsiz(0),ginfo(13)-ysiz(50),int(double(xsiz(150.0))*(double(batteryper)/100)),ginfo(13)-ysiz(45)
		}
	}else{
		boxf xsiz(0),ginfo(13)-ysiz(50),xsiz(150),ginfo(13)-ysiz(45)
	}
	line xsiz(150),ginfo(13),xsiz(150),ginfo(13)-ysiz(40)
	line xsiz(150),ginfo(13)-ysiz(40),xsiz(0),ginfo(13)-ysiz(40)
	fontysizepos=(ysiz(40)-fontysizedata.1)/2
	pos xsiz(160),(ginfo(13)-ysiz(40))+fontysizepos
	font fontstr,fontsize+ysiz(7),0;ysiz(22)
	mes ""+year+"/"+month+"/"+day+"("+weekstr+") "+hour+":"+minute+":"+second

	fontxsizepos=(xsiz(150)-fontxsizedata.1)/2
	pos fontxsizepos,(ginfo(13)-ysiz(40))+fontysizepos
	font fontstr,fontsize+ysiz(7),1+2;ysiz(22)
	mes "qwerty3x"
	font fontstr,fontsize,0;ysiz(15)

	clientwindowx=ginfo(12)
	clientwindowy=ginfo(13)
	gsel 0001,0
	redraw 0

	mousewheelbuf=mousew
	mousewheelbuttonbuf=0
	if mousewheelbuf>0:{
		mousewheelbuttonbuf=1
		groll 0,ginfo(9)-(ginfo(13)/15)
		ScrollBar_SetPos scrollbaradr,ginfo(9)
	}else:if mousewheelbuf<0:{
		if ginfo(9)<(nowstartmainposY+ysiz(30)):{
			mousewheelbuttonbuf=1
			groll 0,ginfo(9)+(ginfo(13)/15)
			ScrollBar_SetPos scrollbaradr,ginfo(9)
		}
	}

	if ScrollBar_GetPos(scrollbaradr)!scrollbargetposbuf:{
		mousewheelbuttonbuf=1
		scrollbargetposbuf=ScrollBar_GetPos(scrollbaradr)
		groll 0,ScrollBar_GetPos(scrollbaradr)
	}
	
	width (clientwindowx-xsiz(150)),(clientwindowy-ysiz(70)),xsiz(150),ysiz(30)

	if mousewheelbuttonbuf!0|systemsizechange!0:{
		if systemsizechange!0:{
			color 0,0,0
			boxf
		
			if loadset("backgroundmode",settingdata)="COLOR":{
				backgroundcolorrgbdata=loadset("backgroundcolor",settingdata)
				split backgroundcolorrgbdata,",",backgroundcolorrdata,backgroundcolorgdata,backgroundcolorbdata
				color int(backgroundcolorrdata),int(backgroundcolorgdata),int(backgroundcolorbdata)
				boxf xsiz(0),ysiz(0),ginfo(12),ginfo(13)
			}else:if loadset("backgroundmode",settingdata)="IMAGE":{
				gsel 1007,0
				backpicx=ginfo(12)
				backpicy=ginfo(13)
				gsel 0001,0
				if ((backpicy*ginfo(12))/backpicx)<=ginfo(13):{
					posbuf3=(backpicy*ginfo(12))/backpicx
					posbuf4=(ginfo(13)-posbuf3)/2
					pos xsiz(0),ysiz(0)+posbuf4
					gzoom ginfo(12),posbuf3,1007,0,0,backpicx,backpicy,1
				}else{
					posbuf3=(backpicx*ginfo(13))/backpicy
					posbuf4=(ginfo(12)-posbuf3)/2
					pos xsiz(0)+posbuf4,ysiz(0)
					gzoom posbuf3,ginfo(13),1007,0,0,backpicx,backpicy,1
				}
			}else:if loadset("backgroundmode",settingdata)="SLIDESHOW":{
				gsel 1007,0
				backpicx=ginfo(12)
				backpicy=ginfo(13)
				gsel 0001,0
				if ((backpicy*ginfo(12))/backpicx)<=ginfo(13):{
					posbuf3=(backpicy*ginfo(12))/backpicx
					posbuf4=(ginfo(13)-posbuf3)/2
					pos xsiz(0),ysiz(0)+posbuf4
					gzoom ginfo(12),posbuf3,1007,0,0,backpicx,backpicy,1
				}else{
					posbuf3=(backpicx*ginfo(13))/backpicy
					posbuf4=(ginfo(12)-posbuf3)/2
					pos xsiz(0)+posbuf4,ysiz(0)
					gzoom posbuf3,ginfo(13),1007,0,0,backpicx,backpicy,1
				}
			}
		}
		
		startmainmenuposx=(ginfo(12)-(xsiz(320)*(ginfo(12)/xsiz(320))))/2
			
		nowstartmainposY=ysiz(10)
		pos startmainmenuposx,nowstartmainposY
		boxfofmes onezero(loadset("DISPCOLORMODE",settingdata)),startmainmenuposx,nowstartmainposY,startmainmenuposx+fontxsizedata.2+xsiz(10),nowstartmainposY+fontysizedata.2
		pos startmainmenuposx+xsiz(3),nowstartmainposY
		mes langstr(3003);・qwerty3x アプリケーション
		
		nowstartmainpos=startmainmenuposx
		nowstartmainposY+=ysiz(40)
		bufferbuttonY=ysiz(0)
		size=0,0,nowstartmainpos,nowstartmainposY-ginfo(9)
		resizeobj qweapp.0,size,2;ランチャー
		if nowstartmainpos+(xsiz(300)*2)>=ginfo(12):{
			nowstartmainpos=startmainmenuposx
			nowstartmainposY+=ysiz(30)
		}else{
			nowstartmainpos+=xsiz(300)
			;nowstartmainposYは変わらない
		}
		bufferbuttonY+=ysiz(30)
		size=0,0,nowstartmainpos,nowstartmainposY-ginfo(9)
		resizeobj qweapp.1,size,2;qwerty3xの設定
		
		nowstartmainposY+=ysiz(40)
		pos startmainmenuposx,nowstartmainposY
		boxfofmes onezero(loadset("DISPCOLORMODE",settingdata)),startmainmenuposx,nowstartmainposY,startmainmenuposx+fontxsizedata.2+xsiz(10),nowstartmainposY+fontysizedata.2
		pos startmainmenuposx+xsiz(3),nowstartmainposY
		mes langstr(3004);・Windows アプリケーション
		
		nowstartmainpos=startmainmenuposx
		nowstartmainposY+=ysiz(40)
		bufferbuttonY+=ysiz(30)
		size=0,0,nowstartmainpos,nowstartmainposY-ginfo(9)
		resizeobj winapp.0,size,2;タスクマネージャー
		if winapp1cant!1:{
			if nowstartmainpos+(xsiz(300)*2)>=ginfo(12):{
				nowstartmainpos=startmainmenuposx
				nowstartmainposY+=ysiz(30)
			}else{
				nowstartmainpos+=xsiz(300)
				;nowstartmainposYは変わらない
			}
			bufferbuttonY+=ysiz(30)
			size=0,0,nowstartmainpos,nowstartmainposY-ginfo(9)
			resizeobj winapp.1,size,2;Windowsの設定
		}
		if nowstartmainpos+(xsiz(300)*2)>=ginfo(12):{
			nowstartmainpos=startmainmenuposx
			nowstartmainposY+=ysiz(30)
		}else{
			nowstartmainpos+=xsiz(300)
			;nowstartmainposYは変わらない
		}
		bufferbuttonY+=ysiz(30)
		size=0,0,nowstartmainpos,nowstartmainposY-ginfo(9)
		resizeobj winapp.2,size,2;ファイル名を指定して実行
		if nowstartmainpos+(xsiz(300)*2)>=ginfo(12):{
			nowstartmainpos=startmainmenuposx
			nowstartmainposY+=ysiz(30)
		}else{
			nowstartmainpos+=xsiz(300)
			;nowstartmainposYは変わらない
		}
		bufferbuttonY+=ysiz(30)
		size=0,0,nowstartmainpos,nowstartmainposY-ginfo(9)
		resizeobj winapp.3,size,2;コントロールパネル
		
		ScrollBar_SetRange scrollbaradr,0,nowstartmainposY+ysiz(30),(ginfo(13)/15)
		size=xsiz(20),ginfo(13),ginfo(12)-xsiz(20),ysiz(0)
		resizeobj scrollbaradr,size
	}
	
	;if mousewheelbuttonbuf=1:{
	;	mousewheelbuttonbuf=0
	;	;foreach qweapp
	;	;	objenable qweapp.cnt,0
	;	;	objenable qweapp.cnt,1
	;	;loop
	;	;foreach winapp
	;	;	objenable winapp.cnt,0
	;	;	objenable winapp.cnt,1
	;	;loop
	;	gosub *sizechange
	;}

	redraw 1
	gsel 0000

	return

//////////////////////////////////////////////////////////////////////
//設定読み書きスクリプト
//////////////////////////////////////////////////////////////////////

*loadingsettingfile;設定・言語ファイルを読み込む
	onerrortype="loadingsettingfile"
	title "Loading setting data... | qwerty3x ver."+qwertyver
	
	settingfile=""+qwertycur+"\\settingdata"
	languagefile=""+qwertycur+"\\languagedata"
	windowsbatfile=""+qwertycur+"\\windowsbat"
	textcodefile=""+qwertycur+"\\textcodechange"

	;設定ファイル読み込み
	chdir qwertycur
	dirlist dummy,settingfile,5
	if stat=0:{
		mkdir "settingdata"
	}
	chdir settingfile
	exist "setting.q3sf"
	if strsize=-1:{
		settingdata=defaultsettingdata

		encword passwordkey,settingdata,encsettingdata
		notesel encsettingdata
		notesave "setting.q3sf"
	}
	notesel decsettingdata
	noteload "setting.q3sf"
	decword decsettingdata,settingdata

	gosub *langstrrepupdate

	saveset "currentsettingver",settingdata,qwertyver

	chdir settingfile
	exist "launcher.q3sf"
	if strsize=-1:{
		launcherdata=defaultlauncherdata

		encword passwordkey,launcherdata,enclauncherdata
		notesel enclauncherdata
		notesave "launcher.q3sf"
	}
	notesel declauncherdata
	noteload "launcher.q3sf"
	decword declauncherdata,launcherdata

	onerrortype=""

	return

*langstrrepupdate;言語ファイルデータを更新する
	onerrortype="langstrrepupdate"
	if langstrrepstartupbuf=1:{
		langstrrepstartupbuf=0
		title "Loading language data... | qwerty3x ver."+qwertyver
	}
	
	;言語ファイル読み込み
	chdir qwertycur
	dirlist dummy,languagefile,5
	if stat=0:{
		mkdir "languagedata"
	}
	chdir languagefile

	languagefilelist=""
	dirlist languagefilelist,"*.q3lf",1
	if stat=0:{
		dialog "The language file could not be found.\nThe language setting will be changed to Japanese.\n\n言語ファイルが見つかりませんでした。\n言語設定を日本語に変更します。",0,"qwerty3x ver."+qwertyver
		saveset "LANGUAGE",settingdata,"ja_JP"
		exist ""+loadset("LANGUAGE",settingdata)+".q3lf"
		if strsize=-1:{
			dialog "The Japanese language file could not be found.\nStartup Process cannot continue.\nqwerty3x will now exit.\n\n日本語の言語ファイルが見つかりませんでした。\n起動処理を続行できません。\nqwerty3xを終了します。",0,"qwerty3x ver."+qwertyver
			end 
		}
	}
	
	exist ""+loadset("LANGUAGE",settingdata)+".q3lf"
	if strsize=-1:{
		dialog "The language file could not be found.\nThe language setting will be changed to Japanese.\n\n言語ファイルが見つかりませんでした。\n言語設定を日本語に変更します。",0,"qwerty3x ver."+qwertyver
		saveset "LANGUAGE",settingdata,"ja_JP"
		exist ""+loadset("LANGUAGE",settingdata)+".q3lf"
		if strsize=-1:{
			dialog "The Japanese language file could not be found.\nStartup Process cannot continue.\nqwerty3x will now exit.\n\n日本語の言語ファイルが見つかりませんでした。\n起動処理を続行できません。\nqwerty3xを終了します。",0,"qwerty3x ver."+qwertyver
			end 
		}
	}
	notesel languagedata
	noteload ""+loadset("LANGUAGE",settingdata)+".q3lf"
	
	;言語ファイル変換表の作成
	langstrrep=""
	langstrrep+="%qwertyver%==="+qwertyver+""
	langstrrep+="\n%windowsname%==="+windowsname+""
	langstrrep+="\n%verbuf2%==="+verbuf2+""

	onerrortype=""

	return

*saveingsettingfile;設定ファイルを保存する
	onerrortype="saveingsettingfile"
	chdir qwertycur
	dirlist dummy,settingfile,5
	if stat=0:{
		mkdir "settingdata"
	}
	if settingdata="":{
		settingdata=defaultsettingdata
	}
	
	chdir settingfile
	encword passwordkey,settingdata,encsettingdata
	notesel encsettingdata
	notesave "setting.q3sf"

	repeat
		notesel launcherdata
		if notefind(""+(cnt+1)+"_data",1)=-1:{
			saveset "launcherdatamax",launcherdata,str(cnt)
			break
		}
		await 1
	loop
	chdir settingfile
	encword passwordkey,launcherdata,enclauncherdata
	notesel enclauncherdata
	notesave "launcher.q3sf"

	onerrortype=""

	return

//////////////////////////////////////////////////////////////////////
//シャットダウンスクリプト
//////////////////////////////////////////////////////////////////////

*shutdownwindowssystem;終了するとき(onexit)
	if iparam=0:{
		;ユーザーの意思で終了
		shutdownmode=0
		restartmode=0
	}else:if iparam=0:{
		;Windowsシャットダウンで終了
		shutdownmode=1
		restartmode=0
	}

	goto *systemshutdown

*systemshutdown;qwerty3xを終了する
	onerrortype="systemshutdown"
	if endadr=stat:{
		;ユーザーの意志で終了
		shutdownmode=0
		restartmode=0
	}
	title ""+langstr(2001)+" | qwerty3x ver."+qwertyver;終了中

	gosub *saveingsettingfile

	if shutdowntorestartsign=1:{
		windowsbatsign="qwerty3xrestart"
		gosub *windowsbat
	}

	onerrortype=""

	end

//////////////////////////////////////////////////////////////////////
//エラースクリプト
//////////////////////////////////////////////////////////////////////

*systemerrordialog
	errornum=wparam;エラー番号
	linenum=lparam;エラー発生行番号

	dialogstr="An error has occurred.\nエラーが発生しました。\n\nerror number:"+errornum+""
	if hspdebugmode=1:{;スクリプトエディタからのコンパイル実行のとき
		dialogstr+="\nerror line number:"+linenum+""
	}
	dialogstr+="\n\n"
	if errornum=1:{
		dialogstr+="HSP error 1\n\nAn HSP3 system error has occurred. This is a fatal error.\nHSP3 システムエラーが発生しました。致命的なエラーです。"
	}else:if errornum=2:{
		dialogstr+="HSP error 2\n\nThere is a syntax error in the source code.\nソースコード内に文法が間違っている箇所があります。"
	}else:if errornum=3:{
		dialogstr+="HSP error 3\n\nThe parameter value is invalid.\nパラメータの値が異常です。"
	}else:if errornum=4:{
		dialogstr+="HSP error 4\n\nAn error occurred in a calculation expression in the source code.\nソースコード内の計算式でエラーが発生しました。"
	}else:if errornum=5:{
		dialogstr+="HSP error 5\n\nAn invaild omission of a parameter was detected in the source code.\nソースコード内で不可能なパラメータの省略が検出されました。"
	}else:if errornum=6:{
		dialogstr+="HSP error 6\n\nA parameter with an incorrect type is used in the source code.\nソースコード内で型が本来と違うパラメータが使用されています。"
	}else:if errornum=7:{
		dialogstr+="HSP error 7\n\nThe specified array element is invalid in the source code.\nソースコード内で指定した配列の要素が無効です。"
	}else:if errornum=8:{
		dialogstr+="HSP error 8\n\nNo valid label is specified in the source code.\nソースコード内で有効なラベルが指定されていません。"
	}else:if errornum=9:{
		dialogstr+="HSP error 9\n\nSubroutine or loop nesting is too deep in the source code.\nソースコード内でのサブルーチンやループのネストが深すぎます。"
	}else:if errornum=10:{
		dialogstr+="HSP error 10\n\nA return statement was found outside of a subroutine in the source code.\nソースコード内でサブルーチン外のreturnを検出しました。"
	}else:if errornum=11:{
		dialogstr+="HSP error 11\n\nA loop statement was found outside of a repeat block in the source code.\nソースコード内でrepeat外でのloopを検出しました。"
	}else:if errornum=12:{
		dialogstr+="HSP error 12\n\nThe file was not found or the file name is incalid.\nファイルが見つからないか無効な名前です。"
	}else:if errornum=13:{
		dialogstr+="HSP error 13\n\nImage file not found.\n画像ファイルがありません。"
	}else:if errornum=14:{
		dialogstr+="HSP error 14\n\nAn error occurred while calling an external file.\n外部ファイル呼び出し時にエラーが発生しました。"
	}else:if errornum=15:{
		dialogstr+="HSP error 15\n\nMismatched parantheses detected in a calculation expression in the source code.\nソースコード内の計算式において記述の違うカッコが検出されました。"
	}else:if errornum=16:{
		dialogstr+="HSP error 16\n\nToo many parameters specified in the source code.\nソースコード内でのパラメータの数が多すぎます。"
	}else:if errornum=17:{
		dialogstr+="HSP error 17\n\nThe string expression exceeds the maximum allowed length.\n文字列式で扱える文字数を越えました。"
	}else:if errornum=18:{
		dialogstr+="HSP error 18\n\nAn invalid variable name was used for assignment in the source code.\nソースコード内で代入できない変数名を指定しています。"
	}else:if errornum=19:{
		dialogstr+="HSP error 19\n\nDivision by zero occurred in the source code.\nソースコード内で0で除算しました。"
	}else:if errornum=20:{
		dialogstr+="HSP error 20\n\nA buffer overflow has occurred.\nバッファオーバーフローが発生しました。"
	}else:if errornum=21:{
		dialogstr+="HSP error 21\n\nAn unsupported feature was selected in the source code.\nソースコード内でサポートされない機能を選択しました。"
	}else:if errornum=22:{
		dialogstr+="HSP error 22\n\nParentheses nesting is too deep in a calculation expression in the source code.\nソースコード内での計算式のカッコが深すぎます。"
	}else:if errornum=23:{
		dialogstr+="HSP error 23\n\nNo variable name was specified in the source code.\nソースコード内で変数名が指定されていません。"
	}else:if errornum=24:{
		dialogstr+="HSP error 24\n\nA non-integer value was specified in the source code.\nソースコード内で整数以外が指定されています。"
	}else:if errornum=25:{
		dialogstr+="HSP error 25\n\nInvalid array element format in the source code.\nソースコード内での配列の要素書式が間違っています。"
	}else:if errornum=26:{
		dialogstr+="HSP error 26\n\nFailed to allocate memory. This is a fatal error.\nメモリの確保ができませんでした。致命的なエラーです。"
	}else:if errornum=27:{
		dialogstr+="HSP error 27\n\nFailed to initialize type. This is a fatal error.\nタイプの初期化に失敗しました。致命的なエラーです。"
	}else:if errornum=28:{
		dialogstr+="HSP error 28\n\nNo arguments were specified for the function in the source code.\nソースコード内での関数に引数が設定されていません。"
	}else:if errornum=29:{
		dialogstr+="HSP error 29\n\nStack overflow has occurred.\nスタック領域のオーバーフローが発生しました。"
	}else:if errornum=30:{
		dialogstr+="HSP error 30\n\nAn invalid name was specified as a parameter in the source code.\nソースコード内で無効か名前がパラメータに指定されています。"
	}else:if errornum=31:{
		dialogstr+="HSP error 31\n\nAssigned a value to an arrat variable with a mismatched type in the source code.\nソースコード内で異なる型を持つ配列変数に代入しました。"
	}else:if errornum=32:{
		dialogstr+="HSP error 32\n\nInvalid function parameter declaration in the source code.\nソースコード内での関数のパラメータ記述が不正です。"
	}else:if errornum=33:{
		dialogstr+="HSP error 33\n\nToo many object.\nオブジェクト数が多すぎます。"
	}else:if errornum=34:{
		dialogstr+="HSP error 34\n\nInvalid type used as an array or function in the source code.\nソースコード内で配列・関数として使用できない型です。"
	}else:if errornum=35:{
		dialogstr+="HSP error 35\n\nNo module variable was specified in the source code.\nソースコード内でモジュール変数が指定されていません。"
	}else:if errornum=36:{
		dialogstr+="HSP error 36\n\nInvalid module variable specified in the source code. This is a fatal error.\nソースコード内でのモジュール変数の指定が無効です。致命的なエラーです。"
	}else:if errornum=37:{
		dialogstr+="HSP error 37\n\nFailed to convert variable type.\n変数型の変換に失敗しました。"
	}else:if errornum=38:{
		dialogstr+="HSP error 38\n\nFailed to call external DLL.\n外部DLLの呼び出しに失敗しました。"
	}else:if errornum=39:{
		dialogstr+="HSP error 39\n\nFailed to call external object.\n外部オブジェクトの呼び出しに失敗しました。"
	}else:if errornum=40:{
		dialogstr+="HSP error 40\n\nFunction return value not set in the source code.\nソースコード内で関数の戻り値が設定されていません。"
	}else:if errornum=41:{
		dialogstr+="HSP error 41\n\nFunction used as a command in the source code.\nソースコード内で関数を命令として記述しています。"
	}else{
		dialogstr+="HSP error "+errornum+"\n\nAn unknown error has occurred. This is a fatal error.\n不明なエラーが発生しました。致命的なエラーです。"
	}

	if onerrortype="makescreen":{
		dialogstr+="\n\n\"makescreen\" flag detected. The error may have occurred during a screen transition.\n「makescreen」フラグを検出しました。「画面切り替え中」に発生したエラーの可能性があります。"
	}else:if onerrortype="sizechange":{
		dialogstr+="\n\n\"sizechange\" flag detected. The error may have occurred while resizing the window or during related operations.\n「sizechange」フラグを検出しました。「ウィンドウのサイズ調整中、またはその操作に関する処理中」に発生したエラーの可能性があります。"
	}else:if onerrortype="vscroll":{
		dialogstr+="\n\n\"vscroll\" flag detected. The error may have occurred during scrollbar operations or related processes.\n「vscroll」フラグを検出しました。「スクロールバー操作中、またはその差に関する処理中」に発生したエラーの可能性があります。"
	}else:if onerrortype="movechange":{
		dialogstr+="\n\n\"movechange\" flag detected. The error may have occurred while moving the window or during related operations.\n「movechange」フラグを検出しました。「ウィンドウの位置調整中、またはその操作に関する処理中」に発生したエラーの可能性があります。"
	}else:if onerrortype="loadingsettingfile":{
		dialogstr+="\n\n\"loadingsettingfile\" flag detected. The error may have occurred while loading the setting file.\n「loadingsettingfile」フラグを検出しました。「設定ファイル読み込み中」に発生したエラーの可能性があります。"
	}else:if onerrortype="langstrrepupdate":{
		dialogstr+="\n\n\"langstrrepupdate\" flag detected. The error may have occurred while detecting or loading the language file.\n「langstrrepupdate」フラグを検出しました。「言語ファイルの検出、または読み込み中」に発生したエラーの可能性があります。"
	}else:if onerrortype="saveingsettingfile":{
		dialogstr+="\n\n\"saveingsettingfile\" flag detected. The error may have occurred while saving the settings file.\n「saveingsettingfile」フラグを検出しました。「設定ファイル書き込み中」に発生したエラーの可能性があります。"
	}else:if onerrortype="systemshutdown":{
		dialogstr+="\n\n\"systemshutdown\" flag detected. The error may have occurred during the shutdown process of qwerty3x.\n「systemshutdown」フラグを検出しました。「qwerty3xの終了処理中」に発生したエラーの可能性があります。"
	}

	dialogstr+="\n\nqwerty3x will now exit.\nqwerty3xを終了します。"

	dialog dialogstr,1," qwerty3x critical error / qwerty3x 致命的なエラー"

	end
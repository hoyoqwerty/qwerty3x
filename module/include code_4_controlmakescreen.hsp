*takeoverstart2
	//ここまででパスワード入力までOK
	redraw 0
	onkey 0
	onclick 0
	screen 201,xsiz(640),ysiz(450),4+8
	gsel 201,2
	GetWindowLong hwnd, -16
	SetWindowLong hwnd, -16, stat - $80000
	width xsiz(640),ysiz(450)
	boxfofmes int(loadset("dispcolormode",settingdata)),xsiz(0),ysiz(0),xsiz(640),ysiz(450)
	font fontstr,fontsize,0
	objmode 2,1
	redraw 1

	title ""+langstr(5605611)+""

	notesel qwertyxxsetting
	noteget qwertyxxalwaysfront,9
	noteget qwertyxxautomini,10
	noteget qwertyxxfontset,11
	noteget qwertyxxdismode,13
	noteget qwertyxxupdatecheck,34
	noteget qwertyxxbackpicmode,17
	noteget qwertyxxbackpicr,19
	noteget qwertyxxbackpicg,20
	noteget qwertyxxbackpicb,21
	noteget qwertyxxbackpicpath,22
	noteget qwertyxxbackpicshow,64
	noteget qwertyxxbackpicshowrandom,65
	noteget qwertyxxsystemr,3
	noteget qwertyxxsystemg,4
	noteget qwertyxxsystemb,5

	takeoverstrings=""

	takeoverautochk=langstr(5605113),langstr(5605114)
	takeoverautochkrev=langstr(5605114),langstr(5605113)
	takeoverstrings.0=langstr(5605613)+" >>>"+takeoverautochk.int(qwertyxxalwaysfront)
	;常に最前面に表示する
	takeoverstrings.1=langstr(5605614)+" >>>"+takeoverautochk.int(qwertyxxautomini)
	;ランチャーや外部ウィンドウを開く操作をした時、自動でqwerty-XXが最小化されるようにする
	takeoverautochkbuf=langstr(560561501)
	split takeoverautochkbuf,",",takeoverautochkbuf2
	takeoverstrings.2=langstr(5605615)+" >>>"+takeoverautochkbuf2.int(qwertyxxfontset)
	;qwerty-XXのフォント
	takeoverautochkbuf=langstr(560561601)
	split takeoverautochkbuf,",",takeoverautochkbuf2
	takeoverstrings.3=langstr(5605616)+" >>>"+takeoverautochkbuf2.int(qwertyxxdismode)
	;qwerty-XXのダークモード・ライトモード
	takeoverstrings.4=langstr(5605617)+" >>>"+takeoverautochkrev.int(qwertyxxupdatecheck)
	;qwerty-XX起動時にアップデートの確認を行うようにするrev
	takeoverautochkbuf=langstr(560561801)
	split takeoverautochkbuf,",",takeoverautochkbuf2
	takeoverstrings.5=langstr(5605618)+" >>>"+takeoverautochkbuf2.int(qwertyxxbackpicmode)
	;qwerty-XXの背景
	takeoverstrings.6=langstr(5605619)+" >>>R:"+strf("%03d",qwertyxxbackpicr)+" G:"+strf("%03d",qwertyxxbackpicg)+" B:"+strf("%03d",qwertyxxbackpicb)
	;単色の色選択
	takeoverstrings.7=langstr(5605620)+" >>>"+qwertyxxbackpicpath
	;画像ファイルパス
	takeoverstrings.8=langstr(5605621)+" >>>"+qwertyxxbackpicshow
	;スライドショーフォルダパス
	takeoverstrings.9=langstr(5605622)+" >>>"+takeoverautochk.int(qwertyxxbackpicshowrandom)
	;画像の表示順をランダムにする
	takeoverstrings.10=langstr(5605623)+" >>>R:"+strf("%03d",qwertyxxsystemr)+" G:"+strf("%03d",qwertyxxsystemg)+" B:"+strf("%03d",qwertyxxsystemb)
	;qwerty-XX スタイルカラー

	pos xsiz(10),ysiz(10)
	boxfofmes onezero(loadset("dispcolormode",settingdata)),xsiz(10),ysiz(10),xsiz(630),ysiz(10)+(fontysizedata.3*2)
	pos xsiz(12),ysiz(10)
	mes ""+langstr(5605611)

	pos xsiz(10),ysiz(60)
	winobj "listbox","",$200,$50200001|$8,xsiz(620),ysiz(325)
	htakeoverlist=objinfo(stat,2)

	font fontstr,fontsize,0
	mref bmscr,67
	hfont=bmscr.38
	sendmsg htakeoverlist,$30,hfont,1

	takeoverstringsmax=0
	foreach takeoverstrings
		sendmsg htakeoverlist,$180,,takeoverstrings.cnt
		takeoverstringsmax+=1
	loop

	pos xsiz(10),ysiz(390)
	boxfofmes onezero(loadset("dispcolormode",settingdata)),xsiz(10),ysiz(390),xsiz(630),ysiz(390)+fontysizedata.3
	pos xsiz(12),ysiz(390)
	mes ""+langstr(5605624)

	pos xsiz(10),ysiz(420)
	objsize xsiz(150),ysiz(30)
	button goto langstr(5605625),*takeoverliston

	pos xsiz(370),ysiz(420)
	objsize xsiz(150),ysiz(30)
	button goto langstr(5605626),*takeoverstart2yes

	pos xsiz(530),ysiz(420)
	objsize xsiz(100),ysiz(30)
	button goto langstr(560516),*takeoverstart2no

	stop

*takeoverliston
	sendmsg htakeoverlist,$190
	if takeoverstringsmax=stat:{;全選択解除
		foreach takeoverstrings
			sendmsg htakeoverlist,$185,0,cnt
		loop
	}else{;全選択
		foreach takeoverstrings
			sendmsg htakeoverlist,$185,1,cnt
		loop
	}

	stop
	
*takeoverstart2no
	gsel 201,-1
	gsel 0000,int(loadset("ALWAYSFRONT",settingdata))+1

	enablewindow hclient,1

	goto *systemrepeat

*takeoverstart2yes
	sendmsg htakeoverlist,$190
	if stat=0:{
		dialog langstr(5605627),1,langstr(56056)
		stop
	}

	takeovernowstrings=""
	foreach takeoverstrings
		sendmsg htakeoverlist,$187,cnt
		if stat=1:{
			split takeoverstrings.cnt,">>>",splittakeoverstrings
			notesel takeovernowstrings
			noteadd splittakeoverstrings.0,-1
		}
	loop

	dialog ""+takeovernowstrings+"\n\n"+langstr(5605628),0,langstr(56056)

	notesel takeovernowstrings
	repeat notemax
		notesel takeovernowstrings
		noteget buf,cnt
		
		foreach takeoverstrings
			split takeoverstrings.cnt,">>>",splittakeoverstrings
			if buf=splittakeoverstrings.0:{
				backtakeoverbuf=cnt
			}
		loop

		if backtakeoverbuf=0:{
			saveset "alwaysfront",settingdata,qwertyxxalwaysfront
		}else:if backtakeoverbuf=1:{
			saveset "automini",settingdata,qwertyxxautomini
		}else:if backtakeoverbuf=2:{
			if int(qwertyxxfontset)=0:{
				saveset "fontname",settingdata,"AUTO"
			}else:if int(qwertyxxfontset)=1:{
				saveset "fontname",settingdata,"Yu Gothic UI"
			}else:if int(qwertyxxfontset)=2:{
				saveset "fontname",settingdata,"Meiryo UI"
			}else:if int(qwertyxxfontset)=3:{
				saveset "fontname",settingdata,"MS UI Gothic"
			}
		}else:if backtakeoverbuf=3:{
			saveset "dispcolormode",settingdata,qwertyxxdismode
		}else:if backtakeoverbuf=4:{
			saveset "startupdate",settingdata,str(onezero(qwertyxxupdatecheck))
		}else:if backtakeoverbuf=5:{
			if int(qwertyxxbackpicmode)=0:{
				saveset "backgroundmode",settingdata,"COLOR"
			}else:if int(qwertyxxbackpicmode)=1:{
				saveset "backgroundmode",settingdata,"IMAGE"
			}else:if int(qwertyxxbackpicmode)=2:{
				saveset "backgroundmode",settingdata,"SLIDESHOW"
			}
		}else:if backtakeoverbuf=6:{
			saveset "backgroundcolor",settingdata,""+qwertyxxbackpicr+","+qwertyxxbackpicg+","+qwertyxxbackpicb
		}else:if backtakeoverbuf=7:{
			saveset "backgroundfile",settingdata,qwertyxxbackpicpath
		}else:if backtakeoverbuf=8:{
			saveset "backgroundfolder",settingdata,qwertyxxbackpicshow
		}else:if backtakeoverbuf=9:{
			saveset "backgroundrandom",settingdata,qwertyxxbackpicshowrandom
		}else:if backtakeoverbuf=10:{
			saveset "systemrgb",settingdata,""+qwertyxsystemr+","+qwertyxxsystemg+","+qwertyxxsystemb
		}
	loop

	dialog langstr(5605629),0,langstr(56056)

	gsel 201,-1
	gsel 0000,int(loadset("ALWAYSFRONT",settingdata))+1
	
	enablewindow hclient,1

	bufferallupdatestartupbuf=1
	gosub *makescreen
	bufferallupdatestartupbuf=0

	goto *systemrepeat

*showdetail
	gsel 0000
	bufx=ginfo(12)
	bufy=ginfo(13)
	redraw 0
	onkey 0
	onclick 0
	beforex=ginfo(4)
	beforey=ginfo(5)
	enablewindow hclient,0
	screen 201,xsiz(640),ysiz(450),4+8
	gsel 201,2
	GetWindowLong hwnd, -16
	SetWindowLong hwnd, -16, stat - $80000
	width xsiz(640),ysiz(450),beforex,beforey
	boxfofmes int(loadset("dispcolormode",settingdata)),xsiz(0),ysiz(0),xsiz(640),ysiz(450)
	font fontstr,fontsize,0
	objmode 2,1
	redraw 1

	title ""+langstr(56052)+""

	sdim cpuname,4096
	dim cpumhz
	size=4096
	regopenkeyex $80000002,("HARDWARE\\DESCRIPTION\\System\\CentralProcessor\\0"),0,1,varptr(hkey)
	regqueryvalueex hkey,"ProcessorNameString",0,0,varptr(cpuname),varptr(size)
	regqueryvalueex hkey,"~MHz",0,0,varptr(cpumhz),varptr(size)
	if cpumhz>1000:{
		cpumhzstr2=str(double(cpumhz)/1000.0)
		cpumhzstr=""+strmid(cpumhzstr2,0,4)+" GHz"
	}else{
		cpumhzstr=""+cpumhz+" MHz"
	}

	if instr(windowsver,0,"NT")!-1:{
		maxmem=GetFullMemory()
		membyte="B"
		if maxmem>1024.0:{
			maxmem=(maxmem/1024.0);KB
			membyte="KB"
			if maxmem>1024.0:{
				maxmem=(maxmem/1024.0);MB
				membyte="MB"
				if maxmem>1024.0:{
					maxmem=(maxmem/1024.0);GB
					membyte="GB"
				}
			}
		}
	}

	pos xsiz(10),ysiz(10)
	boxfofmes onezero(loadset("dispcolormode",settingdata)),xsiz(10),ysiz(10),xsiz(630),ysiz(10)+(fontysizedata.3*18)
	pos xsiz(12),ysiz(10):mes ""+langstr(560527);qwerty3x
	line xsiz(620),ysiz(10)+(ginfo(15)/2),xsiz(12)+ginfo(14)+xsiz(5),ysiz(10)+(ginfo(15)/2)
	pos xsiz(12),ysiz(10)+(fontysizedata.3*1)
	mes ""+langstr(0001)+""
	pos xsiz(12),ysiz(10)+(fontysizedata.3*2):mes ""+langstr(5601);最終更新日
	pos xsiz(200),ysiz(10)+(fontysizedata.3*2):mes ""+qwertydate
	pos xsiz(12),ysiz(10)+(fontysizedata.3*3):mes ""+langstr(5602);コンパイル日時
	pos xsiz(200),ysiz(10)+(fontysizedata.3*3):mes ""+__date__+" "+__time__
	pos xsiz(12),ysiz(10)+(fontysizedata.3*4):mes ""+langstr(5603);合計コード行数
	pos xsiz(200),ysiz(10)+(fontysizedata.3*4):mes ""+qwertybuild
	pos xsiz(12),ysiz(10)+(fontysizedata.3*5):mes "Copyright (C) 2024-2025 hoyoqwerty All Rights Reserved."
	pos xsiz(12),ysiz(10)+(fontysizedata.3*6):mes "qwerty3x is created in \"Hot Soup Processor.\""
	;7は飛ばし
	pos xsiz(12),ysiz(10)+(fontysizedata.3*8):mes langstr(560528);Windows システム
	line xsiz(620),ysiz(10)+(fontysizedata.3*8)+(ginfo(15)/2),xsiz(12)+ginfo(14)+xsiz(5),ysiz(10)+(fontysizedata.3*8)+(ginfo(15)/2)
	pos xsiz(12),ysiz(10)+(fontysizedata.3*9):mes ""+windowsname+" ("+sysinfo(0)+")"
	pos xsiz(12),ysiz(10)+(fontysizedata.3*10):mes ""+langstr(560521)+"";プロセッサ(CPU)
	if instr(windowsver,0,"NT")!-1:{
		pos xsiz(200),ysiz(10)+(fontysizedata.3*10):mes ""+cpuname+""
		pos xsiz(200),ysiz(10)+(fontysizedata.3*11):mes ""+cpumhzstr
	}else{
		pos xsiz(200),ysiz(10)+(fontysizedata.3*10):mes ""+langstr(560526);Windows 9xでは非対応です。
	}
	pos xsiz(12),ysiz(10)+(fontysizedata.3*12):mes ""+langstr(560522)+"";メモリ(RAM)
	if instr(windowsver,0,"NT")!-1:{
		pos xsiz(200),ysiz(10)+(fontysizedata.3*12):mes ""+str(int(round(maxmem)))+" "+membyte
	}else{
		pos xsiz(200),ysiz(10)+(fontysizedata.3*12):mes ""+langstr(560526)+"";Windows 9xでは非対応です。
	}
	;13は飛ばし
	pos xsiz(12),ysiz(10)+(fontysizedata.3*14):mes langstr(560529);Windows 画面
	line xsiz(620),ysiz(10)+(fontysizedata.3*14)+(ginfo(15)/2),xsiz(12)+ginfo(14)+xsiz(5),ysiz(10)+(fontysizedata.3*14)+(ginfo(15)/2)
	pos xsiz(12),ysiz(10)+(fontysizedata.3*15):mes ""+langstr(560523)+"";ウィンドウサイズ
	pos xsiz(200),ysiz(10)+(fontysizedata.3*15):mes ""+bufx+"x"+bufy
	pos xsiz(12),ysiz(10)+(fontysizedata.3*16):mes ""+langstr(560524)+"";画面拡大率
	pos xsiz(200),ysiz(10)+(fontysizedata.3*16):mes ""+screennowxsize+""
	pos xsiz(12),ysiz(10)+(fontysizedata.3*17):mes ""+langstr(560525)+"";画面サイズ
	pos xsiz(200),ysiz(10)+(fontysizedata.3*17):mes ""+ginfo(20)+"x"+ginfo(21)

	pos xsiz(12),ysiz(450)-(fontysizedata.3*2)
	boxfofmes onezero(loadset("dispcolormode",settingdata)),xsiz(10),ysiz(450)-(fontysizedata.3*2),xsiz(630),ysiz(450)
	mes ""+langstr(5605210)+"";インストール位置
	pos xsiz(12),ysiz(450)-(fontysizedata.3)
	objsize xsiz(50),fontysizedata.3
	button gosub langstr(5605211),*showdetailpath
	pos xsiz(64),ysiz(450)-(fontysizedata.3)
	mes ""+qwertycur+""
	
	pos xsiz(530),ysiz(420)
	objsize xsiz(100),ysiz(30)
	button goto langstr(560516),*showdetailno
	
	stop

*showdetailpath
	dirlist dummy,qwertycur,5
	if stat=0:{
		dialog langstr(0006),1,langstr(0001)
		return
	}
	exec "explorer.exe "+qwertycur,0
	return

*showdetailno
	gsel 201,-1
	gsel 0000,int(loadset("ALWAYSFRONT",settingdata))+1

	enablewindow hclient,1

	goto *systemrepeat

*benchmarkstart
	gsel 0000
	redraw 0
	onkey 0
	onclick 0
	beforex=ginfo(4)
	beforey=ginfo(5)
	enablewindow hclient,0
	screen 201,xsiz(640),ysiz(450),4+8
	gsel 201,2
	GetWindowLong hwnd, -16
	SetWindowLong hwnd, -16, stat - $80000
	width xsiz(640),ysiz(450),beforex,beforey
	boxfofmes int(loadset("dispcolormode",settingdata)),xsiz(0),ysiz(0),xsiz(640),ysiz(450)
	font fontstr,fontsize,0
	objmode 2,1
	redraw 1

	title ""+langstr(560511)+""

	pos xsiz(10),ysiz(10)
	boxfofmes onezero(loadset("dispcolormode",settingdata)),xsiz(10),ysiz(10),xsiz(630),ysiz(10)+fontysizedata.3
	pos xsiz(12),ysiz(10)
	mes ""+langstr(560512)+" "+loadset("lastbenchmarkscore",settingdata)

	pos xsiz(10),ysiz(40)
	boxfofmes onezero(loadset("dispcolormode",settingdata)),xsiz(10),ysiz(40),xsiz(630),ysiz(40)+fontysizedata.3
	pos xsiz(12),ysiz(40)
	mes ""+langstr(560513)+" "+loadset("lastbenchmarkfps",settingdata)

	pos xsiz(10),ysiz(100)
	boxfofmes onezero(loadset("dispcolormode",settingdata)),xsiz(10),ysiz(100),xsiz(630),ysiz(100)+((fontysizedata.3)*2)
	pos xsiz(12),ysiz(100)
	mes ""+langstr(560514)+""

	pos xsiz(10),ysiz(300)
	objsize ginfo(12)-xsiz(20),ysiz(30)
	button goto langstr(560515),*benchmarkyes

	pos xsiz(10),ysiz(330)
	button goto langstr(5605111),*benchmarkauto

	pos xsiz(530),ysiz(420)
	objsize xsiz(100),ysiz(30)
	button goto langstr(560516),*benchmarkno
	
	stop

*benchmarkyes
	imagedir.0=""+qwertycur+"\\default\\defaultimage.jpg"
	imagedir.1=""+qwertycur+"\\default\\defaultimage2.png"
	imagedir.2=""+qwertycur+"\\default\\defaultimage3.png"
	imagedir.3=""+qwertycur+"\\default\\defaultimage4.png"
	imagedir.4=""+qwertycur+"\\default\\defaultimage5.png"

	screen 201,xsiz(640),ysiz(450),4+8
	gsel 201,2
	GetWindowLong hwnd, -16
	SetWindowLong hwnd, -16, stat - $80000
	boxfofmes int(loadset("dispcolormode",settingdata)),xsiz(0),ysiz(0),xsiz(640),ysiz(450)
	font fontstr,fontsize,0
	objmode 2,1

	title ""+langstr(560511)+" - "+langstr(560517)

	error=0
	repeat 5
		exist imagedir.cnt
		if strsize=-1:{
			error=1
			break
		}
		buffer (cnt+1500),1,1,0
		picload imagedir.cnt,0
	loop
	if error=1:{
		dialog langstr(560519),1,langstr(560511)
		goto *benchmarkno
	}

	gsel 201,2
	pos xsiz(530),ysiz(420)
	objsize xsiz(100),ysiz(30)
	button goto langstr(5605110),*benchmarkstart

	maxsecond=120
	secondbuf=0
	result=0
	repeat
		rndcnt=rnd(5)

		gsel (rndcnt+1500),0
		bufferxsize=ginfo(12)
		bufferysize=ginfo(13)

		gsel 201,0
		pos xsiz(rnd(640)),ysiz(rnd(450))
		gzoom rnd(640),rnd(450),(rndcnt+1500),0,0,bufferxsize,bufferysize,1

		timegettime
		if fpsbuf!(stat/1000):{
			fpsbuf=(stat/1000)
			fpsbufmes=fpsbufcnt
			result+=fpsbufcnt
			secondbuf+=1
			fpsbufcnt=0
		}else{
			fpsbufcnt+=1
		}

		title ""+langstr(560511)+" - "+langstr(560518)+" score:"+result+" "+fpsbufmes+"fps "+secondbuf+"s/"+maxsecond+"s"
		await

		if secondbuf=maxsecond:{
			break
		}
	loop

	saveset "lastbenchmarkscore",settingdata,str(result)
	saveset "lastbenchmarkfps",settingdata,str((result/maxsecond))
	
	gsel 201,-1
	gsel 0000,int(loadset("ALWAYSFRONT",settingdata))+1

	enablewindow hclient,1

	goto *benchmarkstart

*benchmarkno
	gsel 201,-1
	gsel 0000,int(loadset("ALWAYSFRONT",settingdata))+1

	enablewindow hclient,1

	goto *systemrepeat

*benchmarkauto
	benchmarkautobuf=""
	benchmarkautomes=""
	benchmarkautochk=langstr(5605113),langstr(5605114)

	if int(loadset("lastbenchmarkscore",settingdata))>=10000:{
		if int(loadset("lastbenchmarkscore",settingdata))>=12500:{
			if int(loadset("useanimation",settingdata))=0:{
				addtxt=" "+langstr(5206)+" \""+benchmarkautochk.int(loadset("useanimation",settingdata))+"\" -> \""+benchmarkautochk.1+"\""
				notesel benchmarkautomes
				noteadd addtxt,-1
				notesel benchmarkautobuf
				noteadd "useanimation",-1
			}
	
			if loadset("backgroundmode",settingdata)!"SLIDESHOW":{
				benchmarkautoinbackgroundmode=langstr(53022),langstr(53023),langstr(53024)
				if loadset("backgroundmode",settingdata)="COLOR":{
					benchmarkautoinbackgroundmodenow=benchmarkautoinbackgroundmode.0
				}else:if loadset("backgroundmode",settingdata)="IMAGE":{
					benchmarkautoinbackgroundmodenow=benchmarkautoinbackgroundmode.1
				}else:if loadset("backgroundmode",settingdata)="SLIDESHOW":{
					benchmarkautoinbackgroundmodenow=benchmarkautoinbackgroundmode.2
				}
				addtxt=" "+langstr(5302)+" \""+benchmarkautoinbackgroundmodenow+"\" -> \""+benchmarkautoinbackgroundmode.2+"\""
				notesel benchmarkautomes
				noteadd addtxt,-1
				notesel benchmarkautobuf
				noteadd "backgroundmode",-1
			}
		}else{
			if int(loadset("useanimation",settingdata))=0:{
				addtxt=" "+langstr(5206)+" \""+benchmarkautochk.int(loadset("useanimation",settingdata))+"\" -> \""+benchmarkautochk.1+"\""
				notesel benchmarkautomes
				noteadd addtxt,-1
				notesel benchmarkautobuf
				noteadd "useanimation",-1
			}
	
			if loadset("backgroundmode",settingdata)!"IMAGE":{
				benchmarkautoinbackgroundmode=langstr(53022),langstr(53023),langstr(53024)
				if loadset("backgroundmode",settingdata)="COLOR":{
					benchmarkautoinbackgroundmodenow=benchmarkautoinbackgroundmode.0
				}else:if loadset("backgroundmode",settingdata)="IMAGE":{
					benchmarkautoinbackgroundmodenow=benchmarkautoinbackgroundmode.1
				}else:if loadset("backgroundmode",settingdata)="SLIDESHOW":{
					benchmarkautoinbackgroundmodenow=benchmarkautoinbackgroundmode.2
				}
				addtxt=" "+langstr(5302)+" \""+benchmarkautoinbackgroundmodenow+"\" -> \""+benchmarkautoinbackgroundmode.1+"\""
				notesel benchmarkautomes
				noteadd addtxt,-1
				notesel benchmarkautobuf
				noteadd "backgroundmode",-1
			}
		}
	}else{
		if int(loadset("useanimation",settingdata))!0:{
			addtxt=" "+langstr(5206)+" \""+benchmarkautochk.int(loadset("useanimation",settingdata))+"\" -> \""+benchmarkautochk.0+"\""
			notesel benchmarkautomes
			noteadd addtxt,-1
			notesel benchmarkautobuf
			noteadd "useanimation",-1
		}

		if loadset("backgroundmode",settingdata)!"COLOR":{
			benchmarkautoinbackgroundmode=langstr(53022),langstr(53023),langstr(53024)
			if loadset("backgroundmode",settingdata)="IMAGE":{
				benchmarkautoinbackgroundmodenow=benchmarkautoinbackgroundmode.1
			}else:if loadset("backgroundmode",settingdata)="SLIDESHOW":{
				benchmarkautoinbackgroundmodenow=benchmarkautoinbackgroundmode.2
			}
			addtxt=" "+langstr(5302)+" \""+benchmarkautoinbackgroundmodenow+"\" -> \""+benchmarkautoinbackgroundmode.0+"\""
			notesel benchmarkautomes
			noteadd addtxt,-1
			notesel benchmarkautobuf
			noteadd "backgroundmode",-1
		}
	}

	notesel benchmarkautobuf
	if notemax=0:{
		dialog langstr(5605115),0,langstr(560511)
		stop
	}

	dialog langstr(5605112)+"\n\n"+benchmarkautomes,2,langstr(560511)
	if stat!6:{
		stop
	}

	notesel benchmarkautobuf
	repeat notemax
		notesel benchmarkautobuf
		noteget buf,cnt

		if int(loadset("lastbenchmarkscore",settingdata))>=10000:{
			if int(loadset("lastbenchmarkscore",settingdata))>=12500:{
				if buf="useanimation":{
					saveset "useanimation",settingdata,"1"
				}else:if buf="backgroundmode":{
					saveset "backgroundmode",settingdata,"SLIDESHOW"
				}
			}else{
				if buf="useanimation":{
					saveset "useanimation",settingdata,"1"
				}else:if buf="backgroundmode":{
					saveset "backgroundmode",settingdata,"IMAGE"
				}
			}
		}else{
			if buf="useanimation":{
				saveset "useanimation",settingdata,"0"
			}else:if buf="backgroundmode":{
				saveset "backgroundmode",settingdata,"COLOR"
			}
		}
	loop

	gsel 201,-1
	gsel 0000,int(loadset("ALWAYSFRONT",settingdata))+1

	bufferallupdatestartupbuf=1
	gosub *makescreen
	bufferallupdatestartupbuf=0

	gsel 201,2

	dialog langstr(5605116),0,langstr(560511)

	goto *benchmarkstart
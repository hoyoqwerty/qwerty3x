//////////////////////////////////////////////////////////////////////
//便利機能
//////////////////////////////////////////////////////////////////////

*launchertakeoverstart
	gsel 0000
	bufx=ginfo(12)
	bufy=ginfo(13)
	redraw 0
	onkey 0
	onclick 0
	beforex=ginfo(4)
	beforey=ginfo(5)
	enablewindow hclient,0
	screen 201,xsiz(640),ysiz(450),4+8
	gsel 201,2
	GetWindowLong hwnd, -16
	SetWindowLong hwnd, -16, stat - $80000
	width xsiz(640),ysiz(450),beforex,beforey
	boxfofmes int(loadset("dispcolormode",settingdata)),xsiz(0),ysiz(0),xsiz(640),ysiz(450)
	font fontstr,fontsize,0
	objmode 2,1
	redraw 1

	defaultpathlist={"C:\\qwerty-XX
	"}+dir_mydoc+{"\\qwerty-XX
	"}+dir_desktop+{"\\qwerty-XX"}

	title ""+langstr(56057)+""

	pos xsiz(10),ysiz(10)
	boxfofmes onezero(loadset("dispcolormode",settingdata)),xsiz(10),ysiz(10),xsiz(630),ysiz(10)+fontysizedata.3
	pos xsiz(12),ysiz(10)
	mes ""+langstr(560561)

	errorbuf=1
	notesel defaultpathlist
	repeat notemax
		notesel defaultpathlist
		noteget defaultpathlistbuf,cnt

		dirlist dummy,defaultpathlistbuf,5
		if stat!0:{
			dirlist dummy,defaultpathlistbuf+"\\data",5
			if stat!0:{
				dialog ""+defaultpathlistbuf+"\n\n"+langstr(560572),2,langstr(56057)
				if stat=6:{
					errorbuf=0
					qwertyxxcur=defaultpathlistbuf
					break
				}
			}
		}
		wait 10
	loop
	if errorbuf=1:{
		repeat
			dialog langstr(560562),3,langstr(56057)
			if stat!6:{
				gsel 201,-1
				gsel 0000,int(loadset("ALWAYSFRONT",settingdata))+1
				
				enablewindow hclient,1
				
				goto *systemrepeat
			}
	
			testqwertyxxcur=folderdialog(langstr(560563))
			dirlist dummy,testqwertyxxcur+"\\data",5
			if stat=0:{
				dirlist dummy,testqwertyxxcur+"\\qwerty-XX\\data",5
				if stat=0:{
					continue
				}else{
					dialog ""+testqwertyxxcur+"\\qwerty-XX\n\n"+langstr(560572),2,langstr(56057)

*controlmakelist	
;WINDOWSCREEN===ウィンドウ&画面設定
;BACKGROUNDCOLOR===背景&色設定
;APPACT===動作設定
;PASSWORD===パスワード設定
;APPINFO===qwerty3xの詳細
;APPUPDATE===qwerty3x update

	objimage -1

	font fontstr,fontsize-2,0
	objmode 2,1

	nowcontrollistposY=ysiz(10)
	pos xsiz(2),nowcontrollistposY
	boxfofmes onezero(loadset("DISPCOLORMODE",settingdata)),xsiz(0),nowcontrollistposY,xsiz(0)+fontxsizedata.3+xsiz(10),nowcontrollistposY+fontysizedata.3
	pos xsiz(2),nowcontrollistposY
	mes langstr(5100);・qwerty3xの設定リスト

	objsize xsiz(170),ysiz(30)
	nowcontrollistposY+=ysiz(40)	
	bufferbuttonY=ysiz(0)
	pos xsiz(1),nowcontrollistposY
	button gosub langstr(5001),*controlchangelist
	controllistadr.0=stat;ウィンドウ画面設定

	nowcontrollistposY+=ysiz(30)
	bufferbuttonY+=ysiz(30)
	pos xsiz(1),nowcontrollistposY
	button gosub langstr(5002),*controlchangelist
	controllistadr.1=stat;背景色設定

	nowcontrollistposY+=ysiz(30)
	bufferbuttonY+=ysiz(30)
	pos xsiz(1),nowcontrollistposY
	button gosub langstr(5003),*controlchangelist
	controllistadr.2=stat;動作設定

	nowcontrollistposY+=ysiz(30)
	bufferbuttonY+=ysiz(30)
	pos xsiz(1),nowcontrollistposY
	button gosub langstr(5006),*controlchangelist
	controllistadr.3=stat;パスワード設定

	nowcontrollistposY+=ysiz(30)
	bufferbuttonY+=ysiz(30)
	pos xsiz(1),nowcontrollistposY
	button gosub langstr(5004),*controlchangelist
	controllistadr.4=stat;qwerty3xの詳細

	nowcontrollistposY+=ysiz(30)
	bufferbuttonY+=ysiz(30)
	pos xsiz(1),nowcontrollistposY
	button gosub langstr(5005),*controlchangelist
	controllistadr.5=stat;qwerty3x update

	if loadset("controlpage",settingdata)="WINDOWSCREEN":{;ウィンドウ画面設定
		objprm controllistadr.0,">"+langstr(5001)+""
		sendmsg objinfo(controllistadr.0,2),$F4,$1
	}else:if loadset("controlpage",settingdata)="BACKGROUNDCOLOR":{;背景色設定
		objprm controllistadr.1,">"+langstr(5002)+""
		sendmsg objinfo(controllistadr.1,2),$F4,$1
	}else:if loadset("controlpage",settingdata)="APPACT":{;動作設定
		objprm controllistadr.2,">"+langstr(5003)+""
		sendmsg objinfo(controllistadr.2,2),$F4,$1
	}else:if loadset("controlpage",settingdata)="PASSWORD":{;パスワード設定
		objprm controllistadr.3,">"+langstr(5006)+""
		sendmsg objinfo(controllistadr.3,2),$F4,$1
	}else:if loadset("controlpage",settingdata)="APPINFO":{;qwerty3xの詳細
		objprm controllistadr.4,">"+langstr(5004)+""
		sendmsg objinfo(controllistadr.4,2),$F4,$1
	}else:if loadset("controlpage",settingdata)="APPUPDATE":{;qwerty3x update
		objprm controllistadr.5,">"+langstr(5005)+""
		sendmsg objinfo(controllistadr.5,2),$F4,$1
	}

	foreach controllistadr
		getwindowlong objinfo(controllistadr.cnt,2),-16
		setwindowlong objinfo(controllistadr.cnt,2),-16,stat|$100
	loop

	return

*controlchangelist
	statbuf=stat
	if controllistadr.0=statbuf:{
		saveset "controlpage",settingdata,"WINDOWSCREEN"
	}else:if controllistadr.1=statbuf:{
		saveset "controlpage",settingdata,"BACKGROUNDCOLOR"
	}else:if controllistadr.2=statbuf:{
		saveset "controlpage",settingdata,"APPACT"
	}else:if controllistadr.3=statbuf:{
		saveset "controlpage",settingdata,"PASSWORD"
	}else:if controllistadr.4=statbuf:{
		saveset "controlpage",settingdata,"APPINFO"
	}else:if controllistadr.5=statbuf:{
		saveset "controlpage",settingdata,"APPUPDATE"
	}

	gosub *makescreen

	return

*controlmakescreen;最初からgsel 0002,0されてる前提
	width clientwindowx-xsiz(180),clientwindowy-ysiz(30),xsiz(180),ysiz(30)
	clrobj
	color 0,0,0
	boxf 
	font fontstr,fontsize,0
	objmode 2,1

	if loadset("backgroundmode",settingdata)="COLOR":{
		backgroundcolorrgbdata=loadset("backgroundcolor",settingdata)
		split backgroundcolorrgbdata,",",backgroundcolorrdata,backgroundcolorgdata,backgroundcolorbdata
		color int(backgroundcolorrdata),int(backgroundcolorgdata),int(backgroundcolorbdata)
		boxf xsiz(0),ysiz(0),ginfo(12),ginfo(13)
	}else:if loadset("backgroundmode",settingdata)="IMAGE":{
		gsel 1007,0
		backpicx=ginfo(12)
		backpicy=ginfo(13)
		gsel 0002,0
		if ((backpicy*ginfo(12))/backpicx)<=ginfo(13):{
			posbuf3=(backpicy*ginfo(12))/backpicx
			posbuf4=(ginfo(13)-posbuf3)/2
			pos xsiz(0),ysiz(0)+posbuf4
			gzoom ginfo(12),posbuf3,1007,0,0,backpicx,backpicy,1
		}else{
			posbuf3=(backpicx*ginfo(13))/backpicy
			posbuf4=(ginfo(12)-posbuf3)/2
			pos xsiz(0)+posbuf4,ysiz(0)
			gzoom posbuf3,ginfo(13),1007,0,0,backpicx,backpicy,1
		}
	}else:if loadset("backgroundmode",settingdata)="SLIDESHOW":{
		gsel 1007,0
		backpicx=ginfo(12)
		backpicy=ginfo(13)
		gsel 0002,0
		if ((backpicy*ginfo(12))/backpicx)<=ginfo(13):{
			posbuf3=(backpicy*ginfo(12))/backpicx
			posbuf4=(ginfo(13)-posbuf3)/2
			pos xsiz(0),ysiz(0)+posbuf4
			gzoom ginfo(12),posbuf3,1007,0,0,backpicx,backpicy,1
		}else{
			posbuf3=(backpicx*ginfo(13))/backpicy
			posbuf4=(ginfo(12)-posbuf3)/2
			pos xsiz(0)+posbuf4,ysiz(0)
			gzoom posbuf3,ginfo(13),1007,0,0,backpicx,backpicy,1
		}
	}

	nowcontrolscreenposY=0
	if loadset("CONTROLPAGE",settingdata)="WINDOWSCREEN":{;ウィンドウ&画面設定
		nowcontrolscreenposY+=ysiz(10)
		pos xsiz(10),nowcontrolscreenposY
		boxfofmes onezero(loadset("DISPCOLORMODE",settingdata)),xsiz(10),nowcontrolscreenposY,ginfo(12)-xsiz(30),nowcontrolscreenposY+fontysizedata.3
		pos xsiz(12),nowcontrolscreenposY
		mes langstr(52011);ウィンドウ動作
		
		nowcontrolscreenposY+=ysiz(25)
		pos xsiz(10),nowcontrolscreenposY
		objsize ginfo(12)-xsiz(40),ysiz(30)
		controlalwaysfront=int(loadset("alwaysfront",settingdata))
		chkbox langstr(5201),controlalwaysfront
		controlalwaysfrontadr=stat;常に最前面に表示する

		nowcontrolscreenposY+=ysiz(40)
		pos xsiz(10),nowcontrolscreenposY
		controlautomini=int(loadset("automini",settingdata))
		chkbox langstr(5202),controlautomini
		controlautominiadr=stat;ランチャーや外部ウィンドウを開く操作をした時、自動でqwerty3xが最小化されるようにする

		nowcontrolscreenposY+=ysiz(40)
		pos xsiz(10),nowcontrolscreenposY
		controluseanimation=int(loadset("useanimation",settingdata))
		chkbox langstr(5206),controluseanimation
		controluseanimationadr=stat;表示アニメーションを使用する

		nowcontrolscreenposY+=ysiz(40)
		pos xsiz(10),nowcontrolscreenposY
		boxfofmes onezero(loadset("DISPCOLORMODE",settingdata)),xsiz(10),nowcontrolscreenposY,ginfo(12)-xsiz(30),nowcontrolscreenposY+fontysizedata.3
		pos xsiz(12),nowcontrolscreenposY
		mes langstr(5203);フォント設定

		nowcontrolscreenposY+=ysiz(25)
		pos xsiz(10),nowcontrolscreenposY
		if loadset("fontname",settingdata)="AUTO":{
			controlfontname=0
		}else:if loadset("fontname",settingdata)="Yu Gothic UI":{
			controlfontname=1
		}else:if loadset("fontname",settingdata)="Meiryo UI":{
			controlfontname=2
		}else:if loadset("fontname",settingdata)="MS UI Gothic":{
			controlfontname=3
		}
		combox controlfontname,ysiz(100),""+langstr(52031)+"\n"+langstr(52032)+"\n"+langstr(52033)+"\n"+langstr(52034)
		controlfontnameadr=stat

		nowcontrolscreenposY+=ysiz(40)
		pos xsiz(10),nowcontrolscreenposY
		boxfofmes onezero(loadset("DISPCOLORMODE",settingdata)),xsiz(10),nowcontrolscreenposY,ginfo(12)-xsiz(30),nowcontrolscreenposY+fontysizedata.3
		pos xsiz(12),nowcontrolscreenposY
		mes langstr(5204);画面モード

		nowcontrolscreenposY+=ysiz(25)
		pos xsiz(10),nowcontrolscreenposY
		controldispcolormode=int(loadset("dispcolormode",settingdata))
		combox controldispcolormode,ysiz(100),""+langstr(52041)+"\n"+langstr(52042)
		controldispcolormodeadr=stat

		nowcontrolscreenposY+=ysiz(40)
		pos xsiz(10),nowcontrolscreenposY
		boxfofmes onezero(loadset("DISPCOLORMODE",settingdata)),xsiz(10),nowcontrolscreenposY,ginfo(12)-xsiz(30),nowcontrolscreenposY+fontysizedata.3
		pos xsiz(12),nowcontrolscreenposY
		mes langstr(5205);言語設定

		nowcontrolscreenposY+=ysiz(25)
		pos xsiz(10),nowcontrolscreenposY
		chdir languagefile
		languagedatalist="";dirlistで取得先に指定する変数
		languagedatacomlist="";comboxで実際に表示する変数(languagedata)
		languagedatacomset="";設定に使用する変数(languagesetting)
		languagedatacomtest="";読み込む変数
		dirlist languagedatalist,"*.q3lf",1
		notesel languagedatalist
		repeat notemax
			notesel languagedatalist
			noteget buf,cnt
			notesel languagedatacomtest
			noteload languagefile+"\\"+buf

			if loadset("languagesetting",languagedatacomtest)=loadset("language",settingdata):{
				controllanguage=cnt
			};現在の設定を判定

			notesel languagedatacomlist
			noteadd loadset("languagedata",languagedatacomtest),-1,0

			notesel languagedatacomset
			noteadd loadset("languagesetting",languagedatacomtest),-1,0
		loop
		combox controllanguage,ysiz(100),languagedatacomlist
		controllanguageadr=stat
		
		controlalwaysfrontbuf=controlalwaysfront
		controlfontnamebuf=controlfontname
		controldispcolormodebuf=controldispcolormode
		controllanguagebuf=controllanguage
	}else:if loadset("CONTROLPAGE",settingdata)="BACKGROUNDCOLOR":{;背景&色設定
		nowcontrolscreenposY+=ysiz(10)
		pos xsiz(10),nowcontrolscreenposY
		boxfofmes onezero(loadset("DISPCOLORMODE",settingdata)),xsiz(10),nowcontrolscreenposY,ginfo(12)-xsiz(30),nowcontrolscreenposY+fontysizedata.3
		pos xsiz(12),nowcontrolscreenposY
		mes langstr(5301);qwerty3x スタイルカラー

		nowcontrolscreenposY+=ysiz(25)
		boxfofmes onezero(loadset("DISPCOLORMODE",settingdata)),xsiz(10),nowcontrolscreenposY,ginfo(12)-xsiz(30),nowcontrolscreenposY+ysiz(50)
		pos xsiz(20),nowcontrolscreenposY+ysiz(30)
		systemrgbdata=loadset("systemrgb",settingdata)
		split systemrgbdata,",",systemrdata,systemgdata,systembdata
		mes "R: "+strf("%03d",systemrdata)+"  G: "+strf("%03d",systemgdata)+"  B: "+strf("%03d",systembdata)
		colorsetting settingdata
		boxf xsiz(20),nowcontrolscreenposY+ysiz(5),xsiz(20)+ginfo(14),nowcontrolscreenposY+ysiz(25)
		pos ginfo(12)-xsiz(140),nowcontrolscreenposY+ysiz(10)
		objsize xsiz(100),ysiz(30)
		button gosub langstr(53011),*controlchangesystemrgb
		controlsystemrgbadr=stat

		nowcontrolscreenposY+=ysiz(60)
		pos xsiz(10),nowcontrolscreenposY
		boxfofmes onezero(loadset("DISPCOLORMODE",settingdata)),xsiz(10),nowcontrolscreenposY,ginfo(12)-xsiz(30),nowcontrolscreenposY+fontysizedata.3
		pos xsiz(12),nowcontrolscreenposY
		mes langstr(5302);背景

		nowcontrolscreenposY+=ysiz(25)
		if loadset("backgroundmode",settingdata)="COLOR":{
			controlbackgroundmode=0
		}else:if loadset("backgroundmode",settingdata)="IMAGE":{
			controlbackgroundmode=1
		}else:if loadset("backgroundmode",settingdata)="SLIDESHOW":{
			controlbackgroundmode=2
		}
		pos xsiz(10),nowcontrolscreenposY
		objsize ginfo(12)-xsiz(40),ysiz(30)
		combox controlbackgroundmode,ysiz(100),""+langstr(53021)+langstr(53022)+"\n"+langstr(53021)+langstr(53023)+"\n"+langstr(53021)+langstr(53024)
		controlbackgroundmodeadr=stat
		
		nowcontrolscreenposY+=ysiz(40)
		pos xsiz(10),nowcontrolscreenposY
		;枠   xsiz(280),ysiz(280)
		;内容 xsiz(270),ysiz(270) 枠の幅5px
		boxfofmes onezero(loadset("DISPCOLORMODE",settingdata)),xsiz(10),nowcontrolscreenposY,xsiz(290),nowcontrolscreenposY+ysiz(280)
		if loadset("backgroundmode",settingdata)="COLOR":{
			backgroundcolorrgbdata=loadset("backgroundcolor",settingdata)
			split backgroundcolorrgbdata,",",backgroundcolorrdata,backgroundcolorgdata,backgroundcolorbdata
			color int(backgroundcolorrdata),int(backgroundcolorgdata),int(backgroundcolorbdata)
			if ((ginfo(13)*xsiz(270))/ginfo(12))<=ysiz(270):{
				posbuf=(ginfo(13)*xsiz(270))/ginfo(12)
				posbuf2=(ysiz(270)-posbuf)/2
				pos xsiz(15),nowcontrolscreenposY+ysiz(5)+posbuf2
				boxf xsiz(15),nowcontrolscreenposY+ysiz(5)+posbuf2,xsiz(285),nowcontrolscreenposY+ysiz(5)+posbuf2+posbuf
			}else{
				posbuf=(ginfo(12)*ysiz(270))/ginfo(13)
				posbuf2=(xsiz(270)-posbuf)/2
				pos xsiz(15)+posbuf2,nowcontrolscreenposY+ysiz(5)
				boxf xsiz(15)+posbuf2,nowcontrolscreenposY+ysiz(5),xsiz(15)+posbuf2+posbuf,nowcontrolscreenposY+ysiz(275)
			}

			nowcontrolscreenposY+=ysiz(300)
			boxfofmes onezero(loadset("DISPCOLORMODE",settingdata)),xsiz(10),nowcontrolscreenposY,ginfo(12)-xsiz(30),nowcontrolscreenposY+ysiz(50)
			pos xsiz(20),nowcontrolscreenposY+ysiz(30)
			mes "R: "+strf("%03d",backgroundcolorrdata)+"  G: "+strf("%03d",backgroundcolorgdata)+"  B: "+strf("%03d",backgroundcolorbdata)
			color int(backgroundcolorrdata),int(backgroundcolorgdata),int(backgroundcolorbdata)
			boxf xsiz(20),nowcontrolscreenposY+ysiz(5),xsiz(20)+ginfo(14),nowcontrolscreenposY+ysiz(25)
			pos ginfo(12)-xsiz(140),nowcontrolscreenposY+ysiz(10)
			objsize xsiz(100),ysiz(30)
			button gosub langstr(53025),*controlchangebackgroundcolor
			controlchangebackgroundcoloradr=stat
		}else:if loadset("backgroundmode",settingdata)="IMAGE":{
			gsel 1007,0
			backpicx=ginfo(12)
			backpicy=ginfo(13)
			gsel 0002,0
			if ((ginfo(13)*xsiz(270))/ginfo(12))<=ysiz(270):{
				posbuf=(ginfo(13)*xsiz(270))/ginfo(12)
				posbuf2=(ysiz(270)-posbuf)/2
				pos xsiz(15),nowcontrolscreenposY+ysiz(5)+posbuf2
				boxf xsiz(15),nowcontrolscreenposY+ysiz(5)+posbuf2,xsiz(285),nowcontrolscreenposY+ysiz(5)+posbuf2+posbuf
				sizebufx=xsiz(270)
				sizebufy=posbuf
			}else{
				posbuf=(ginfo(12)*ysiz(270))/ginfo(13)
				posbuf2=(xsiz(270)-posbuf)/2
				pos xsiz(15)+posbuf2,nowcontrolscreenposY+ysiz(5)
				boxf xsiz(15)+posbuf2,nowcontrolscreenposY+ysiz(5),xsiz(15)+posbuf2+posbuf,nowcontrolscreenposY+ysiz(275)
				sizebufx=posbuf
				sizebufy=ysiz(270)
			}
			if ((backpicy*sizebufx)/backpicx)<=sizebufy:{
				posbuf3=(backpicy*sizebufx)/backpicx
				posbuf4=(sizebufy-posbuf3)/2
				if ((ginfo(13)*xsiz(270))/ginfo(12))<=ysiz(270):{
					posbuf5=(ysiz(270)-posbuf3)/2
					pos xsiz(15),nowcontrolscreenposY+posbuf5
				}else{
					pos xsiz(15)+posbuf2,nowcontrolscreenposY+ysiz(5)+posbuf4
				}
				gzoom sizebufx,posbuf3,1007,0,0,backpicx,backpicy,1
			}else{
				posbuf3=(backpicx*sizebufy)/backpicy
				posbuf4=(sizebufx-posbuf3)/2
				if ((ginfo(13)*xsiz(270))/ginfo(12))>ysiz(270):{
					posbuf5=(xsiz(270)-posbuf3)/2
					pos xsiz(15)+posbuf5,nowcontrolscreenposY+ysiz(5)
				}else{
					pos xsiz(15)+posbuf4,nowcontrolscreenposY+ysiz(5)+posbuf2
				}
				gzoom posbuf3,sizebufy,1007,0,0,backpicx,backpicy,1
			}

			nowcontrolscreenposY+=ysiz(300)
			pos xsiz(10),nowcontrolscreenposY
			objsize ginfo(12)-xsiz(140),ysiz(30)
			controlbackgroundfile=loadset("backgroundfile",settingdata)
			input controlbackgroundfile,ginfo(12)-xsiz(140),ysiz(30),0
			controlbackgroundfileadr=stat
			pos ginfo(12)-xsiz(130),nowcontrolscreenposY
			objsize xsiz(100),ysiz(30)
			button gosub langstr(53026),*controldialogbackgroundfile;参照
			controldialogbackgroundfileadr=stat

			nowcontrolscreenposY+=ysiz(30)
			pos xsiz(10),nowcontrolscreenposY
			objsize xsiz(200),ysiz(30)
			button gosub langstr(53027),*controlrunbackgroundfile;別アプリで開く
			controlrunbackgroundfileadr=stat

			nowcontrolscreenposY+=ysiz(30)
			pos xsiz(10),nowcontrolscreenposY
			objsize xsiz(200),ysiz(30)
			button gosub langstr(53028),*controlapplybackgroundfile
			controlapplybackgroundfileadr=stat
		}else:if loadset("backgroundmode",settingdata)="SLIDESHOW":{
			gsel 1007,0
			backpicx=ginfo(12)
			backpicy=ginfo(13)
			gsel 0002,0
			if ((ginfo(13)*xsiz(270))/ginfo(12))<=ysiz(270):{
				posbuf=(ginfo(13)*xsiz(270))/ginfo(12)
				posbuf2=(ysiz(270)-posbuf)/2
				pos xsiz(15),nowcontrolscreenposY+ysiz(5)+posbuf2
				boxf xsiz(15),nowcontrolscreenposY+ysiz(5)+posbuf2,xsiz(285),nowcontrolscreenposY+ysiz(5)+posbuf2+posbuf
				sizebufx=xsiz(270)
				sizebufy=posbuf
			}else{
				posbuf=(ginfo(12)*ysiz(270))/ginfo(13)
				posbuf2=(xsiz(270)-posbuf)/2
				pos xsiz(15)+posbuf2,nowcontrolscreenposY+ysiz(5)
				boxf xsiz(15)+posbuf2,nowcontrolscreenposY+ysiz(5),xsiz(15)+posbuf2+posbuf,nowcontrolscreenposY+ysiz(275)
				sizebufx=posbuf
				sizebufy=ysiz(270)
			}
			if ((backpicy*sizebufx)/backpicx)<=sizebufy:{
				posbuf3=(backpicy*sizebufx)/backpicx
				posbuf4=(sizebufy-posbuf3)/2
				if ((ginfo(13)*xsiz(270))/ginfo(12))<=ysiz(270):{
					posbuf5=(ysiz(270)-posbuf3)/2
					pos xsiz(15),nowcontrolscreenposY+posbuf5
				}else{
					pos xsiz(15)+posbuf2,nowcontrolscreenposY+ysiz(5)+posbuf4
				}
				gzoom sizebufx,posbuf3,1007,0,0,backpicx,backpicy,1
			}else{
				posbuf3=(backpicx*sizebufy)/backpicy
				posbuf4=(sizebufx-posbuf3)/2
				if ((ginfo(13)*xsiz(270))/ginfo(12))>ysiz(270):{
					posbuf5=(xsiz(270)-posbuf3)/2
					pos xsiz(15)+posbuf5,nowcontrolscreenposY+ysiz(5)
				}else{
					pos xsiz(15)+posbuf4,nowcontrolscreenposY+ysiz(5)+posbuf2
				}
				gzoom posbuf3,sizebufy,1007,0,0,backpicx,backpicy,1
			}

			nowcontrolscreenposY+=ysiz(300)
			pos xsiz(10),nowcontrolscreenposY
			objsize ginfo(12)-xsiz(140),ysiz(30)
			controlbackgroundfolder=loadset("backgroundfolder",settingdata)
			input controlbackgroundfolder,ginfo(12)-xsiz(140),ysiz(30),0
			controlbackgroundfolderadr=stat
			pos ginfo(12)-xsiz(130),nowcontrolscreenposY
			objsize xsiz(100),ysiz(30)
			button gosub langstr(53026),*controldialogbackgroundfolder;参照
			controldialogbackgroundfolderadr=stat

			nowcontrolscreenposY+=ysiz(30)
			pos xsiz(10),nowcontrolscreenposY
			objsize xsiz(200),ysiz(30)
			button gosub langstr(53029),*controlrunbackgroundfolder;エクスプローラーで開く
			controlrunbackgroundfolderadr=stat

			nowcontrolscreenposY+=ysiz(30)
			pos xsiz(10),nowcontrolscreenposY
			objsize xsiz(200),ysiz(30)
			button gosub langstr(53030),*controlapplybackgroundfolder;適用/今すぐ画像を切り替える
			controlapplybackgroundfolderadr=stat

			nowcontrolscreenposY+=ysiz(40)
			pos xsiz(10),nowcontrolscreenposY
			objsize ginfo(12)-xsiz(40),ysiz(30)
			controlbackgroundrandom=int(loadset("backgroundrandom",settingdata))
			chkbox langstr(53032),controlbackgroundrandom
			controlbackgroundrandomadr=stat
		}

		controlbackgroundmodebuf=controlbackgroundmode
	}else:if loadset("CONTROLPAGE",settingdata)="APPACT":{;動作設定
		nowcontrolscreenposY+=ysiz(10)
		pos xsiz(10),nowcontrolscreenposY
		boxfofmes onezero(loadset("dispcolormode",settingdata)),xsiz(10),nowcontrolscreenposY,ginfo(12)-xsiz(30),nowcontrolscreenposY+fontysizedata.3
		pos xsiz(12),nowcontrolscreenposY
		mes langstr(54011);起動時の動作

		nowcontrolscreenposY+=ysiz(25)
		pos xsiz(10),nowcontrolscreenposY
		objsize ginfo(12)-xsiz(40),ysiz(30)
		controlstartupdate=int(loadset("startupdate",settingdata))
		chkbox langstr(5401),controlstartupdate
		controlstartupdateadr=stat;qwerty3x起動時にアップデートの確認を行うようにする

		nowcontrolscreenposY+=ysiz(40)
		pos xsiz(10),nowcontrolscreenposY
		objsize ginfo(12)-xsiz(40),ysiz(30)
		controlwindowsversiondialog=int(loadset("windowsversiondialog",settingdata))
		chkbox langstr(5402),controlwindowsversiondialog
		controlwindowsversiondialogadr=stat;Windowsの未サポートバージョンを検出した時、ダイアログで通知する
	}else:if loadset("CONTROLPAGE",settingdata)="PASSWORD":{;パスワード設定
		nowcontrolscreenposY+=ysiz(10)
		pos xsiz(10),nowcontrolscreenposY
		boxfofmes onezero(loadset("dispcolormode",settingdata)),xsiz(10),nowcontrolscreenposY,ginfo(12)-xsiz(30),nowcontrolscreenposY+fontysizedata.3
		pos xsiz(12),nowcontrolscreenposY
		mes langstr(55011);パスワード

		if loadset("passwordstring",settingdata)="":{;パスワードが設定されていないとき
			nowcontrolscreenposY+=ysiz(25)
			pos xsiz(10),nowcontrolscreenposY
			objsize xsiz(200),ysiz(30)
			button goto langstr(5501),*createpassword
			createpasswordadr=stat
		}else{;パスワードが設定されているとき
			nowcontrolscreenposY+=ysiz(25)
			pos xsiz(10),nowcontrolscreenposY
			objsize xsiz(200),ysiz(30)
			button goto langstr(5502),*changepassword
			changepasswordadr=stat

			nowcontrolscreenposY+=ysiz(40)
			pos xsiz(10),nowcontrolscreenposY
			button goto langstr(5503),*deletepassword
			deletepasswordadr=stat
		}
	}else:if loadset("CONTROLPAGE",settingdata)="APPINFO":{;qwerty3xの詳細
		chdir qwertycur
		exist "Release Note.txt"
		if strsize=-1:{
			releasenote=langstr(5604)
		}else{
			notesel releasenote
			noteload "Release Note.txt"
		}
		
		nowcontrolscreenposY+=ysiz(10)
		pos xsiz(10),nowcontrolscreenposY
		boxfofmes onezero(loadset("dispcolormode",settingdata)),xsiz(10),nowcontrolscreenposY,ginfo(12)-xsiz(30),nowcontrolscreenposY+fontysizedata.1
		font fontstr,fontsize+ysiz(7),1+2;15px+7px=22px
		objmode 2,1
		pos xsiz(12),nowcontrolscreenposY
		mes langstr(0001)
		font fontstr,fontsize,0;15px+7px=22px
		objmode 2,1

		nowcontrolscreenposY+=ysiz(40)
		pos xsiz(10),nowcontrolscreenposY
		boxfofmes onezero(loadset("dispcolormode",settingdata)),xsiz(10),nowcontrolscreenposY,ginfo(12)-xsiz(30),nowcontrolscreenposY+fontysizedata.3
		pos xsiz(12),nowcontrolscreenposY
		mes ""+langstr(5601)+qwertydate

		nowcontrolscreenposY+=ysiz(25)
		pos xsiz(10),nowcontrolscreenposY
		boxfofmes onezero(loadset("dispcolormode",settingdata)),xsiz(10),nowcontrolscreenposY,ginfo(12)-xsiz(30),nowcontrolscreenposY+fontysizedata.3
		pos xsiz(12),nowcontrolscreenposY
		mes ""+langstr(5602)+__date__+" "+__time__

		nowcontrolscreenposY+=ysiz(25)
		pos xsiz(10),nowcontrolscreenposY
		boxfofmes onezero(loadset("dispcolormode",settingdata)),xsiz(10),nowcontrolscreenposY,ginfo(12)-xsiz(30),nowcontrolscreenposY+fontysizedata.3
		pos xsiz(12),nowcontrolscreenposY
		mes ""+langstr(5603)+qwertybuild

		nowcontrolscreenposY+=ysiz(25)
		pos xsiz(10),nowcontrolscreenposY
		objsize ginfo(12)-xsiz(40),ysiz(500)
		mesbox releasenote,ginfo(12)-xsiz(40),ysiz(500),0,0
		releasenoteadr=stat

		nowcontrolscreenposY+=ysiz(530)
		pos xsiz(10),nowcontrolscreenposY
		boxfofmes onezero(loadset("dispcolormode",settingdata)),xsiz(10),nowcontrolscreenposY,ginfo(12)-xsiz(30),nowcontrolscreenposY+(fontysizedata.3*4)
		pos xsiz(12),nowcontrolscreenposY
		mes "Copyright (C) 2024-2025 hoyoqwerty All Rights Reserved.\nqwerty3x is created in \"Hot Soup Processor.\"\n\n__hspver__ : "+strf("%4x",__hspver__)+""
	
		gsel 0,0
		bufferbuttonY=ysiz(0)
		bufferbuttonX=xsiz(160)
		pos bufferbuttonX,ysiz(1)
		objsize appbarxsiz.0+xsiz(10),ysiz(29)
		objimage 2002,xsiz(0),bufferbuttonY,xsiz(0),bufferbuttonY,xsiz(300),bufferbuttonY
		button gosub "",*settingutility
		settingutilityadr=stat

		gsel 0002,2
	}else:if loadset("CONTROLPAGE",settingdata)="APPUPDATE":{;qwerty3x update
		nowcontrolscreenposY+=ysiz(10)
		pos xsiz(10),nowcontrolscreenposY
		boxfofmes onezero(loadset("DISPCOLORMODE",settingdata)),xsiz(10),nowcontrolscreenposY,ginfo(12)-xsiz(30),nowcontrolscreenposY+fontysizedata.3
		pos xsiz(12),nowcontrolscreenposY
		mes langstr(5701)

		nowcontrolscreenposY+=ysiz(30)
		pos xsiz(10),nowcontrolscreenposY
		objsize ginfo(12)-xsiz(40),ysiz(80)
		if updatecheckmestimebuf=0:{
			button gosub ">>> "+langstr(5702)+" <<<\n"+langstr(5712)+" "+langstr(5715),*updatecheckstart
		}else{
			button gosub ">>> "+langstr(5702)+" <<<\n"+langstr(5712)+" "+updatecheckmestimebuf,*updatecheckstart
		}
		updatecheckstartadr=stat
		getwindowlong objinfo(updatecheckstartadr,2),-16
		setwindowlong objinfo(updatecheckstartadr,2),-16,stat|$2000

		if okfullmode=-1:{
			objprm updatecheckstartadr,langstr(5737)
			objenable updatecheckstartadr,0
		}

		nowcontrolscreenposY+=ysiz(90)
		pos xsiz(10),nowcontrolscreenposY
		boxfofmes onezero(loadset("DISPCOLORMODE",settingdata)),xsiz(10),nowcontrolscreenposY,ginfo(12)-xsiz(30),nowcontrolscreenposY+fontysizedata.3
		pos xsiz(12),nowcontrolscreenposY
		mes langstr(5705)

		nowcontrolscreenposY+=ysiz(30)
		pos xsiz(10),nowcontrolscreenposY
		objsize ginfo(12)-xsiz(40),ysiz(50)
		mesbox updatecheckmes,ginfo(12)-xsiz(40),ysiz(50),4+8,0
		updatecheckmesadr=stat
		if updatecheckmes!"":{
			size=ginfo(12)-xsiz(40),ysiz(350),xsiz(10),nowcontrolscreenposY
			resizeobj updatecheckmesadr,size,0
		}
		;中身がない時は縦50px、中身があるときは縦350px

		if updatecheckmes!"":{
			nowcontrolscreenposY+=ysiz(360)
		}else{
			nowcontrolscreenposY+=ysiz(60)
		}
		pos xsiz(10),nowcontrolscreenposY
		objsize (ginfo(12)-xsiz(40))/2,ysiz(30)
		button langstr(5703),*updatedoyes
		updatedoyesadr=stat
		if updatecheckmes="":{
			objenable updatedoyesadr,0
		}

		pos xsiz(10)+(ginfo(12)-xsiz(40))/2,nowcontrolscreenposY
		button langstr(5704),*updatedono
		updatedonoadr=stat
		if updatecheckmes="":{
			objenable updatedonoadr,0
		}

		nowcontrolscreenposY+=ysiz(70)
		pos xsiz(10),nowcontrolscreenposY
		boxfofmes onezero(loadset("DISPCOLORMODE",settingdata)),xsiz(10),nowcontrolscreenposY,ginfo(12)-xsiz(30),nowcontrolscreenposY+fontysizedata.3
		pos xsiz(12),nowcontrolscreenposY
		mes langstr(5750)

		nowcontrolscreenposY+=ysiz(25)
		pos xsiz(10),nowcontrolscreenposY
		objsize ginfo(12)-xsiz(40),ysiz(30)
		controlgetbetaupdate=int(loadset("getbetaupdate",settingdata))
		chkbox langstr(5751),controlgetbetaupdate
		controlgetbetaupdateadr=stat

		nowcontrolscreenposY+=ysiz(40)
		pos xsiz(10),nowcontrolscreenposY
		objsize ginfo(12)-xsiz(40),ysiz(30)
		controlstartupdate=int(loadset("startupdate",settingdata))
		chkbox langstr(5401),controlstartupdate
		controlstartupdateadr=stat;qwerty3x起動時にアップデートの確認を行うようにする

		nowcontrolscreenposY+=ysiz(70)
		pos xsiz(10),nowcontrolscreenposY
		boxfofmes onezero(loadset("DISPCOLORMODE",settingdata)),xsiz(10),nowcontrolscreenposY,ginfo(12)-xsiz(30),nowcontrolscreenposY+fontysizedata.3
		pos xsiz(12),nowcontrolscreenposY
		mes langstr(5770)

		nowcontrolscreenposY+=ysiz(25)
		pos xsiz(10),nowcontrolscreenposY
		objsize ginfo(12)-xsiz(40),ysiz(50)
		button langstr(5771),*versionchange
		versionchangeadr=stat

		controlgetbetaupdatebuf=controlgetbetaupdate
	}

	return

//////////////////////////////////////////////////////////////////////
//UI動作
//////////////////////////////////////////////////////////////////////

*versionchange
	gsel 0000
	redraw 0
	onkey 0
	onclick 0
	beforex=ginfo(4)
	beforey=ginfo(5)
	enablewindow hclient,0
	screen 201,xsiz(640),ysiz(450),4+8
	gsel 201,2
	GetWindowLong hwnd, -16
	SetWindowLong hwnd, -16, stat - $80000
	width xsiz(640),ysiz(450),beforex,beforey
	boxfofmes int(loadset("dispcolormode",settingdata)),xsiz(0),ysiz(0),xsiz(640),ysiz(450)
	font fontstr,fontsize,0
	objmode 2,1
	redraw 1

	title langstr(5773)

	netinit
	if stat!0:{
		dialog langstr(5774),1,langstr(5770)
		goto *versionchangeno
	}
	neturl "https://hoyoqwerty.github.io/qwerty3xupdate/updatechecker/"
	netrequest_get "changever.txt"
	dim res
	loadingcnt=0
	loadingtime=0
	loadingok=0
	repeat
		title langstr(5773)+" ("+(cnt+1)+"/200)"
		netexec res
		if res!0:{
			if res=1:{
				sdim buf,netgetv_size()
				netgetv_data buf
				loadingok=1
				break
			}else:if res<0:{
				neterror errorstr
				dialog langstr(5775)+"\n\n"+errorstr+"\n\n"+langstr(5709),1,langstr(5770)
				break
			}
		}

		await 10
		if cnt=200:{
			dialog langstr(5776),1,langstr(5770)
			break
		}
	loop
	if loadingok=0:{
		goto *versionchangeno
	}
	versionchangeliststr=""
	versionchangelist=buf
	notesel versionchangelist
	repeat notemax
		notesel versionchangelist
		noteget buf2,cnt

		title langstr(5779)+" ("+(cnt+1)+"/"+notemax+")"

		buf3=""
		buf4=""
		split buf2,"<develop>",buf3,buf4
		if buf3!"":{
			if buf4="beta":{
				if loadset("getbetaupdate",settingdata)="1":{
					notesel versionchangeliststr
					noteadd "ver."+buf3+" ("+langstr(5777)+")",-1
				}else{
					notesel versionchangelist
					notedel cnt
				}
			}else{
				notesel versionchangeliststr
				noteadd "ver."+buf3+"",-1
			}
		}
		wait 10
	loop

	title langstr(5770)

	pos xsiz(10),ysiz(10)
	boxfofmes onezero(loadset("dispcolormode",settingdata)),xsiz(10),ysiz(10),xsiz(630),ysiz(10)+(fontysizedata.3*1)
	pos xsiz(12),ysiz(10)
	mes ""+langstr(5770)

	pos xsiz(10),ysiz(50)
	boxfofmes onezero(loadset("dispcolormode",settingdata)),xsiz(10),ysiz(50),xsiz(630),ysiz(50)+(fontysizedata.3*1)
	pos xsiz(12),ysiz(50)
	mes ""+langstr(5778)

	pos xsiz(10),ysiz(80)
	objsize xsiz(620),ysiz(30)
	notesel versionchangeliststr
	versionchangeinfo=0
	combox versionchangeinfo,ysiz(100),versionchangeliststr
	versionchangeinfoadr=stat

	pos xsiz(10),ysiz(210)
	boxfofmes onezero(loadset("dispcolormode",settingdata)),xsiz(10),ysiz(210),xsiz(630),ysiz(210)+(fontysizedata.3*6)
	pos xsiz(12),ysiz(210)
	mes ""+langstr(5780)

	pos xsiz(320),ysiz(420)
	objsize xsiz(200),ysiz(30)
	button goto langstr(5781),*versionchangeyes

	pos xsiz(530),ysiz(420)
	objsize xsiz(100),ysiz(30)
	button goto langstr(5772),*versionchangeno

	stop

*versionchangeyes
	notesel versionchangelist
	noteget buf2,versionchangeinfo
	buf3=""
	buf4=""
	split buf2,"<develop>",buf3,buf4
	verbuf2=buf3
	gosub *langstrrepupdate
	
	dialog langstr(5782),3,langstr(5770)
	if stat!6:{
		stop
	}

	gsel 201,-1
	gsel 0000,int(loadset("ALWAYSFRONT",settingdata))+1
	enablewindow hclient,1

	gsel 2,0
	objprm updatecheckmesadr,""
	gsel 0,0
	title langstr(5735)

	netinit
	if stat!0:{
		dialog langstr(5731),1,langstr(5701)
		stop
	}
	neturl "https://hoyoqwerty.github.io/qwerty3xupdate/installerdatas/"
	netrequest_get "qwerty3x installer ver."+verbuf2+".exe"
	dim res
	loadingcnt=0
	loadingtime=0
	loadingok=0
	repeat
		netexec res
		if res!0:{
			if res=1:{
				sdim buf,netgetv_size()
				netgetv_data buf
				loadingok=1
				break
			}else:if res<0:{
				neterror errorstr
				dialog langstr(5732)+"\n\n"+errorstr+"\n\n"+langstr(5709),1,langstr(5701)
				break
			}
		}

		gsel 2,0
		objprm updatecheckmesadr,langstr(5735)+" ("+(cnt+1)+"/200)"
		gsel 0,0

		await 10
		if cnt=200:{
			dialog langstr(5710),1,langstr(5701)
			break
		}
	loop
	gsel 2,0
	objprm updatecheckmesadr,""
	gsel 0,0
	if loadingok=0:{
		goto *systemrepeat
	}

	gosub *langstrrepupdate
	
	chdir qwertycur
	bsave "qwerty3x installer ver."+verbuf2+".exe",buf

	dialog langstr(5734),0,langstr(5701)

	title langstr(5736)
	gsel 2,0
	objprm updatecheckmesadr,langstr(5736)
	gsel 0,0

	if instr(windowsver,0,"NT")!-1:{
		exec "cmd /c start \"\" \""+qwertycur+"\\qwerty3x installer ver."+verbuf2+".exe\" \"autoupdate\"",2
	}else{
		exec "command.com /c start \"\" \""+qwertycur+"\\qwerty3x installer ver."+verbuf2+".exe\" \"autoupdate\"",2
	}

	shutdownmode=0
	restartmode=0
	shutdowntorestartsign=0
	goto *systemshutdown

	stop

*versionchangeno
	gsel 201,-1
	gsel 0000,int(loadset("ALWAYSFRONT",settingdata))+1

	enablewindow hclient,1

	goto *systemrepeat

*updatedoyes
	if updatecheckresult=-1:{
		dialog langstr(5711),1,langstr(5701)
		goto *systemrepeat
	}
	if qwerty3xupdatemode=1:{;ベータ
		testbuf=testbetabuf
		verbuf=betaverbuf
		verbuf2=betaverbuf2
	}
	
	if testbuf<=qwertybuild:{
		dialog langstr(5716),1,langstr(5701)
		goto *systemrepeat
	}

	dialog langstr(5730),3,langstr(5701)
	if stat!6:{
		goto *systemrepeat
	}

	gsel 2,0
	objprm updatecheckmesadr,""
	gsel 0,0
	title langstr(5735)

	netinit
	if stat!0:{
		dialog langstr(5731),1,langstr(5701)
		goto *systemrepeat
	}
	neturl "https://hoyoqwerty.github.io/qwerty3xupdate/installerdatas/"
	netrequest_get "qwerty3x installer ver."+verbuf2+".exe"
	dim res
	loadingcnt=0
	loadingtime=0
	loadingok=0
	repeat
		netexec res
		if res!0:{
			if res=1:{
				sdim buf,netgetv_size()
				netgetv_data buf
				loadingok=1
				break
			}else:if res<0:{
				neterror errorstr
				dialog langstr(5732)+"\n\n"+errorstr+"\n\n"+langstr(5709),1,langstr(5701)
				break
			}
		}

		gsel 2,0
		objprm updatecheckmesadr,langstr(5735)+" ("+(cnt+1)+"/200)"
		gsel 0,0

		await 10
		if cnt=200:{
			dialog langstr(5710),1,langstr(5701)
			break
		}
	loop
	gsel 2,0
	objprm updatecheckmesadr,""
	gsel 0,0
	if loadingok=0:{
		goto *systemrepeat
	}

	gosub *langstrrepupdate
	
	chdir qwertycur
	bsave "qwerty3x installer ver."+verbuf2+".exe",buf

	dialog langstr(5734),0,langstr(5701)

	title langstr(5736)
	gsel 2,0
	objprm updatecheckmesadr,langstr(5736)
	gsel 0,0

	if instr(windowsver,0,"NT")!-1:{
		exec "cmd /c start \"\" \""+qwertycur+"\\qwerty3x installer ver."+verbuf2+".exe\" \"autoupdate\"",2
	}else{
		exec "command.com /c start \"\" \""+qwertycur+"\\qwerty3x installer ver."+verbuf2+".exe\" \"autoupdate\"",2
	}

	shutdownmode=0
	restartmode=0
	shutdowntorestartsign=0
	goto *systemshutdown

*updatedono
	gsel 2,0
	objprm updatecheckmesadr,""
	gsel 0,0
	gosub *controlui

	goto *systemrepeat

*updatecheckstart
	title langstr(5706)
	gsel 2,0
	oncmd 0
	onkey 0
	onclick 0
	objprm updatecheckstartadr,langstr(5706)
	objenable updatecheckstartadr,0

	objprm updatecheckmesadr,""
	updatecheckresult=0

	netinit
	if stat!0:{
		dialog langstr(5707),1,langstr(5701)

		oncmd 1
		onkey 1
		onclick 1
		if updatecheckmestimebuf=0:{
			objprm updatecheckstartadr,">>> "+langstr(5702)+" <<<\n"+langstr(5712)+" "+langstr(5715)
		}else{
			objprm updatecheckstartadr,">>> "+langstr(5702)+" <<<\n"+langstr(5712)+" "+updatecheckmestimebuf
		}
		objenable updatecheckstartadr,1
		gsel 0,0
		gosub *controlui
		return
	}
	neturl "https://hoyoqwerty.github.io/qwerty3xupdate/updatechecker/"
	netrequest_get "verinfo.txt"
	dim res
	loadingcnt=0
	loadingtime=0
	loadingok=0
	repeat
		gsel 0,0
		title langstr(5706)+" ("+(cnt+1)+"/200)"
		gsel 2,0
		netexec res
		if res!0:{
			if res=1:{
				sdim buf,netgetv_size()
				netgetv_data buf
				loadingok=1
				break
			}else:if res<0:{
				neterror errorstr
				dialog langstr(5708)+"\n\n"+errorstr+"\n\n"+langstr(5709),1,langstr(5701)
				break
			}
		}

		await 10
		if cnt=200:{
			dialog langstr(5710),1,langstr(5701)
			break
		}
	loop
	if loadingok=0:{
		oncmd 1
		onkey 1
		onclick 1
		if updatecheckmestimebuf=0:{
			objprm updatecheckstartadr,">>> "+langstr(5702)+" <<<\n"+langstr(5712)+" "+langstr(5715)
		}else{
			objprm updatecheckstartadr,">>> "+langstr(5702)+" <<<\n"+langstr(5712)+" "+updatecheckmestimebuf
		}
		objenable updatecheckstartadr,1
		gsel 0,0
		gosub *controlui
		return
	}
	notesel buf
	noteget verbuf,0
	noteget verbuf2,1
	noteget betaverbuf,2
	noteget betaverbuf2,3
	testbuf=int(verbuf)
	testbetabuf=int(betaverbuf)
	if testbuf=-1:{
		oncmd 1
		onkey 1
		onclick 1
		updatecheckmestimebuf=""+gettime(0)+"/"+strf("%02d",gettime(1))+"/"+strf("%02d",gettime(3))+" "+strf("%02d",gettime(4))+":"+strf("%02d",gettime(5))+":"+strf("%02d",gettime(6))
		if updatecheckmestimebuf=0:{
			objprm updatecheckstartadr,">>> "+langstr(5702)+" <<<\n"+langstr(5712)+" "+langstr(5715)
		}else{
			objprm updatecheckstartadr,">>> "+langstr(5702)+" <<<\n"+langstr(5712)+" "+updatecheckmestimebuf
		}
		objenable updatecheckstartadr,1
		objprm updatecheckmesadr,langstr(5711)
		updatecheckresult=-1
		gsel 0,0
		gosub *controlui
		return
	}
	
	if testbuf>qwertybuild:{
		qwerty3xupdatemode=0
		gsel 0,0;通常アップデート
		title langstr(57061)
		gsel 2,0
		netrequest_get "newvernote.txt"
		dim res
		loadingcnt=0
		loadingtime=0
		loadingok=0
		repeat
			gsel 0,0
			title langstr(57061)+" ("+(cnt+1)+"/200)"
			gsel 2,0
			netexec res
			if res!0:{
				if res=1:{
					sdim buf,netgetv_size()
					netgetv_data buf
					loadingok=1
					break
				}else:if res<0:{
					neterror errorstr
					dialog langstr(5708)+"\n\n"+errorstr+"\n\n"+langstr(5709),1,langstr(5701)
					break
				}
			}
	
			await 10
			if cnt=200:{
				dialog langstr(5710),1,langstr(5701)
				break
			}
		loop
		if loadingok=0:{
			oncmd 1
			onkey 1
			onclick 1
			if updatecheckmestimebuf=0:{
				objprm updatecheckstartadr,">>> "+langstr(5702)+" <<<\n"+langstr(5712)+" "+langstr(5715)
			}else{
				objprm updatecheckstartadr,">>> "+langstr(5702)+" <<<\n"+langstr(5712)+" "+updatecheckmestimebuf
			}
			objenable updatecheckstartadr,1
			gsel 0,0
			gosub *controlui
			return
		}
		newvernote=buf
		notesel newvernote
		chdir textcodefile
		exist "ansisave.txt"
		if strsize!-1:{
			delete "ansisave.txt"
		}
		notesave "utf8load.txt"
		exec "textcodechange.exe cutcmd-1"
		repeat
			exist "ansisave.txt"
			if strsize!-1:{
				notesel newvernote
				noteload "ansisave.txt"
				if newvernote!"":{
					break
				}
			}
			await 10
		loop
		updatecheckmestimebuf=""+gettime(0)+"/"+strf("%02d",gettime(1))+"/"+strf("%02d",gettime(3))+" "+strf("%02d",gettime(4))+":"+strf("%02d",gettime(5))+":"+strf("%02d",gettime(6))
		updatecheckmesscreen={""}+langstr(5713)+{"
		\nver."}+verbuf2+{"
		\n\n"}+langstr(5714)+{"
		\n"}+newvernote
		objprm updatecheckmesadr,updatecheckmesscreen
	}else{
		if loadset("getbetaupdate",settingdata)="1"&testbetabuf>qwertybuild:{
			qwerty3xupdatemode=1
			gsel 0,0;開発版アップデート
			title langstr(57062)
			gsel 2,0
			netrequest_get "betavernote.txt"
			dim res
			loadingcnt=0
			loadingtime=0
			loadingok=0
			repeat
				gsel 0,0
				title langstr(57062)+" ("+(cnt+1)+"/200)"
				gsel 2,0
				netexec res
				if res!0:{
					if res=1:{
						sdim buf,netgetv_size()
						netgetv_data buf
						loadingok=1
						break
					}else:if res<0:{
						neterror errorstr
						dialog langstr(5708)+"\n\n"+errorstr+"\n\n"+langstr(5709),1,langstr(5701)
						break
					}
				}
		
				await 10
				if cnt=200:{
					dialog langstr(5710),1,langstr(5701)
					break
				}
			loop
			if loadingok=0:{
				oncmd 1
				onkey 1
				onclick 1
				if updatecheckmestimebuf=0:{
					objprm updatecheckstartadr,">>> "+langstr(5702)+" <<<\n"+langstr(5712)+" "+langstr(5715)
				}else{
					objprm updatecheckstartadr,">>> "+langstr(5702)+" <<<\n"+langstr(5712)+" "+updatecheckmestimebuf
				}
				objenable updatecheckstartadr,1
				gsel 0,0
				gosub *controlui
				return
			}
			newvernote=buf
			notesel newvernote
			chdir textcodefile
			exist "ansisave.txt"
			if strsize!-1:{
				delete "ansisave.txt"
			}
			notesave "utf8load.txt"
			exec "textcodechange.exe cutcmd-1"
			repeat
				exist "ansisave.txt"
				if strsize!-1:{
					notesel newvernote
					noteload "ansisave.txt"
					if newvernote!"":{
						break
					}
				}
				await 10
			loop
			updatecheckmestimebuf=""+gettime(0)+"/"+strf("%02d",gettime(1))+"/"+strf("%02d",gettime(3))+" "+strf("%02d",gettime(4))+":"+strf("%02d",gettime(5))+":"+strf("%02d",gettime(6))
			updatecheckmesscreen={""}+langstr(57131)+{"
			\nver."}+betaverbuf2+{"
			\n\n"}+langstr(5714)+{"
			\n"}+newvernote
			objprm updatecheckmesadr,updatecheckmesscreen
		}else{
			updatecheckmestimebuf=""+gettime(0)+"/"+strf("%02d",gettime(1))+"/"+strf("%02d",gettime(3))+" "+strf("%02d",gettime(4))+":"+strf("%02d",gettime(5))+":"+strf("%02d",gettime(6))
			objprm updatecheckmesadr,langstr(5716)
		}
	}
	netterm

	oncmd 1
	onkey 1
	onclick 1
	if updatecheckmestimebuf=0:{
		objprm updatecheckstartadr,">>> "+langstr(5702)+" <<<\n"+langstr(5712)+" "+langstr(5715)
	}else{
		objprm updatecheckstartadr,">>> "+langstr(5702)+" <<<\n"+langstr(5712)+" "+updatecheckmestimebuf
	}
	objenable updatecheckstartadr,1
	gsel 0,0
	gosub *controlui
	return


*controlload
	gsel 0002
	mousewheelbuf=mousew
	mousewheelbuttonbuf=0
	movecontrolbuf=0
	if mousewheelbuf>0:{
		mousewheelbuttonbuf=1
		;groll xsiz(0),ginfo(9)-(ginfo(13)/15)
		;ScrollBar_SetPos scrollbar2adr,ginfo(9)
		movecontrolbuf=1
	}else:if mousewheelbuf<0:{
		if ginfo(9)<(nowcontrolscreenposY+ysiz(30)):{
			mousewheelbuttonbuf=2
			;groll xsiz(0),ginfo(9)+(ginfo(13)/15)
			;ScrollBar_SetPos scrollbar2adr,ginfo(9)
			movecontrolbuf=1
		}
	}
	if ScrollBar_GetPos(scrollbar2adr)!scrollbar2getposbuf:{
		mousewheelbuttonbuf=3
		scrollbar2getposbuf=ScrollBar_GetPos(scrollbar2adr)
		movecontrolbuf=1
	}
	if movecontrolbuf=1:{
		gosub *controlui
	}
	gsel 0000
	
	if loadset("CONTROLPAGE",settingdata)="WINDOWSCREEN":{;ウィンドウ&画面設定
		saveset "alwaysfront",settingdata,str(controlalwaysfront)
		if controlalwaysfrontbuf!controlalwaysfront:{
			controlalwaysfrontbuf=controlalwaysfront
			gsel 0,controlalwaysfront+1
		}
		
		saveset "automini",settingdata,str(controlautomini)

		saveset "useanimation",settingdata,str(controluseanimation)

		if controlfontname=0:{
			saveset "fontname",settingdata,"AUTO"
		}else:if controlfontname=1:{
			saveset "fontname",settingdata,"Yu Gothic UI"
		}else:if controlfontname=2:{
			saveset "fontname",settingdata,"Meiryo UI"
		}else:if controlfontname=3:{
			saveset "fontname",settingdata,"MS UI Gothic"
		}
		if controlfontnamebuf!controlfontname:{
			controlfontnamebuf=controlfontname
			bufferallupdatestartupbuf=1
			gosub *makescreen
			bufferallupdatestartupbuf=0
		}

		saveset "dispcolormode",settingdata,str(controldispcolormode)
		if controldispcolormodebuf!controldispcolormode:{
			controldispcolormodebuf=controldispcolormode
			bufferallupdatestartupbuf=1
			gosub *makescreen
			bufferallupdatestartupbuf=0
		}

		notesel languagedatacomset
		noteget buf,controllanguage
		saveset "language",settingdata,buf
		if controllanguagebuf!controllanguage:{
			controllanguagebuf=controllanguage
			gosub *langstrrepupdate
			screenname=langstr(3005)
			bufferallupdatestartupbuf=1
			gosub *makescreen
			bufferallupdatestartupbuf=0
		}
	}else:if loadset("CONTROLPAGE",settingdata)="BACKGROUNDCOLOR":{;背景&色設定
		if controlbackgroundmode=0:{
			saveset "backgroundmode",settingdata,"COLOR"
		}else:if controlbackgroundmode=1:{
			saveset "backgroundmode",settingdata,"IMAGE"
		}else:if controlbackgroundmode=2:{
			saveset "backgroundmode",settingdata,"SLIDESHOW"
		}
		if controlbackgroundmodebuf!controlbackgroundmode:{
			controlbackgroundmodebuf=conotrolbackground
			gosub *makescreen
		}

		if loadset("backgroundmode",settingdata)="COLOR":{
			
		}else:if loadset("backgroundmode",settingdata)="IMAGE":{
			saveset "backgroundfile",settingdata,controlbackgroundfile
		}else:if loadset("backgroundmode",settingdata)="SLIDESHOW":{
			saveset "backgroundfolder",settingdata,controlbackgroundfolder

			saveset "backgroundrandom",settingdata,str(controlbackgroundrandom)
		}
	}else:if loadset("CONTROLPAGE",settingdata)="APPACT":{;動作設定
		saveset "startupdate",settingdata,str(controlstartupdate)

		saveset "windowsversiondialog",settingdata,str(controlwindowsversiondialog)
	}else:if loadset("CONTROLPAGE",settingdata)="PASSWORD":{;パスワード設定

	}else:if loadset("CONTROLPAGE",settingdata)="APPINFO":{;qwerty3xの詳細

	}else:if loadset("CONTROLPAGE",settingdata)="APPUPDATE":{;qwerty3x update
		saveset "startupdate",settingdata,str(controlstartupdate)

		if controlgetbetaupdatebuf!controlgetbetaupdate:{
			if controlgetbetaupdatebuf=0:{
				dialog langstr(57511),3,langstr(3005)
				if stat=6:{
					saveset "getbetaupdate",settingdata,"1"
				}else{
					gsel 2,0
					objprm controlgetbetaupdateadr,0
					gsel 0,0
				}
			}else{
				saveset "getbetaupdate",settingdata,"0"
			}
			controlgetbetaupdatebuf=controlgetbetaupdate
		}
	}

	return

*controlui
	gsel 0000
	clientwindowx=ginfo(12)
	clientwindowy=ginfo(13)
	gsel 0002
	redraw 0

	if mousewheelbuttonbuf=1:{
		groll xsiz(0),ginfo(9)-(ginfo(13)/15)
		ScrollBar_SetPos scrollbar2adr,ginfo(9)
	}else:if mousewheelbuttonbuf=2:{
		groll xsiz(0),ginfo(9)+(ginfo(13)/15)
		ScrollBar_SetPos scrollbar2adr,ginfo(9)
	}else:if mousewheelbuttonbuf=3:{
		groll xsiz(0),ScrollBar_GetPos(scrollbar2adr)
	}

	width clientwindowx-xsiz(180),clientwindowy-ysiz(30),xsiz(180),ysiz(30)

	color 0,0,0
	boxf

	if loadset("backgroundmode",settingdata)="COLOR":{
		backgroundcolorrgbdata=loadset("backgroundcolor",settingdata)
		split backgroundcolorrgbdata,",",backgroundcolorrdata,backgroundcolorgdata,backgroundcolorbdata
		color int(backgroundcolorrdata),int(backgroundcolorgdata),int(backgroundcolorbdata)
		boxf xsiz(0),ysiz(0),ginfo(12),ginfo(13)
	}else:if loadset("backgroundmode",settingdata)="IMAGE":{
		gsel 1007,0
		backpicx=ginfo(12)
		backpicy=ginfo(13)
		gsel 0002,0
		if ((backpicy*ginfo(12))/backpicx)<=ginfo(13):{
			posbuf3=(backpicy*ginfo(12))/backpicx
			posbuf4=(ginfo(13)-posbuf3)/2
			pos xsiz(0),ysiz(0)+posbuf4
			gzoom ginfo(12),posbuf3,1007,0,0,backpicx,backpicy,1
		}else{
			posbuf3=(backpicx*ginfo(13))/backpicy
			posbuf4=(ginfo(12)-posbuf3)/2
			pos xsiz(0)+posbuf4,ysiz(0)
			gzoom posbuf3,ginfo(13),1007,0,0,backpicx,backpicy,1
		}
	}else:if loadset("backgroundmode",settingdata)="SLIDESHOW":{
		gsel 1007,0
		backpicx=ginfo(12)
		backpicy=ginfo(13)
		gsel 0002,0
		if ((backpicy*ginfo(12))/backpicx)<=ginfo(13):{
			posbuf3=(backpicy*ginfo(12))/backpicx
			posbuf4=(ginfo(13)-posbuf3)/2

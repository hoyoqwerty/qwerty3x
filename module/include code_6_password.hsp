*passwordinput
	if loadset("fontname",settingdata)="AUTO":{
		fontstr=fontautoname
	}else{
		fontstr=loadset("fontname",settingdata)
	}

	gosub *bufferallupdate

	gsel 0000,int(loadset("alwaysfront",settingdata))+1
	enablewindow hclient,0
	clrobj
	color 0,0,0
	boxf
	
	redraw 1

	font fontstr,fontsize,0
	objmode 2,1

	pos xsiz(0),ysiz(0)
	boxfofmes int(loadset("DISPCOLORMODE",settingdata)),xsiz(0),ysiz(0),ginfo(12),ysiz(30)
	line ginfo(12),ysiz(30),xsiz(0),ysiz(30)
	if windowsname="Windows 11":{
		if loadset("DISPCOLORMODE",settingdata)=0:{;ダークモード
			opt=rgb(32,32,32)
			dwmsetwindowattribute hwnd,DWMWA_CAPTION_COLOR,varptr(opt),4
			dwmsetwindowattribute hwnd,DWMWA_BORDER_COLOR,varptr(opt),4
			opt=rgb(255,255,255)
			dwmsetwindowattribute hwnd,DWMWA_TEXT_COLOR,varptr(opt),4
		}else:if loadset("DISPCOLORMODE",settingdata)=1:{;ライトモード
			opt=rgb(255,255,255)
			dwmsetwindowattribute hwnd,DWMWA_CAPTION_COLOR,varptr(opt),4
			dwmsetwindowattribute hwnd,DWMWA_BORDER_COLOR,varptr(opt),4
			opt=rgb(0,0,0)
			dwmsetwindowattribute hwnd,DWMWA_TEXT_COLOR,varptr(opt),4
		}
	}

	pos ginfo(12)-xsiz(30),ysiz(0)
	objsize xsiz(30),ysiz(30)
	objimage 1008,xsiz(90),ysiz(59),xsiz(90),ysiz(59),xsiz(90),ysiz(60)
	button "",*systemshutdown
	endadr=stat
	pos ginfo(12)-xsiz(60),ysiz(0)
	if iszoom=0:{
		objimage 1008,xsiz(30),ysiz(59),xsiz(30),ysiz(59),xsiz(30),ysiz(60)
	}else{
		objimage 1008,xsiz(60),ysiz(59),xsiz(60),ysiz(59),xsiz(60),ysiz(60)
	}
	button gosub "",*windowmenualsizechange
	maxadr=stat
	pos ginfo(12)-xsiz(90),ysiz(0)
	objimage 1008,xsiz(0),ysiz(59),xsiz(0),ysiz(59),xsiz(0),ysiz(60)
	button gosub "",*windowmenualsizechange
	minadr=stat
	objimage -1

	pmaxsize=ginfo(13)-ysiz(30)
	pypos=(pmaxsize-ysiz(95))/2

	pos xsiz(20),pypos
	boxfofmes onezero(loadset("dispcolormode",settingdata)),xsiz(20),pypos,ginfo(12)-xsiz(20),pypos+fontysizedata.3
	pos ((ginfo(12)-fontxsizedata.4)/2),pypos
	mes ""+langstr(1011)

	pos xsiz(20),pypos+ysiz(25)
	objsize ginfo(12)-xsiz(140),ysiz(30)
	passwordstr=""
	input passwordstr,ginfo(12)-xsiz(140),ysiz(30),0
	passwordstradr=stat
	sendmsg objinfo(passwordstradr,2),$CC,'*'
	pos ginfo(12)-xsiz(120),pypos+ysiz(25)
	objsize xsiz(100),ysiz(30)
	button gosub langstr(55035),*passwordstrenable
	passwordstrenableadr=stat
	passwordstrenablebuf=0

	pos xsiz(20),pypos+ysiz(65)
	objsize ginfo(12)-xsiz(40),ysiz(30)
	button goto langstr(1012),*passwordlogin
	passwordloginadr=stat

	enablewindow hclient,1

	gsel 0000,int(loadset("alwaysfront",settingdata))+1
	objsel passwordstradr

	goto *passwordrepeat


*passwordlogin
	if passwordstr!loadset("passwordstring",settingdata):{
		dialog ""+langstr(55013),1,""+langstr(1011)
		goto *passwordrepeat
	}

	gsel 0000,int(loadset("alwaysfront",settingdata))+1
	clrobj
	color 0,0,0
	boxf
	redraw 1

	wait 5

	gosub *makescreen

	goto *systemrepeat

*passwordstrenable
	if passwordstrenablebuf=0:{;非表示時
		sendmsg objinfo(passwordstradr,2),$CC
		objprm passwordstrenableadr,langstr(55036)
		passwordstrenablebuf=1
	}else{
		sendmsg objinfo(passwordstradr,2),$CC,'*'
		objprm passwordstrenableadr,langstr(55035)
		passwordstrenablebuf=0
	}

	objprm passwordstradr,passwordstr

	return

*psizechange;ウィンドウのサイズが変わったとき
	onerrortype="sizechange"
	redraw 0
	color 0,0,0
	boxf
	pos xsiz(0),ysiz(0)
	boxfofmes int(loadset("DISPCOLORMODE",settingdata)),xsiz(0),ysiz(0),ginfo(12),ysiz(30)
	line ginfo(12),ysiz(30),xsiz(0),ysiz(30)
			
	size=0,0,(ginfo(12)-xsiz(30)),0
	resizeobj endadr,size,2
	size=0,0,(ginfo(12)-xsiz(60)),0
	resizeobj maxadr,size,2
	size=0,0,(ginfo(12)-xsiz(90)),0
	resizeobj minadr,size,2
	
	systemsizechange=1
	gosub *passwordui
	systemsizechange=0
	redraw 1

	return

*pmovechange;ウィンドウの位置が変わったとき
	onerrortype="movechange"
	redraw 0
	IsZoomed hwnd
	if iszoom!stat:{
		iszoom=stat
		clrobj maxadr,maxadr
		pos ginfo(12)-xsiz(60),ysiz(0)
		objsize xsiz(30),ysiz(30)
		if iszoom=0:{
			objimage 1008,xsiz(30),ysiz(59),xsiz(30),ysiz(59),xsiz(30),ysiz(60)
		}else{
			objimage 1008,xsiz(60),ysiz(59),xsiz(60),ysiz(59),xsiz(60),ysiz(60)
		}
		button gosub "",*windowmenualsizechange
		maxadr=stat
	}else{
		iszoom=stat
	}

	saveset "ISZOOMED",settingdata,str(iszoom)
	if iszoom!1:{
		saveset "WINDOW_POSX",settingdata,str(ginfo(4))
		saveset "WINDOW_POSY",settingdata,str(ginfo(5))
		saveset "WINDOW_SIZX",settingdata,str(ginfo(12))
		saveset "WINDOW_SIZY",settingdata,str(ginfo(13))
	}

	if loadset("window_sizx",settingdata)!str(ginfo(12))|loadset("window_sizy",settingdata)!str(ginfo(13)):{
		gosub *psizechange
	}
	redraw 1

	onerrortype=""

	return

*ponclickjump;ウィンドウがクリックされたとき(onclick)
	if wparam=1:{
		sendmsg hwnd,$A1,2
	}

	return

*ponkeyjump
	if wparam=13:{
		objsel -1
		if stat=passwordstradr:{
			goto *passwordlogin
		}
	}

	goto *passwordrepeat

*pOnNCHITTEST;タイトルバーの色を変更
	dim area
	mposx = ginfo_mx - ginfo_wx1
	mposy = ginfo_my - ginfo_wy1
	if (mposx <= BORDERWIDTH)             : area |= LEFT
	if (mposx >= ginfo_winx - BORDERWIDTH): area |= RIGHT
	if (mposy <= BORDERWIDTH)             : area |= TOP
	if (mposy >= ginfo_winy - BORDERWIDTH): area |= BOTTOM
	if (area & LEFT) {
		if (area & TOP)    : return HTTOPLEFT
		if (area & BOTTOM) : return HTBOTTOMLEFT
		return HTLEFT
	}
	if (area & RIGHT) {
		if (area & TOP)    : return HTTOPRIGHT
		if (area & BOTTOM) : return HTBOTTOMRIGHT
		return HTRIGHT
	}
	if (area & TOP)    : return HTTOP
	if (area & BOTTOM) : return HTBOTTOM
	if (mposy <= CAPTIONHEIGHT) : return HTCAPTION
	
	return HTCLIENT

*ponminmax;ウィンドウの最小サイズの指定
	dupptr minmaxinfo,lparam,40,4
	minmaxinfo(6)=xsiz(640)
	minmaxinfo(7)=ysiz(450)

	return 0

*passwordrepeat
	gsel 0
	redraw 0
	IsZoomed hwnd
	if iszoom!stat:{
		iszoom=stat
		clrobj maxadr,maxadr
		pos ginfo(12)-xsiz(60),ysiz(0)
		objsize xsiz(30),ysiz(30)
		if iszoom=0:{
			objimage 1008,xsiz(30),ysiz(59),xsiz(30),ysiz(59),xsiz(30),ysiz(60)
		}else{
			objimage 1008,xsiz(60),ysiz(59),xsiz(60),ysiz(59),xsiz(60),ysiz(60)
		}
		button gosub "",*windowmenualsizechange
		maxadr=stat
	}else{
		iszoom=stat
	}
	IsIconic hwnd
	isicon=stat

	year=strf("%04d",gettime(0));年=year
	month=strf("%02d",gettime(1));月=month
	week=gettime(2)
	if week=0:{
		weekstr=langstr(4001);日
	}else:if week=1:{
		weekstr=langstr(4002);月
	}else:if week=2:{
		weekstr=langstr(4003);火
	}else:if week=3:{
		weekstr=langstr(4004);水
	}else:if week=4:{
		weekstr=langstr(4005);木
	}else:if week=5:{
		weekstr=langstr(4006);金
	}else:if week=6:{
		weekstr=langstr(4007);土
	};曜日番号=week 曜日=weekstr
	day=strf("%02d",gettime(3));日=day
	hour=gettime(4)
	if useampm=0:{
		hour=strf("%02d",hour)
	}else:if useampm=1:{
		if gettime(4)<12:{
			hour=strf("%02d",hour)
			hour="am"+hour
		}else:if gettime(4)>12&gettime(4)<=23:{
			hour=hour-12
			hour=strf("%02d",hour)
			hour="pm"+hour
		}
	}
	minute=strf("%02d",gettime(5))
	second=strf("%02d",gettime(6))
	
	onexit *shutdownwindowssystem
	onclick gosub *ponclickjump
	onkey goto *ponkeyjump

	onerror *systemerrordialog

	oncmd gosub *psizechange,$005;WM_SIZE
	oncmd gosub *pOnNCHITTEST, $084;WM_NCHITTEST
	oncmd gosub *pmovechange,$003;WM_MOVE
	oncmd gosub *ponminmax,$024;WM_GETMINMAXINFO

	gosub *langstrrepupdate

	title ""+langstr(1012)+" | qwerty3x ver."+qwertyver

	redraw 0
	pos xsiz(0),ysiz(0)
	boxfofmes int(loadset("DISPCOLORMODE",settingdata)),xsiz(0),ysiz(0),ginfo(12),ysiz(30)
	line ginfo(12),ysiz(30),xsiz(0),ysiz(30)

	pos xsiz(2),ysiz(2)
	mes ""+year+"/"+month+"/"+day+"("+weekstr+") "+hour+":"+minute+":"+second

	pmaxsize=ginfo(13)-ysiz(30)
	pypos=(pmaxsize-ysiz(95))/2

	pos xsiz(20),pypos
	boxfofmes onezero(loadset("dispcolormode",settingdata)),xsiz(20),pypos,ginfo(12)-xsiz(20),pypos+fontysizedata.3
	pos ((ginfo(12)-fontxsizedata.4)/2),pypos
	mes ""+langstr(1011)

	redraw 1

	timeGetTime
	if fpsbuf!(stat/1000):{
		fpsbuf=(stat/1000)
		fpsbufmes=fpsbufcnt
		fpsbufcnt=0
	}else{
		fpsbufcnt+=1
	}
	
	if isicon=1:{
		await 1000;1fps
	}else{
		settingfps=45;45fps
		if fpsbufmes>settingfps:{
			await (1000/(settingfps-1))
		}else:if fpsbufmes=settingfps:{
			await (1000/(settingfps))
		}else:if fpsbufmes<settingfps:{
			await (1000/(settingfps+1))
		}
	}
	goto *passwordrepeat

*passwordui
	redraw 0
	color 0,0,0
	boxf

	pos xsiz(0),ysiz(0)
	boxfofmes int(loadset("DISPCOLORMODE",settingdata)),xsiz(0),ysiz(0),ginfo(12),ysiz(30)
	line ginfo(12),ysiz(30),xsiz(0),ysiz(30)

	pos xsiz(2),ysiz(2)
	mes ""+year+"/"+month+"/"+day+"("+weekstr+") "+hour+":"+minute+":"+second
	
	pmaxsize=ginfo(13)-ysiz(30)
	pypos=(pmaxsize-ysiz(95))/2

	pos xsiz(20),pypos
	boxfofmes onezero(loadset("dispcolormode",settingdata)),xsiz(20),pypos,ginfo(12)-xsiz(20),pypos+fontysizedata.3
	pos ((ginfo(12)-fontxsizedata.4)/2),pypos
	mes ""+langstr(1011)

	pos xsiz(20),pypos+ysiz(25)
	size=ginfo(12)-xsiz(140),ysiz(30),xsiz(20),pypos+ysiz(25)
	resizeobj passwordstradr,size
	pos ginfo(12)-xsiz(120),pypos+ysiz(25)
	size=xsiz(100),ysiz(30),ginfo(12)-xsiz(120),pypos+ysiz(25)
	resizeobj passwordstrenableadr,size

	pos xsiz(20),pypos+ysiz(65)
	size=ginfo(12)-xsiz(40),ysiz(30),xsiz(20),pypos+ysiz(65)
	resizeobj passwordloginadr,size

	redraw 1

	return